WECHAT_APPID=wx5d1ccdf824e45e73
WECHAT_APP_SECRET=
SESSION_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_TOKEN=


# 微信支付 API v3（真实收款必填）
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=/absolute/path/to/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payments/wechat/notify
# 可与支付通知地址相同；如分开配置，仍需指向同一个验签和解密处理器。
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/api/payments/wechat/notify
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=/absolute/path/to/wechatpay_public_key.pem
# 证书/公钥轮换期可同时保留上一把验签密钥，平稳过渡后再移除。
WECHAT_PAY_PLATFORM_SERIAL_PREVIOUS=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH_PREVIOUS=
# API 请求超时（1000-60000ms）及主备域名，逗号分隔。
WECHAT_PAY_TIMEOUT_MS=8000
WECHAT_PAY_API_HOSTS=https://api.mch.weixin.qq.com,https://api2.mch.weixin.qq.com

# 商家转账（提现打款到微信零钱，用户确认收款模式）
# 先在商户平台「产品中心 → 运营工具 → 商家转账」开通并配置转账场景与接口安全 IP。
WECHAT_TRANSFER_ENABLED=false
# 转账场景 ID：1005 佣金报酬（本项目默认），其他场景需同时配置报备信息。
WECHAT_TRANSFER_SCENE_ID=1005
# 场景报备信息（JSON 数组），不填则使用 1005/1000 的默认值：
# [{"info_type":"岗位类型","info_content":"主理人"},{"info_type":"报酬说明","info_content":"推广佣金"}]
WECHAT_TRANSFER_SCENE_REPORT_INFOS=
# 用户收款感知（佣金报酬可选：劳务报酬/报销款/企业补贴/开工利是）
WECHAT_TRANSFER_PERCEPTION=劳务报酬
WECHAT_TRANSFER_REMARK=岁悦里推广佣金
# 不填时自动由 WECHAT_PAY_NOTIFY_URL 推导为 /api/transfers/wechat/notify
WECHAT_TRANSFER_NOTIFY_URL=

# 快递鸟（实时物流轨迹）
KDNIAO_EBUSINESS_ID=
KDNIAO_API_KEY=
KDNIAO_SUBSCRIBE_URL=https://api.kdniao.com/api/dist
KDNIAO_QUERY_URL=https://api.kdniao.com/Ebusiness/EbusinessOrderHandle.aspx
# 定时补偿查询周期，默认 6 小时，最低 30 分钟
LOGISTICS_REFRESH_INTERVAL_MS=21600000
# 在快递鸟后台配置的轨迹推送地址：
# https://api.example.com/api/logistics/kdniao/callback
