.contact-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 1000; display: flex; align-items: flex-end; background: rgba(20,25,24,.48); }
.contact-sheet { width: 100%; padding: 18rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #fff; box-sizing: border-box; }
.contact-handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 999rpx; background: #d9ddda; }
.contact-title { color: #29312f; font-size: 38rpx; font-weight: 700; text-align: center; }
.contact-sub { margin: 10rpx 0 26rpx; color: #7f8784; font-size: 25rpx; line-height: 1.55; text-align: center; }
.contact-row { display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; margin-top: 16rpx; padding: 0 22rpx; border: 1rpx solid #e8e5de; border-radius: 22rpx; background: #faf9f6; box-sizing: border-box; }
.contact-copy { min-width: 0; display: flex; flex-direction: column; }
.contact-label { color: #909693; font-size: 22rpx; }
.contact-value { margin-top: 7rpx; color: #303735; font-size: 31rpx; font-weight: 700; word-break: break-all; }
.contact-copy-btn { flex: none; margin-left: 22rpx; padding: 12rpx 22rpx; border-radius: 999rpx; background: #edf3ef; color: #4d6b62; font-size: 24rpx; font-weight: 700; }
.contact-close { width: 100%; margin: 28rpx 0 0; padding: 19rpx 0; border: 0; border-radius: 999rpx; background: #344944; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 1.5; }
.contact-close::after { border: 0; }
