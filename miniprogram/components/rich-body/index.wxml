<view class="article-body">
    <block wx:for="{{blocks}}" wx:key="_key" wx:for-item="block">
      <view wx:if="{{block.type === 'text' && block.html}}" class="formatted-article">
        <rich-text nodes="{{block.html}}" space="nbsp" user-select></rich-text>
        <view wx:for="{{block.links}}" wx:for-item="link" wx:key="url" class="article-link" data-url="{{link.url}}" bindtap="openContentLink"><text>{{link.title}}</text><text>›</text></view>
      </view>
      <text wx:elif="{{block.type === 'text'}}" class="content-body" user-select>{{block.text}}</text>
      <view wx:elif="{{block.type === 'image'}}" class="article-media-block">
        <image webp="{{true}}" wx:if="{{block.src || fallbackImage}}" class="article-image" style="width:{{block.width || 100}}%;margin-left:{{block.align === 'left' ? '0' : 'auto'}};margin-right:{{block.align === 'right' ? '0' : 'auto'}}" src="{{block.src || fallbackImage}}" mode="widthFix" show-menu-by-longpress />
        <view wx:if="{{block.caption}}" class="article-caption" style="text-align:{{block.align || 'center'}}">{{block.caption}}</view>
      </view>
      <view wx:elif="{{block.type === 'video'}}" class="article-media-block">
        <video wx:if="{{block.url}}" class="article-video" src="{{block.url}}" controls enable-play-gesture show-center-play-btn></video>
        <view wx:if="{{block.caption}}" class="article-caption">{{block.caption}}</view>
      </view>
      <view wx:elif="{{block.type === 'link'}}" class="article-link" data-url="{{block.url}}" bindtap="openContentLink">
        <view class="article-link-copy"><view class="article-link-title">{{block.title}}</view><view wx:if="{{block.description}}" class="article-link-description">{{block.description}}</view></view>
        <text class="article-link-arrow">›</text>
      </view>
    </block>
  </view>
