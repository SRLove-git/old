/* 岁悦里 · Arco Design 设计令牌
 * 主色统一为暖陶土棕（与运营后台一致），语义色沿用 Arco 默认绿/橙/红。
 */
page {
  /* 品牌主色 */
  --color-primary: #c25e3d;
  --color-primary-hover: #d07052;
  --color-primary-active: #a64c2f;
  --color-primary-light: #fde9df;
  --color-primary-light-border: #f0bba6;
  --color-primary-text: #9e4f2f;

  /* 语义色 */
  --color-success: #00b42a;
  --color-success-light: #e8ffea;
  --color-warning: #ff7d00;
  --color-warning-light: #fff3e8;
  --color-danger: #f53f3f;
  --color-danger-light: #ffece8;
  --color-info: #3b6fa0;
  --color-info-light: #e8f1fa;

  /* 中性色 */
  --color-text-1: #24272b;
  --color-text-2: #4e5969;
  --color-text-3: #6f747b;
  --color-text-4: #c9cdd4;
  --color-bg: #f5f6f8;
  --color-fill: #f1f2f4;
  --color-border: #e7e9ec;

  background: var(--color-bg);
  color: var(--color-text-1);
  font-size: 32rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  line-height: inherit;
  font-size: inherit;
}

button::after {
  border: 0;
}

input,
textarea {
  font-size: 32rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.large-mode {
  font-size: 36rpx;
}

.large-mode .btn {
  min-height: 108rpx;
  font-size: 36rpx;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(29, 33, 41, 0.06);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  border-radius: 24rpx;
  padding: 22rpx 34rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(194, 94, 61, 0.22);
}

.btn-primary:active {
  background: var(--color-primary-active);
}

.btn-secondary {
  background: #ffffff;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-ghost {
  background: var(--color-primary-light);
  color: var(--color-primary-text);
}

.btn-danger {
  background: var(--color-danger);
  color: #ffffff;
}

.btn-wechat {
  background: #09bb07;
  color: #ffffff;
}

.btn-block {
  width: 100%;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-text-1);
}

.sub {
  color: var(--color-text-3);
  font-size: 28rpx;
}

.price {
  color: var(--color-primary);
  font-weight: 700;
}

.tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.tag-green {
  background: var(--color-success-light);
  color: var(--color-success);
}

.tag-orange {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.tag-gray {
  background: var(--color-fill);
  color: var(--color-text-3);
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  min-height: 96rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  background: #ffffff;
}

.field-error {
  display: block;
  color: var(--color-danger);
  font-size: 26rpx;
  margin-top: 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  margin: 28rpx 0 18rpx;
}

.safe-bottom {
  padding-bottom: 20rpx;
}

.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid var(--color-border);
  padding: 18rpx 24rpx;
  z-index: 50;
}
