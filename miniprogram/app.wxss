/* 岁悦里 · 温暖、克制、适合银龄用户的视觉令牌 */
page {
  /* 品牌主色 */
  --color-primary: #b98555;
  --color-primary-hover: #c99867;
  --color-primary-active: #94683f;
  --color-primary-light: #f8efe5;
  --color-primary-light-border: #ead4bd;
  --color-primary-text: #79502f;
  --color-coral: #e87863;
  --color-sage: #7f9a83;
  --color-ink: #26312f;

  /* 语义色 */
  --color-success: #00b42a;
  --color-success-light: #e8ffea;
  --color-warning: #ff7d00;
  --color-warning-light: #fff3e8;
  --color-danger: #f53f3f;
  --color-danger-light: #ffece8;
  --color-info: #3b6fa0;
  --color-info-light: #e8f1fa;

  /* 中性色 */
  --color-text-1: #26312f;
  --color-text-2: #505b58;
  --color-text-3: #7a817f;
  --color-text-4: #c9cdd4;
  --color-bg: #faf9f6;
  --color-fill: #f3f1ec;
  --color-border: #e9e5de;

  background: var(--color-bg);
  color: var(--color-text-1);
  font-size: 32rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  line-height: inherit;
  font-size: inherit;
}

button::after {
  border: 0;
}

input,
textarea {
  font-size: 32rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(55, 44, 31, 0.06);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  border-radius: 24rpx;
  padding: 22rpx 34rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(194, 94, 61, 0.22);
}

.btn-primary:active {
  background: var(--color-primary-active);
}

.btn-secondary {
  background: #ffffff;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-ghost {
  background: var(--color-primary-light);
  color: var(--color-primary-text);
}

.btn-danger {
  background: var(--color-danger);
  color: #ffffff;
}

.btn-wechat {
  background: #09bb07;
  color: #ffffff;
}

.btn-block {
  width: 100%;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-text-1);
}

.sub {
  color: var(--color-text-3);
  font-size: 28rpx;
}

.price {
  color: var(--color-primary);
  font-weight: 700;
}

.tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.tag-green {
  background: var(--color-success-light);
  color: var(--color-success);
}

.tag-primary {
  background: var(--color-primary-light);
  color: var(--color-primary-text);
}

.tag-orange {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.tag-gray {
  background: var(--color-fill);
  color: var(--color-text-3);
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  min-height: 96rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  background: #ffffff;
}

.field-error {
  display: block;
  color: var(--color-danger);
  font-size: 26rpx;
  margin-top: 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  margin: 28rpx 0 18rpx;
}

.safe-bottom {
  padding-bottom: 20rpx;
}

.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid var(--color-border);
  padding: 18rpx 24rpx;
  z-index: 50;
}

/* —— 首页风格全局件 —— */

.btn-ink {
  background: var(--color-ink);
  color: #ffffff;
}

.btn-ink:active {
  opacity: 0.88;
}

.btn-pill {
  border-radius: 999rpx;
  min-height: 88rpx;
  padding: 18rpx 36rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.heading-cn {
  position: relative;
  padding-left: 22rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 1rpx;
}

.heading-cn::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 7rpx;
  height: 38rpx;
  border-radius: 6rpx;
  background: var(--color-sage);
}

.heading-en {
  padding-left: 22rpx;
  margin-top: 5rpx;
  color: #9aa09e;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.heading-more {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f0e9;
  color: #897560;
  font-size: 23rpx;
}

.tag-sage {
  background: #edf4ef;
  color: #66806c;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 25, 24, 0.45);
}

.sheet {
  width: 100%;
  max-height: 80vh;
  padding: 30rpx 30rpx 50rpx;
  /* 有底部安全区的机型（刘海屏/全面屏）避免按钮被系统横条压住 */
  padding-bottom: calc(50rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(50rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  overflow-y: auto;
}

.sheet-title {
  margin-bottom: 24rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
}
