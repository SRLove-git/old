page {
  background: #f5f6f8;
  color: #24272b;
  font-size: 32rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  line-height: inherit;
  font-size: inherit;
}

button::after {
  border: 0;
}

input,
textarea {
  font-size: 32rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.large-mode {
  font-size: 36rpx;
}

.large-mode .btn {
  min-height: 108rpx;
  font-size: 36rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(26, 34, 45, 0.07);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  border-radius: 24rpx;
  padding: 22rpx 34rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.btn-primary {
  background: #c25e3d;
  color: #ffffff;
}

.btn-secondary {
  background: #ffffff;
  color: #c25e3d;
  border: 2rpx solid #c25e3d;
}

.btn-ghost {
  background: #fdeee9;
  color: #9e4428;
}

.btn-danger {
  background: #d74a4a;
  color: #ffffff;
}

.btn-wechat {
  background: #09bb07;
  color: #ffffff;
}

.btn-block {
  width: 100%;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #24272b;
}

.sub {
  color: #6f747b;
  font-size: 28rpx;
}

.price {
  color: #c25e3d;
  font-weight: 700;
}

.tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.tag-green {
  background: #e7f3ee;
  color: #2f7d5c;
}

.tag-orange {
  background: #fdeee9;
  color: #9e4428;
}

.tag-gray {
  background: #f1f2f4;
  color: #6f747b;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  min-height: 96rpx;
  border: 2rpx solid #e7e9ec;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  background: #ffffff;
}

.field-error {
  display: block;
  color: #d74a4a;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  margin: 28rpx 0 18rpx;
}

.safe-bottom {
  padding-bottom: 20rpx;
}

.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid #e7e9ec;
  padding: 18rpx 24rpx;
  z-index: 50;
}
