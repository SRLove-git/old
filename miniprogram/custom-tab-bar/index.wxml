<view wx:if="{{!hidden}}" class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    hover-class="tab-item-pressed"
    hover-stay-time="90"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-active-mark"></view>
    <view class="tab-icon-wrap"><view class="tab-icon tab-icon-{{item.icon}}"></view></view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
