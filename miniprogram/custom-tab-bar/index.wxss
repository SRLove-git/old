/* Quiet, generous bottom navigation that matches the profile icon system. */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 116rpx;
  padding: 8rpx 18rpx env(safe-area-inset-bottom);
  box-sizing: content-box;
  border-top: 1rpx solid rgba(82, 75, 66, 0.08);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -10rpx 30rpx rgba(55, 49, 41, 0.065);
  display: flex;
  z-index: 100;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #858b88;
  font-size: 22rpx;
  font-weight: 500;
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.tab-item.active {
  color: #a97547;
}

.tab-item-pressed {
  opacity: 0.72;
  transform: scale(0.97);
}

.tab-active-mark {
  position: absolute;
  top: 1rpx;
  left: 50%;
  width: 34rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: transparent;
  transform: translateX(-50%);
}

.tab-item.active .tab-active-mark {
  background: #bd8753;
  box-shadow: 0 3rpx 8rpx rgba(174, 116, 62, 0.18);
}

.tab-icon-wrap {
  width: 72rpx;
  height: 54rpx;
  margin-bottom: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  transform-origin: center;
  transition: transform 0.18s ease;
}

.tab-item.active .tab-icon {
  transform: translateY(-1rpx) scale(1.09);
}

.tab-icon-home { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon-home { background-image: url("data:image/svg+xml;base64,"); }

.tab-icon-activities { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon-activities { background-image: url("data:image/svg+xml;base64,"); }

.tab-icon-academy { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon-academy { background-image: url("data:image/svg+xml;base64,"); }

.tab-icon-user { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon-user { background-image: url("data:image/svg+xml;base64,"); }

.tab-item.active .tab-text {
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}
