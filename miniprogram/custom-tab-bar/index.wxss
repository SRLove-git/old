/* Tab bar redesign: unified 24px-grid SVG line icons (2px round-cap stroke).
   Selected state: brand-brown icon on a soft primary-light pill. */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 132rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -8rpx 26rpx rgba(45, 40, 34, 0.045);
  display: flex;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7a817f;
  font-size: 23rpx;
  font-weight: 500;
}

.tab-item.active {
  color: #b98555;
}

/* Pill highlight behind the selected icon: larger visual target,
   easier for elderly users to spot the current page. */
.tab-icon-wrap {
  width: 96rpx;
  height: 58rpx;
  margin-bottom: 5rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease;
}

.tab-item.active .tab-icon-wrap {
  background: #f8efe5;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
}

.tab-icon-home { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon-home { background-image: url("data:image/svg+xml;base64,"); }

.tab-icon-activities { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon-activities { background-image: url("data:image/svg+xml;base64,"); }

.tab-icon-academy { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon-academy { background-image: url("data:image/svg+xml;base64,"); }

.tab-icon-user { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-icon-user { background-image: url("data:image/svg+xml;base64,"); }

.tab-item.active .tab-text {
  font-size: 24rpx;
  font-weight: 700;
}