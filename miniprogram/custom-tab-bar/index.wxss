.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 126rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e9e5de;
  display: flex;
  padding-bottom: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7a817f;
  font-size: 23rpx;
  font-weight: 500;
}

.tab-item.active {
  color: #b98555;
}

.tab-emoji {
  height: 52rpx;
  font-size: 47rpx;
  line-height: 48rpx;
  font-weight: 400;
}

.tab-item.active .tab-emoji {
  transform: translateY(-2rpx);
}

.tab-item.active .tab-text {
  font-size: 24rpx;
  font-weight: 700;
}
