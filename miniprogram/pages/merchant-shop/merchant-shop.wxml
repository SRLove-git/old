<view class="shop-page" wx:if="{{manager}}">
  <view class="shop-hero">
    <view class="shop-head"><view class="shop-logo">{{manager.initial}}</view><view class="shop-info"><view class="shop-name">{{manager.shopName}}</view><view class="shop-owner">店主 {{manager.name}} · 平台认证服务商</view></view><button class="contact" bindtap="callMerchant">联系商家</button></view>
    <view class="shop-intro">{{manager.shopIntro}}</view>
    <view class="shop-stats"><view><text>{{stats.count}}</text><text>产品与服务</text></view><view><text>{{stats.sales}}</text><text>累计购买</text></view><view><text>{{stats.rating}}</text><text>店铺评分</text></view></view>
    <view class="hero-ring ring-one"></view><view class="hero-ring ring-two"></view>
  </view>

  <view class="shop-notice"><text class="notice-icon">保</text><text>平台认证 · 价格透明 · 售后有保障</text></view>

  <view class="shop-tabs">
    <view class="shop-tab {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="setFilter">全部</view>
    <view class="shop-tab {{filter === 'service' ? 'active' : ''}}" data-filter="service" bindtap="setFilter">服务活动</view>
    <view class="shop-tab {{filter === 'product' ? 'active' : ''}}" data-filter="product" bindtap="setFilter">精选商品</view>
  </view>

  <view wx:if="{{list.length}}" class="offering-grid">
    <view wx:for="{{list}}" wx:key="id" class="offering-card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="offering-cover"><image src="{{item.art}}" mode="aspectFill" /><text>{{item.typeLabel}}</text></view>
      <view class="offering-body"><view class="offering-title">{{item.title}}</view><view class="offering-desc">{{item.highlight || item.detail}}</view><view class="offering-foot"><view><text class="price-symbol">¥</text><text class="price">{{item.memberPrice}}</text></view><button data-id="{{item.id}}" catchtap="addCart">＋</button></view></view>
    </view>
  </view>
  <view wx:else class="empty">该分类暂时没有内容</view>

  <button class="cart-fab" bindtap="goCart">购物车</button>
</view>
