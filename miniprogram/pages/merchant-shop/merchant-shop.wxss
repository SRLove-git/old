.shop-page { min-height: 100vh; padding: 20rpx 22rpx 120rpx; background: #f7f6f3; }
.shop-hero { position: relative; overflow: hidden; padding: 32rpx; border-radius: 30rpx; background: linear-gradient(135deg,#293633,#557169); color: #fff; }
.shop-head { position: relative; z-index: 2; display: flex; align-items: center; }
.shop-logo { flex-shrink: 0; width: 92rpx; height: 92rpx; border: 4rpx solid rgba(255,255,255,.25); border-radius: 24rpx; background: #e9c694; color: #5d4429; text-align: center; line-height: 92rpx; font-size: 42rpx; font-weight: 700; }
.shop-info { flex: 1; min-width: 0; margin-left: 18rpx; }
.shop-name { font-size: 34rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.shop-owner { margin-top: 6rpx; color: rgba(255,255,255,.7); font-size: 20rpx; }
.contact { flex-shrink: 0; padding: 11rpx 17rpx; border: 1rpx solid rgba(255,255,255,.5); border-radius: 999rpx; color: #fff; font-size: 21rpx; }
.shop-intro { position: relative; z-index: 2; margin-top: 24rpx; color: rgba(255,255,255,.78); font-size: 23rpx; line-height: 1.7; }
.shop-stats { position: relative; z-index: 2; display: flex; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.14); }
.shop-stats view { flex: 1; display: flex; flex-direction: column; align-items: center; }
.shop-stats view text:first-child { font-size: 32rpx; font-weight: 700; }
.shop-stats view text:last-child { margin-top: 3rpx; color: rgba(255,255,255,.62); font-size: 19rpx; }
.hero-ring { position: absolute; border: 30rpx solid rgba(255,255,255,.04); border-radius: 50%; }
.ring-one { right: -80rpx; top: -100rpx; width: 250rpx; height: 250rpx; }
.ring-two { left: -100rpx; bottom: -140rpx; width: 220rpx; height: 220rpx; }
.shop-notice { display: flex; align-items: center; margin: 18rpx 0 24rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: #fff; color: #777e7b; font-size: 21rpx; }
.notice-icon { width: 38rpx; height: 38rpx; margin-right: 11rpx; border-radius: 50%; background: #edf4ee; color: #66806c; text-align: center; line-height: 38rpx; font-size: 19rpx; font-weight: 700; }
.shop-tabs { display: flex; gap: 30rpx; border-bottom: 1rpx solid #e2dfd9; }
.shop-tab { position: relative; padding: 14rpx 4rpx 18rpx; color: #858b88; font-size: 27rpx; }
.shop-tab.active { color: #2e3532; font-weight: 700; }
.shop-tab.active::after { content: ''; position: absolute; left: 50%; bottom: -1rpx; width: 38rpx; height: 5rpx; border-radius: 5rpx; background: var(--color-primary); transform: translateX(-50%); }
.offering-grid { display: flex; flex-wrap: wrap; gap: 18rpx; padding-top: 22rpx; }
.offering-card { width: calc(50% - 9rpx); overflow: hidden; border-radius: 22rpx; background: #fff; box-shadow: 0 7rpx 24rpx rgba(49,44,38,.06); }
.offering-cover { position: relative; height: 230rpx; overflow: hidden; background: #ddd; }
.offering-cover image { width: 100%; height: 100%; }
.offering-cover > text { position: absolute; left: 12rpx; top: 12rpx; padding: 5rpx 10rpx; border-radius: 999rpx; background: rgba(37,48,44,.75); color: #fff; font-size: 18rpx; }
.offering-body { padding: 17rpx; }
.offering-title { height: 70rpx; color: #323936; font-size: 26rpx; font-weight: 700; line-height: 1.35; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.offering-desc { margin-top: 6rpx; color: #969b98; font-size: 20rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.offering-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 13rpx; }
.price-symbol { color: var(--color-primary); font-size: 20rpx; }
.price { color: var(--color-primary); font-size: 31rpx; font-weight: 700; }
.offering-foot button { width: 42rpx; height: 42rpx; border-radius: 50%; background: #f2e8dc; color: var(--color-primary); line-height: 42rpx; font-size: 27rpx; }
.empty { padding: 110rpx 20rpx; color: #969b98; text-align: center; font-size: 24rpx; }
.cart-fab { position: fixed; right: 25rpx; bottom: 35rpx; z-index: 50; padding: 18rpx 26rpx; border-radius: 999rpx; background: #293633; color: #fff; box-shadow: 0 9rpx 28rpx rgba(36,47,44,.22); font-size: 23rpx; font-weight: 700; }
