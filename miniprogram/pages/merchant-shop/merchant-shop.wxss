.shop-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 22rpx calc(150rpx + env(safe-area-inset-bottom));
  background: #f7f6f2;
}

.shop-hero {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #263431 0%, #3f5952 62%, #577268 100%);
  color: #fff;
  box-shadow: 0 18rpx 44rpx rgba(35, 52, 47, .16);
}

.shop-kicker, .shop-head, .shop-intro, .shop-stats, .contact { position: relative; z-index: 2; }
.shop-kicker { display: inline-flex; align-items: center; padding: 8rpx 13rpx 8rpx 9rpx; border: 1rpx solid rgba(255,255,255,.18); border-radius: 999rpx; background: rgba(255,255,255,.1); color: rgba(255,255,255,.86); font-size: 20rpx; }
.verify-mark { width: 28rpx; height: 28rpx; margin-right: 8rpx; border-radius: 50%; background: #d7b07c; color: #263431; text-align: center; line-height: 28rpx; font-size: 18rpx; font-weight: 800; }
.shop-head { display: flex; align-items: center; margin-top: 24rpx; }
.shop-logo { flex-shrink: 0; width: 96rpx; height: 96rpx; border: 4rpx solid rgba(255,255,255,.22); border-radius: 28rpx; background: linear-gradient(145deg,#f5ddbd,#d6a971); color: #39463f; text-align: center; line-height: 96rpx; font-size: 42rpx; font-weight: 800; box-shadow: 0 10rpx 24rpx rgba(18,29,25,.18); }
.shop-info { flex: 1; min-width: 0; margin-left: 20rpx; }
.shop-name { overflow: hidden; color: #fff; font-size: 36rpx; font-weight: 750; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.shop-owner { display: flex; align-items: center; margin-top: 8rpx; color: rgba(255,255,255,.68); font-size: 21rpx; }
.owner-dot { width: 5rpx; height: 5rpx; margin: 0 10rpx; border-radius: 50%; background: rgba(255,255,255,.45); }
.shop-intro { margin-top: 24rpx; padding: 18rpx 20rpx; border: 1rpx solid rgba(255,255,255,.09); border-radius: 18rpx; background: rgba(13,25,21,.12); color: rgba(255,255,255,.78); font-size: 23rpx; line-height: 1.65; }
.shop-stats { display: flex; margin-top: 20rpx; padding: 20rpx 6rpx; border: 1rpx solid rgba(255,255,255,.09); border-radius: 20rpx; background: rgba(255,255,255,.07); }
.stat-item { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-item + .stat-item::before { content: ''; position: absolute; left: 0; top: 8rpx; width: 1rpx; height: 52rpx; background: rgba(255,255,255,.12); }
.stat-item text:first-child { font-size: 32rpx; font-weight: 750; }
.stat-item text:last-child { margin-top: 4rpx; color: rgba(255,255,255,.58); font-size: 19rpx; }

.contact { display: flex; align-items: center; width: 100%; margin-top: 18rpx; padding: 17rpx 20rpx; border: 0; border-radius: 18rpx; background: #f4e4ce; color: #31443e; text-align: left; transition: transform 140ms cubic-bezier(.2,.8,.2,1), background-color 140ms cubic-bezier(.2,.8,.2,1); }
.contact::after, .empty button::after, .cart-fab::after { border: 0; }
.contact:active { transform: scale(.985); background: #ecd6b8; }
.contact-copy { flex: 1; display: flex; flex-direction: column; }
.contact-title { font-size: 25rpx; font-weight: 750; line-height: 1.35; }
.contact-subtitle { margin-top: 2rpx; color: #718079; font-size: 19rpx; line-height: 1.35; }
.contact-arrow { margin-left: 16rpx; color: #53655f; font-size: 38rpx; line-height: 1; }
.hero-ring { position: absolute; border: 30rpx solid rgba(255,255,255,.035); border-radius: 50%; }
.ring-one { right: -80rpx; top: -100rpx; width: 250rpx; height: 250rpx; }
.ring-two { left: -100rpx; bottom: -140rpx; width: 220rpx; height: 220rpx; }

.trust-strip { display: flex; margin: 18rpx 0 32rpx; padding: 20rpx 8rpx; border: 1rpx solid rgba(66,75,70,.06); border-radius: 20rpx; background: #fff; }
.trust-item { flex: 1; display: flex; align-items: center; justify-content: center; color: #68716d; font-size: 21rpx; }
.trust-icon { width: 34rpx; height: 34rpx; margin-right: 8rpx; border-radius: 50%; background: #eef3ef; color: #597063; text-align: center; line-height: 34rpx; font-size: 17rpx; font-weight: 800; }

.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 0 4rpx 20rpx; }
.section-title { color: #2f3834; font-size: 34rpx; font-weight: 750; line-height: 1.3; }
.section-subtitle { margin-top: 4rpx; color: #959b98; font-size: 21rpx; }
.section-count { padding-bottom: 2rpx; color: #8d9490; font-size: 21rpx; }
.shop-tabs { display: flex; padding: 6rpx; border-radius: 18rpx; background: #ecebe6; }
.shop-tab { flex: 1; padding: 14rpx 8rpx; border-radius: 14rpx; color: #7f8682; text-align: center; font-size: 23rpx; transition: transform 120ms cubic-bezier(.2,.8,.2,1), background-color 160ms cubic-bezier(.2,.8,.2,1), color 160ms cubic-bezier(.2,.8,.2,1); }
.shop-tab:active { transform: scale(.97); }
.shop-tab.active { background: #fff; color: #34413c; font-weight: 700; box-shadow: 0 3rpx 12rpx rgba(46,54,50,.08); }

.offering-grid { display: flex; flex-wrap: wrap; gap: 18rpx; padding-top: 22rpx; }
.offering-card { width: calc(50% - 9rpx); overflow: hidden; border: 1rpx solid rgba(57,65,61,.07); border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(49,44,38,.055); transition: transform 140ms cubic-bezier(.2,.8,.2,1), box-shadow 140ms cubic-bezier(.2,.8,.2,1); }
.offering-card:active { transform: scale(.985); box-shadow: 0 4rpx 14rpx rgba(49,44,38,.05); }
.offering-cover { position: relative; height: 226rpx; overflow: hidden; background: #e5e3de; }
.offering-cover image { width: 100%; height: 100%; }
.type-badge, .sold-badge { position: absolute; top: 12rpx; padding: 6rpx 11rpx; border-radius: 999rpx; color: #fff; font-size: 18rpx; line-height: 1.2; }
.type-badge { left: 12rpx; background: rgba(37,48,44,.76); }
.sold-badge { right: 12rpx; background: rgba(35,37,36,.5); }
.offering-body { padding: 18rpx; }
.offering-title { height: 70rpx; overflow: hidden; color: #323936; font-size: 26rpx; font-weight: 700; line-height: 1.35; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.offering-desc { height: 56rpx; margin-top: 7rpx; overflow: hidden; color: #919794; font-size: 20rpx; line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.offering-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.price-block { display: flex; flex-direction: column; }
.member-label { margin-bottom: 1rpx; color: #a1825e; font-size: 17rpx; }
.price-symbol { color: var(--color-primary); font-size: 19rpx; }
.price { color: var(--color-primary); font-size: 32rpx; font-weight: 750; }
.add-cart-button { position: relative; flex: 0 0 56rpx; width: 56rpx; min-width: 56rpx; max-width: 56rpx; height: 56rpx; min-height: 56rpx; max-height: 56rpx; margin-left: 12rpx; border-radius: 50%; background: #b98555; box-shadow: 0 7rpx 16rpx rgba(144,91,48,.2); transition: transform 120ms cubic-bezier(.23,1,.32,1), background-color 120ms cubic-bezier(.23,1,.32,1), box-shadow 120ms cubic-bezier(.23,1,.32,1); }
.plus-icon::before, .plus-icon::after { content: ''; position: absolute; left: 50%; top: 50%; border-radius: 999rpx; background: #fff; transform: translate(-50%,-50%); }
.plus-icon::before { width: 22rpx; height: 3rpx; }
.plus-icon::after { width: 3rpx; height: 22rpx; }
.add-cart-button:active, .add-cart-button-pressed { transform: scale(.92); background: #a77448; box-shadow: 0 3rpx 9rpx rgba(144,91,48,.16); }

.empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx 20rpx 80rpx; text-align: center; }
.empty-icon { width: 84rpx; height: 84rpx; border-radius: 50%; background: #ecebe6; color: #a0a6a2; line-height: 84rpx; font-size: 42rpx; }
.empty-title { margin-top: 20rpx; color: #444d49; font-size: 27rpx; font-weight: 700; }
.empty-subtitle { margin-top: 8rpx; color: #989e9b; font-size: 22rpx; }
.empty button { margin-top: 24rpx; padding: 12rpx 26rpx; border: 1rpx solid #d8d7d1; border-radius: 999rpx; background: #fff; color: #4e5b55; font-size: 22rpx; }

.cart-fab { position: fixed; right: 25rpx; bottom: calc(35rpx + env(safe-area-inset-bottom)); z-index: 50; display: flex; align-items: center; padding: 17rpx 24rpx 17rpx 20rpx; border-radius: 999rpx; background: #273631; color: #fff; box-shadow: 0 10rpx 30rpx rgba(36,47,44,.24); font-size: 23rpx; font-weight: 700; transition: transform 140ms cubic-bezier(.2,.8,.2,1), background-color 140ms cubic-bezier(.2,.8,.2,1); }
.cart-fab:active { transform: scale(.96); background: #1f2c28; }
.cart-icon-wrap { position: relative; width: 34rpx; height: 34rpx; margin-right: 12rpx; }
.cart-fab-icon { width: 34rpx; height: 34rpx; filter: brightness(0) invert(1); }
.cart-count { position: absolute; right: -13rpx; top: -15rpx; min-width: 26rpx; height: 26rpx; padding: 0 4rpx; border: 3rpx solid #273631; border-radius: 999rpx; background: #d4975d; color: #fff; text-align: center; line-height: 26rpx; font-size: 15rpx; font-weight: 750; }
