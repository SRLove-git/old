.attendance-page { min-height: 100vh; padding: 30rpx 24rpx 96rpx; background: linear-gradient(180deg, #f5eee5 0, #faf9f6 390rpx, #f6f5f1 100%); }
.page-hero { display: flex; align-items: flex-end; justify-content: space-between; padding: 12rpx 12rpx 34rpx; }
.eyebrow, .section-kicker { color: #b98555; font-size: 18rpx; font-weight: 750; letter-spacing: 3rpx; }
.page-title { margin-top: 7rpx; color: #25312e; font-size: 46rpx; font-weight: 760; line-height: 1.2; }
.page-subtitle { margin-top: 9rpx; color: #7a817f; font-size: 23rpx; }
.hero-clock { flex-shrink: 0; margin-left: 18rpx; text-align: right; }
.hero-time { color: #34423e; font-size: 34rpx; font-weight: 730; letter-spacing: 1rpx; }
.hero-date { margin-top: 2rpx; color: #939997; font-size: 19rpx; }
.card-tabs { width: 100%; margin-bottom: 18rpx; white-space: nowrap; }
.card-tab-row { display: inline-flex; gap: 12rpx; padding: 0 2rpx; }
.card-tab { max-width: 330rpx; overflow: hidden; padding: 13rpx 22rpx; border: 1rpx solid #dfd8cf; border-radius: 999rpx; background: rgba(255,255,255,.82); color: #727a77; font-size: 23rpx; text-overflow: ellipsis; }
.card-tab.active { border-color: #34433e; background: #34433e; color: #fff; }
.course-card { overflow: hidden; padding: 28rpx 30rpx 30rpx; border-radius: 28rpx; background: linear-gradient(135deg, #263532, #526760); color: #fff; box-shadow: 0 18rpx 44rpx rgba(38,53,50,.17); }
.course-badge { display: inline-flex; padding: 6rpx 13rpx; border: 1rpx solid rgba(239,216,184,.28); border-radius: 999rpx; background: rgba(255,255,255,.08); color: #edd8ba; font-size: 18rpx; letter-spacing: 2rpx; }
.course-row { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 19rpx; }
.course-copy { min-width: 0; padding-right: 24rpx; }
.course-title { overflow: hidden; font-size: 33rpx; font-weight: 730; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.course-teacher, .course-valid { margin-top: 7rpx; color: rgba(255,255,255,.62); font-size: 20rpx; }
.remain-box { flex-shrink: 0; min-width: 128rpx; padding-left: 24rpx; border-left: 1rpx solid rgba(255,255,255,.16); text-align: right; }
.remain-number { color: #f0d5ae; font-size: 44rpx; font-weight: 760; line-height: 1; }
.remain-unit { margin-left: 3rpx; color: rgba(255,255,255,.7); font-size: 19rpx; }
.remain-label { margin-top: 7rpx; color: rgba(255,255,255,.52); font-size: 18rpx; }
.steps-card { margin-top: 20rpx; padding: 30rpx; border: 1rpx solid rgba(81,69,54,.07); border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 36rpx rgba(55,44,31,.055); }
.step-heading { display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 24rpx; }
.section-title, .records-title { margin-top: 4rpx; color: #2d3936; font-size: 31rpx; font-weight: 730; }
.step-progress { padding: 7rpx 13rpx; border-radius: 999rpx; background: #f5f1eb; color: #8b7259; font-size: 19rpx; }
.step-block { display: flex; align-items: flex-start; padding: 22rpx 0; }
.step-index { display: flex; flex: 0 0 46rpx; height: 46rpx; align-items: center; justify-content: center; border: 2rpx solid #ded8d0; border-radius: 50%; background: #faf9f6; color: #8d918f; font-size: 22rpx; font-weight: 700; }
.step-index.done { border-color: #6f8b78; background: #6f8b78; color: #fff; }
.step-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.step-title-row { display: flex; align-items: center; justify-content: space-between; }
.step-title { color: #303b38; font-size: 27rpx; font-weight: 700; }
.step-state { padding: 5rpx 11rpx; border-radius: 999rpx; background: #f2f0ec; color: #999b99; font-size: 18rpx; }
.step-state.complete { background: #edf5ef; color: #5f7e69; }
.step-divider { height: 1rpx; margin-left: 66rpx; background: #eeeae4; }
.identity-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 17rpx; }
.identity-item { min-width: 0; padding: 17rpx 18rpx; border: 1rpx solid #ece7e0; border-radius: 16rpx; background: #faf9f7; }
.identity-label { color: #969b98; font-size: 18rpx; }
.identity-value, .identity-input { width: 100%; height: 40rpx; margin-top: 3rpx; color: #323c39; font-size: 25rpx; font-weight: 650; line-height: 40rpx; }
.location-picker { display: flex; min-height: 108rpx; margin-top: 17rpx; padding: 18rpx; align-items: center; border: 2rpx dashed #ddc5ad; border-radius: 18rpx; background: #fdf8f2; }
.location-picker.selected { border-style: solid; border-color: #cad9cf; background: #f4f8f5; }
.location-icon { position: relative; flex: 0 0 42rpx; height: 42rpx; margin-right: 15rpx; border-radius: 50% 50% 50% 5rpx; background: #b98555; transform: rotate(-45deg); }
.location-picker.selected .location-icon { background: #708b79; }
.location-dot { width: 10rpx; height: 10rpx; margin: 12rpx auto; border: 3rpx solid #fff; border-radius: 50%; }
.location-copy { flex: 1; min-width: 0; }
.location-label { color: #3e4946; font-size: 23rpx; font-weight: 680; }
.location-value { display: -webkit-box; margin-top: 4rpx; overflow: hidden; color: #898f8c; font-size: 20rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.location-action { flex-shrink: 0; margin-left: 13rpx; color: #a67345; font-size: 20rpx; }
.location-action text { margin-left: 5rpx; font-size: 27rpx; }
.privacy-note { margin-top: 12rpx; color: #a0a4a2; font-size: 18rpx; }
.shield-icon { display: inline-flex; width: 24rpx; height: 24rpx; align-items: center; justify-content: center; border-radius: 50%; background: #edf5ef; color: #64806b; font-size: 15rpx; }
.action-area { padding-top: 23rpx; }
.checkin-button { display: flex; width: 100%; min-height: 96rpx; align-items: center; justify-content: center; border-radius: 20rpx; background: linear-gradient(135deg, #b98555, #9d6d43); color: #fff; box-shadow: 0 12rpx 28rpx rgba(151,99,56,.22); font-size: 31rpx; font-weight: 730; letter-spacing: 2rpx; }
.checkin-button::after { border: 0; }
.checkin-button:active { transform: scale(.99); }
.checkin-button.disabled { background: #d3d0cb; box-shadow: none; color: rgba(255,255,255,.9); }
.button-hint { display: flex; margin-top: 13rpx; align-items: center; justify-content: center; color: #9a9f9d; font-size: 19rpx; }
.button-hint.ready { color: #64806b; }
.hint-dot { width: 9rpx; height: 9rpx; margin-right: 9rpx; border-radius: 50%; background: currentColor; }
.success-banner { display: flex; margin-top: 20rpx; padding: 18rpx 20rpx; align-items: center; border: 1rpx solid #cfe0d3; border-radius: 17rpx; background: #f0f7f2; }
.success-mark { display: flex; width: 42rpx; height: 42rpx; margin-right: 15rpx; align-items: center; justify-content: center; border-radius: 50%; background: #6f8b78; color: #fff; font-size: 23rpx; }
.success-title { color: #4c6956; font-size: 23rpx; font-weight: 700; }
.success-sub { margin-top: 2rpx; color: #839289; font-size: 18rpx; }
.records-card { margin-top: 20rpx; padding: 28rpx 30rpx 8rpx; border: 1rpx solid rgba(81,69,54,.06); border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(55,44,31,.045); }
.records-head { display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 14rpx; }
.records-count { color: #9a9f9d; font-size: 19rpx; }
.record-item { display: flex; min-height: 116rpx; align-items: flex-start; padding: 20rpx 0; border-top: 1rpx solid #eeeae4; }
.record-date { flex: 0 0 74rpx; padding-top: 5rpx; color: #95704e; font-size: 21rpx; font-weight: 700; }
.record-line { position: relative; align-self: stretch; flex: 0 0 28rpx; }
.record-dot { position: absolute; left: 4rpx; top: 9rpx; z-index: 1; width: 15rpx; height: 15rpx; border: 4rpx solid #fff; border-radius: 50%; background: #a5aaa7; box-shadow: 0 0 0 2rpx #dfe3e0; }
.record-dot.checked { background: #6f8b78; box-shadow: 0 0 0 2rpx #cbd9cf; }
.record-dot.absent { background: #c76555; box-shadow: 0 0 0 2rpx #f0d2cc; }
.record-tail { position: absolute; left: 11rpx; top: 28rpx; bottom: -22rpx; width: 1rpx; background: #e5e3de; }
.record-item:last-child .record-tail { display: none; }
.record-copy { flex: 1; min-width: 0; }
.record-name { overflow: hidden; color: #3e4643; font-size: 24rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.record-meta, .record-location { margin-top: 4rpx; color: #999f9c; font-size: 18rpx; line-height: 1.45; }
.record-location { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.record-status { flex-shrink: 0; margin-left: 10rpx; padding: 5rpx 11rpx; border-radius: 999rpx; background: #f0eee9; color: #777; font-size: 18rpx; }
.record-status.checked { background: #edf5ee; color: #64806b; }
.record-status.absent { background: #fff0ed; color: #c45c4e; }
.empty-card { margin-top: 40rpx; padding: 90rpx 30rpx; border-radius: 28rpx; background: #fff; text-align: center; box-shadow: 0 10rpx 30rpx rgba(55,44,31,.05); }
.empty-mark { width: 76rpx; height: 76rpx; margin: auto; border-radius: 22rpx; background: #f4ede5; color: #9d714a; font-size: 32rpx; line-height: 76rpx; }
.empty-title { margin-top: 20rpx; color: #39413e; font-size: 29rpx; font-weight: 700; }
.empty-sub { margin-top: 7rpx; color: #999f9c; font-size: 22rpx; }
