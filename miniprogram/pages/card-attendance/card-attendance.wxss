.attendance-page { min-height: 100vh; padding: 22rpx 24rpx 90rpx; background: #f7f6f3; }
.card-tabs { width: 100%; margin-bottom: 18rpx; white-space: nowrap; } .card-tab-row { display: inline-flex; gap: 14rpx; }
.card-tab { padding: 13rpx 22rpx; border: 1rpx solid #dedbd5; border-radius: 999rpx; background: #fff; color: #777e7b; font-size: 23rpx; }
.card-tab.active { border-color: #293633; background: #293633; color: #fff; }
.training-card { position: relative; overflow: hidden; padding: 32rpx; border-radius: 30rpx; background: linear-gradient(135deg,#293633,#516c64); color: #fff; box-shadow: 0 14rpx 36rpx rgba(38,49,46,.18); }
.card-top { position: relative; z-index: 2; display: flex; align-items: flex-start; justify-content: space-between; }
.card-brand { color: #e7c691; font-size: 20rpx; font-weight: 700; letter-spacing: 4rpx; } .card-title { margin-top: 12rpx; font-size: 36rpx; font-weight: 700; }
.card-state { padding: 7rpx 15rpx; border-radius: 999rpx; background: rgba(255,255,255,.14); font-size: 20rpx; }
.course-name { position: relative; z-index: 2; margin-top: 30rpx; color: rgba(255,255,255,.82); font-size: 26rpx; }
.card-bottom { position: relative; z-index: 2; display: flex; justify-content: space-between; margin-top: 32rpx; color: rgba(255,255,255,.65); font-size: 20rpx; }
.card-ring { position: absolute; border: 28rpx solid rgba(255,255,255,.05); border-radius: 50%; } .ring-one { right: -80rpx; top: -100rpx; width: 250rpx; height: 250rpx; } .ring-two { right: 90rpx; bottom: -120rpx; width: 190rpx; height: 190rpx; }
.stats-card { margin-top: 20rpx; padding: 28rpx; border-radius: 26rpx; background: #fff; }
.stats-title { color: #2d3431; font-size: 30rpx; font-weight: 700; }
.stats-grid { display: flex; margin-top: 26rpx; }
.stats-grid view { flex: 1; display: flex; flex-direction: column; align-items: center; border-right: 1rpx solid #ebe8e3; } .stats-grid view:last-child { border-right: 0; }
.stat-value { color: #323936; font-size: 37rpx; font-weight: 700; } .stat-value.primary { color: var(--color-primary); } .stat-value.sage { color: #66806c; }
.stat-label { margin-top: 5rpx; color: #8d928f; font-size: 20rpx; }
.progress-head { display: flex; justify-content: space-between; margin-top: 28rpx; color: #707774; font-size: 21rpx; }
.progress-track { height: 12rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: #ece9e4; } .progress-value { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg,#b98555,#d4aa7e); }
.stats-note { margin-top: 15rpx; padding: 12rpx 15rpx; border-radius: 12rpx; background: #faf6f0; color: #8c7967; font-size: 20rpx; line-height: 1.5; }
.code-entry { display: flex; align-items: center; margin-top: 20rpx; padding: 25rpx 26rpx; border-radius: 24rpx; background: #fff; }
.code-icon { width: 66rpx; height: 66rpx; border-radius: 18rpx; background: #f2e6d7; color: #9a7049; text-align: center; line-height: 66rpx; font-size: 34rpx; }
.code-copy { flex: 1; margin-left: 17rpx; color: #313835; font-size: 27rpx; font-weight: 700; } .code-copy text { display: block; margin-top: 4rpx; color: #919693; font-size: 20rpx; font-weight: 400; }
.code-arrow { color: #aaa; font-size: 38rpx; }
.records-head { display: flex; justify-content: space-between; margin-top: 34rpx; } .records-title { color: #2d3431; font-size: 32rpx; font-weight: 700; } .records-sub { margin-top: 4rpx; color: #969b98; font-size: 21rpx; }
.filter-scroll { width: 100%; margin: 20rpx 0 14rpx; white-space: nowrap; } .filter-row { display: inline-flex; gap: 13rpx; }
.filter-item { padding: 11rpx 22rpx; border-radius: 999rpx; background: #eceae6; color: #707774; font-size: 22rpx; } .filter-item.active { background: #293633; color: #fff; }
.record-list { padding: 4rpx 20rpx 6rpx; border-radius: 24rpx; background: #fff; }
.record-item { display: flex; align-items: flex-start; min-height: 150rpx; padding: 24rpx 0; border-bottom: 1rpx solid #eeece7; } .record-item:last-child { border-bottom: 0; }
.record-date { width: 105rpx; display: flex; flex-direction: column; color: #454c49; font-size: 25rpx; font-weight: 700; } .record-date text:last-child { margin-top: 5rpx; color: #a0a4a1; font-size: 18rpx; font-weight: 400; }
.record-line { position: relative; width: 30rpx; min-height: 102rpx; } .dot { position: relative; z-index: 2; width: 18rpx; height: 18rpx; border: 5rpx solid #fff; border-radius: 50%; background: #aaa; box-shadow: 0 0 0 2rpx #aaa; }
.dot.checked { background: #6e9278; box-shadow: 0 0 0 2rpx #6e9278; } .dot.absent { background: #d26a5c; box-shadow: 0 0 0 2rpx #d26a5c; } .dot.upcoming { background: #c6a06d; box-shadow: 0 0 0 2rpx #c6a06d; }
.line { position: absolute; left: 8rpx; top: 21rpx; bottom: -48rpx; width: 2rpx; background: #e3e0da; }
.record-info { flex: 1; min-width: 0; padding: 0 10rpx; } .record-title { color: #323936; font-size: 26rpx; font-weight: 700; } .record-meta { margin-top: 7rpx; color: #8d928f; font-size: 20rpx; line-height: 1.5; }
.checked-time { margin-top: 5rpx; color: #76917d; font-size: 19rpx; }
.status { flex-shrink: 0; padding: 6rpx 12rpx; border-radius: 999rpx; font-size: 19rpx; } .status.checked { background: #edf4ee; color: #61806a; } .status.absent { background: #fbecea; color: #bd5c50; } .status.upcoming { background: #f7f0e5; color: #a47b49; }
.empty-record { margin-top: 16rpx; padding: 70rpx 30rpx; border-radius: 24rpx; background: #fff; text-align: center; } .page-empty { margin-top: 20rpx; }
.empty-icon { margin: auto; width: 70rpx; height: 70rpx; border-radius: 50%; background: #f2eee8; color: #a68a68; font-size: 35rpx; line-height: 70rpx; }
.empty-title { margin-top: 15rpx; color: #3d4441; font-size: 28rpx; font-weight: 700; } .empty-sub { margin-top: 7rpx; color: #9a9f9c; font-size: 22rpx; }
