.attendance-page { min-height: 100vh; padding: 36rpx 24rpx 90rpx; background: linear-gradient(180deg, #f8f3ec 0, #faf9f6 360rpx, #f8f7f3 100%); }
.page-intro { padding: 8rpx 12rpx 30rpx; }
.eyebrow { color: #b98555; font-size: 19rpx; font-weight: 700; letter-spacing: 4rpx; }
.page-title { margin-top: 7rpx; color: #26312f; font-size: 48rpx; font-weight: 750; letter-spacing: 1rpx; }
.page-subtitle { margin-top: 8rpx; color: #7a817f; font-size: 25rpx; }
.card-tabs { width: 100%; margin-bottom: 18rpx; white-space: nowrap; }
.card-tab-row { display: inline-flex; gap: 14rpx; padding: 0 2rpx; }
.card-tab { max-width: 330rpx; overflow: hidden; padding: 13rpx 22rpx; border: 1rpx solid #dfd8cf; border-radius: 999rpx; background: rgba(255,255,255,.82); color: #727a77; font-size: 23rpx; text-overflow: ellipsis; }
.card-tab.active { border-color: #26312f; background: #26312f; color: #fff; }
.checkin-card { overflow: hidden; border: 1rpx solid rgba(81,69,54,.08); border-radius: 30rpx; background: #fff; box-shadow: 0 14rpx 40rpx rgba(55,44,31,.07); }
.course-strip { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 30rpx; background: linear-gradient(135deg, #293633, #52665f); color: #fff; }
.course-copy { min-width: 0; padding-right: 20rpx; }
.course-label { color: rgba(255,255,255,.58); font-size: 20rpx; letter-spacing: 2rpx; }
.course-title { margin-top: 6rpx; overflow: hidden; font-size: 30rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.remain-pill { flex-shrink: 0; padding: 7rpx 14rpx; border-radius: 999rpx; background: rgba(255,255,255,.12); color: #edd5b3; font-size: 20rpx; }
.info-section { padding: 30rpx 30rpx 10rpx; }
.section-title { margin-bottom: 8rpx; color: #303835; font-size: 29rpx; font-weight: 700; }
.required { margin-right: 5rpx; color: #d76654; }
.info-row { display: flex; min-height: 114rpx; align-items: center; border-bottom: 1rpx solid #eeeae4; }
.line-icon { position: relative; flex-shrink: 0; width: 48rpx; height: 48rpx; margin-right: 20rpx; color: #9a7652; }
.person-head { position: absolute; left: 16rpx; top: 4rpx; width: 16rpx; height: 16rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.person-body { position: absolute; left: 8rpx; bottom: 4rpx; width: 32rpx; height: 18rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 20rpx 20rpx 0 0; }
.phone-icon { width: 30rpx; height: 44rpx; margin-right: 38rpx; border: 3rpx solid currentColor; border-radius: 7rpx; }
.phone-speaker { width: 9rpx; height: 2rpx; margin: 5rpx auto 0; border-radius: 2rpx; background: currentColor; }
.phone-home { position: absolute; left: 11rpx; bottom: 4rpx; width: 4rpx; height: 4rpx; border-radius: 50%; background: currentColor; }
.pin-icon { width: 34rpx; height: 42rpx; margin-right: 34rpx; border: 3rpx solid currentColor; border-radius: 50% 50% 50% 4rpx; transform: rotate(-45deg); }
.pin-dot { width: 8rpx; height: 8rpx; margin: 10rpx auto; border: 3rpx solid currentColor; border-radius: 50%; }
.info-content { flex: 1; min-width: 0; }
.info-label { color: #929895; font-size: 21rpx; }
.info-value, .info-input { width: 100%; margin-top: 3rpx; color: #303835; font-size: 28rpx; font-weight: 600; }
.info-value.muted { color: #9ca19f; font-weight: 400; }
.info-value.located { color: #587263; font-size: 23rpx; }
.auto-tag { flex-shrink: 0; padding: 5rpx 10rpx; border-radius: 999rpx; background: #f8efe5; color: #8b613d; font-size: 18rpx; }
.refresh-location { flex-shrink: 0; margin-left: 12rpx; color: #9a6a40; font-size: 21rpx; }
.privacy-note { padding: 15rpx 0 12rpx 68rpx; color: #a2a6a4; font-size: 19rpx; }
.checkin-button { display: flex; width: 286rpx; height: 286rpx; margin: 32rpx auto 0; flex-direction: column; align-items: center; justify-content: center; border: 14rpx solid #f5e9dc; border-radius: 50%; background: linear-gradient(145deg, #bf8c5d, #a86f40); color: #fff; box-shadow: 0 18rpx 40rpx rgba(137,92,52,.22), inset 0 2rpx 0 rgba(255,255,255,.2); }
.checkin-button::after { border: 0; }
.checkin-button.disabled { border-color: #eeeae4; background: #c8c4bd; box-shadow: none; color: rgba(255,255,255,.88); }
.button-title { font-size: 38rpx; font-weight: 750; letter-spacing: 2rpx; }
.button-time { margin-top: 7rpx; font-size: 25rpx; font-weight: 400; letter-spacing: 2rpx; opacity: .78; }
.button-hint { padding: 22rpx 20rpx 34rpx; color: #999f9c; text-align: center; font-size: 21rpx; }
.records-card { margin-top: 22rpx; padding: 28rpx 30rpx 10rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(55,44,31,.05); }
.records-title { padding-bottom: 14rpx; color: #313936; font-size: 29rpx; font-weight: 700; }
.record-item { display: flex; min-height: 104rpx; align-items: center; border-top: 1rpx solid #eeeae4; }
.record-date { width: 82rpx; color: #98714c; font-size: 24rpx; font-weight: 700; }
.record-copy { flex: 1; min-width: 0; }
.record-name { overflow: hidden; color: #3e4643; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.record-meta { margin-top: 3rpx; color: #9ba09e; font-size: 19rpx; }
.record-status { padding: 5rpx 11rpx; border-radius: 999rpx; background: #f0eee9; color: #777; font-size: 19rpx; }
.record-status.checked { background: #edf5ee; color: #64806b; }
.record-status.absent { background: #fff0ed; color: #c45c4e; }
.empty-card { margin-top: 40rpx; padding: 90rpx 30rpx; border-radius: 28rpx; background: #fff; text-align: center; box-shadow: 0 10rpx 30rpx rgba(55,44,31,.05); }
.empty-mark { width: 74rpx; height: 74rpx; margin: auto; border-radius: 22rpx; background: #f4ede5; color: #9d714a; font-size: 32rpx; line-height: 74rpx; }
.empty-title { margin-top: 20rpx; color: #39413e; font-size: 29rpx; font-weight: 700; }
.empty-sub { margin-top: 7rpx; color: #999f9c; font-size: 22rpx; }
