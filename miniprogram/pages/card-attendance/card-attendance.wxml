<view class="attendance-page">
  <view class="page-intro">
    <view class="eyebrow">COURSE CHECK-IN</view>
    <view class="page-title">课程签到</view>
    <view class="page-subtitle">确认信息与到场位置后，一键完成本次签到</view>
  </view>

  <scroll-view wx:if="{{cards.length > 1}}" scroll-x class="card-tabs" enhanced show-scrollbar="{{false}}">
    <view class="card-tab-row"><view wx:for="{{cards}}" wx:key="id" class="card-tab {{activeCardId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCard">{{item.courseName || item.title}}</view></view>
  </scroll-view>

  <view wx:if="{{currentCard}}" class="checkin-card">
    <view class="course-strip">
      <view class="course-copy"><view class="course-label">本次签到课程</view><view class="course-title">{{currentCard.courseName || currentCard.title}}</view></view>
      <view class="remain-pill">剩余 {{currentCard.remainText}}</view>
    </view>

    <view class="info-section">
      <view class="section-title"><text class="required">*</text>签到人信息</view>
      <view class="info-row">
        <view class="line-icon person-icon"><view class="person-head"></view><view class="person-body"></view></view>
        <view class="info-content"><view class="info-label">姓名</view><input wx:if="{{needsName}}" class="info-input" value="{{memberName}}" placeholder="请输入姓名" maxlength="20" bindinput="onNameInput" /><view wx:else class="info-value">{{memberName}}</view></view>
        <view wx:if="{{!needsName}}" class="auto-tag">自动读取</view>
      </view>
      <view class="info-row">
        <view class="line-icon phone-icon"><view class="phone-speaker"></view><view class="phone-home"></view></view>
        <view class="info-content"><view class="info-label">手机号</view><input wx:if="{{needsPhone}}" class="info-input" type="number" value="{{memberPhone}}" placeholder="请输入手机号" maxlength="11" bindinput="onPhoneInput" /><view wx:else class="info-value">{{phoneDisplay}}</view></view>
        <view wx:if="{{!needsPhone}}" class="auto-tag">自动读取</view>
      </view>
      <view class="info-row location-row" bindtap="requestLocation">
        <view class="line-icon pin-icon"><view class="pin-dot"></view></view>
        <view class="info-content"><view class="info-label">打卡位置</view><view class="info-value {{location ? 'located' : 'muted'}}">{{locationText}}</view></view>
        <view class="refresh-location">{{locating ? '定位中' : '重定位'}}</view>
      </view>
      <view class="privacy-note">位置信息仅用于本次课程签到核验</view>
    </view>

    <button class="checkin-button {{canCheckIn ? '' : 'disabled'}}" disabled="{{!canCheckIn}}" loading="{{submitting}}" bindtap="submitCheckIn">
      <text class="button-title">{{submitting ? '签到中' : '一键签到'}}</text><text class="button-time">{{clock}}</text>
    </button>
    <view class="button-hint">签到成功后将自动核销 1 次课程</view>
  </view>

  <view wx:if="{{currentCard && records.length}}" class="records-card">
    <view class="records-title">最近签到</view>
    <view wx:for="{{records}}" wx:key="id" class="record-item">
      <view class="record-date">{{item.displayDate}}</view><view class="record-copy"><view class="record-name">{{item.lesson}}</view><view class="record-meta">{{item.checkedAt || item.time}} · {{item.typeLabel}}</view></view><view class="record-status {{item.statusCls}}">{{item.statusLabel}}</view>
    </view>
  </view>

  <view wx:if="{{!currentCard}}" class="empty-card"><view class="empty-mark">课</view><view class="empty-title">暂无可签到课程</view><view class="empty-sub">购买培训课程后，可在这里一键签到</view></view>
</view>
