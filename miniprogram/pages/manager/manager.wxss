.manager-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.manager-top {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-hover));
  color: #ffffff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.manager-brand {
  font-size: 42rpx;
  font-weight: 700;
}

.manager-hello {
  margin-top: 6rpx;
  opacity: 0.92;
}

.badge {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 28rpx;
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  grid-template-columns: repeat(3, 1fr);
  padding: 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid var(--color-border);
}

.metric {
  text-align: center;
  width: 33.33%;
}

.metric-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.metric-label {
  color: var(--color-text-3);
  font-size: 26rpx;
}

.nav {
  display: flex;
  flex-wrap: wrap;
  grid-template-columns: repeat(5, 1fr);
  background: #ffffff;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 18rpx;
  color: var(--color-text-3);
  font-weight: 700;
  font-size: 26rpx;
  width: 20%;
}

.nav-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.content {
  padding: 24rpx;
}

.section {
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
}

.commission-grid {
  display: flex;
  flex-wrap: wrap;
  grid-template-columns: repeat(3, 1fr);
}

.commission-box {
  background: #f6f7f8;
  border-radius: 18rpx;
  padding: 20rpx;
  text-align: center;
  width: 33.33%;
}

.commission-box text {
  display: block;
  color: var(--color-text-3);
  font-size: 26rpx;
}

.commission-box strong {
  font-size: 34rpx;
  margin-top: 6rpx;
}

.order-line {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: 28rpx;
}

.order-line:last-child {
  border-bottom: 0;
}

.customer-row,
.commission-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: 28rpx;
}

.customer-name {
  font-weight: 700;
}

.customer-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.customer-source {
  color: var(--color-text-3);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.small-btn {
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.small-btn.danger {
  border-color: var(--color-danger);
  color: var(--color-danger);
}

.commission-order {
  flex: 1;
  color: var(--color-text-3);
}

.commission-amount {
  color: var(--color-primary);
  font-weight: 700;
}

.rate-line {
  color: var(--color-text-3);
  font-size: 26rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
}

.withdraw-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.withdraw-row:last-child {
  border-bottom: 0;
}

.withdraw-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.withdraw-meta {
  color: var(--color-text-3);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.withdraw-meta.red {
  color: var(--color-danger);
}

.promote-card {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.qr {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  background: var(--color-fill);
}

.promote-info {
  flex: 1;
}

.promote-name {
  font-weight: 700;
  font-size: 34rpx;
}

.promote-sub {
  color: var(--color-text-3);
  font-size: 26rpx;
  margin: 8rpx 0 16rpx;
}

.invite-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid var(--color-border);
  padding-top: 24rpx;
  margin-bottom: 24rpx;
}

.invite-code {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.share-btn {
  width: 100%;
  background: var(--color-primary);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  font-weight: 700;
  font-size: 34rpx;
}

.promote-activity {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.promote-activity:last-child {
  border-bottom: 0;
}

.promote-cover {
  width: 84rpx;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.promote-activity-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.promote-activity-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.promote-activity-price {
  color: var(--color-text-3);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.promote-commission {
  text-align: right;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.promote-commission-rate {
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.promote-commission-amount {
  color: var(--color-success);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.promote-activity-tip {
  color: var(--color-text-3);
  font-size: 24rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--color-border);
  line-height: 1.5;
}

.pay-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 22, 26, 0.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx;
}

.pay-modal {
  width: 100%;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 34rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}

.withdraw-sub {
  color: var(--color-text-3);
  margin-bottom: 20rpx;
}

.withdraw-tip {
  color: var(--color-text-3);
  font-size: 26rpx;
  text-align: center;
  margin: 14rpx 0 24rpx;
}

.withdraw-calc {
  background: #f6f7f8;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.withdraw-calc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: var(--color-text-1);
}

.withdraw-calc-row + .withdraw-calc-row {
  border-top: 1rpx solid var(--color-border);
}

.withdraw-calc-row.strong {
  color: var(--color-primary);
  font-weight: 700;
}
