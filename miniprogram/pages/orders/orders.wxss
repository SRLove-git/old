.filter-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 6rpx 0 24rpx;
}

.filter-row {
  display: inline-flex;
}

.chip {
  background: #ffffff;
  border: 2rpx solid var(--color-border);
  color: var(--color-text-1);
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.chip.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

.order-list {
  display: flex;
  flex-direction: column;
}

.order-card {
  padding: 24rpx;
}

.order-top {
  display: flex;
  align-items: flex-start;
}

.order-cover {
  width: 116rpx;
  height: 116rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
}

.order-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.order-meta {
  color: var(--color-text-3);
  font-size: 26rpx;
  margin-top: 8rpx;
}

.status {
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  background: var(--color-fill);
  color: var(--color-text-3);
}

.status.out,
.status.done,
.status.verified {
  background: var(--color-success-light);
  color: var(--color-success);
}

.status.pending,
.status.refunding,
.status.shipping {
  background: var(--color-primary-light);
  color: var(--color-primary-text);
}

.status.review {
  background: var(--color-info-light);
  color: var(--color-info);
}

.status.refunded,
.status.cancelled {
  background: var(--color-fill);
  color: var(--color-text-3);
}

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
}

.amount {
  color: var(--color-primary);
  font-weight: 700;
  font-size: 38rpx;
}

.go {
  background: var(--color-primary);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-weight: 700;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  color: var(--color-text-3);
  padding: 80rpx;
}
