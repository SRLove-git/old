<view class="page">
  <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view
        wx:for="{{statuses}}"
        wx:key="*this"
        class="chip {{filter === item ? 'active' : ''}}"
        data-status="{{item}}"
        bindtap="setFilter"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{list.length > 0}}" class="order-list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="order-card card"
      data-id="{{item.id}}"
      bindtap="goOrder"
    >
      <view class="order-top">
        <view class="order-cover" style="background: {{item.coverTone}}">{{item.cover}}</view>
        <view class="order-info">
          <view class="order-title">{{item.title}}</view>
          <view class="order-meta">📅 {{item.timeText}}</view>
          <view wx:if="{{item.venueAddress}}" class="order-meta">📍 {{item.venueAddress}}</view>
          <view wx:if="{{item.trackingNo}}" class="order-meta">🚚 {{item.carrier}} {{item.trackingNo}}</view>
          <view class="order-meta">👥 {{item.participants}}</view>
        </view>
        <text class="status {{item.statusClass}}">{{item.displayStatus}}</text>
      </view>
      <view class="order-foot">
        <text class="amount">¥{{item.payAmount}}</text>
        <text class="go">查看详情</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="empty-emoji">🧾</view>
    <view class="empty-title">暂无相关订单</view>
    <view class="empty-sub">去看看感兴趣的活动吧</view>
    <button class="btn btn-primary" bindtap="goList">去找活动</button>
  </view>
</view>
