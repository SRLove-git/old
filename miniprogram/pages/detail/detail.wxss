.detail-page { min-height: 100vh; padding-bottom: 150rpx; background: #fff; color: var(--color-text-1); }
.product-gallery, .gallery-slide { height: 720rpx; }
.gallery-slide { position: relative; overflow: hidden; background: var(--color-fill); }
.gallery-image { width: 100%; height: 100%; }
.gallery-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: linear-gradient(180deg,rgba(0,0,0,.08),transparent 35%,rgba(0,0,0,.22)); }
.gallery-brand { position: absolute; left: 28rpx; top: 26rpx; padding: 9rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.88); color: #6d614f; font-size: 21rpx; font-weight: 700; }
.gallery-count { position: absolute; right: 24rpx; bottom: 22rpx; padding: 7rpx 14rpx; border-radius: 999rpx; background: rgba(0,0,0,.46); color: #fff; font-size: 22rpx; }
.detail-tabs { position: sticky; top: 0; z-index: 30; display: flex; height: 88rpx; background: rgba(255,255,255,.97); border-bottom: 1rpx solid var(--color-border); }
.detail-tab { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; color: var(--color-text-2); font-size: 27rpx; }
.detail-tab.active { color: var(--color-text-1); font-weight: 700; }
.detail-tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; width: 46rpx; height: 6rpx; margin-left: -23rpx; border-radius: 6rpx; background: var(--color-primary); }
.tab-panel { min-height: 540rpx; background: #fff; }
.product-panel { padding: 28rpx 0 70rpx; }
.price-line, .title-share-row, .product-sub, .rank-label { margin-left: 24rpx; margin-right: 24rpx; }
.price-line { display: flex; align-items: baseline; color: var(--color-primary); }
.currency { font-size: 29rpx; font-weight: 700; }
.price { font-size: 50rpx; font-weight: 700; }
.original { margin-left: 14rpx; color: var(--color-text-3); font-size: 23rpx; text-decoration: line-through; }
.member-banner { display: flex; align-items: center; justify-content: space-between; margin: 22rpx 24rpx 18rpx; padding: 22rpx 24rpx; border-radius: 26rpx; background: linear-gradient(135deg,#f8e4c8,#f3d2a7); color: #6f451f; font-size: 24rpx; }
.member-mark { margin-right: 10rpx; padding: 4rpx 10rpx; border-radius: 6rpx; background: var(--color-ink); color: #fff; font-size: 20rpx; }
.member-save { margin-left: 6rpx; color: #6f451f; font-size: 30rpx; font-weight: 700; }
.member-link { padding: 12rpx 24rpx; border-radius: 999rpx; background: linear-gradient(135deg,#e98560,#e65a4e); color: #fff; font-size: 24rpx; font-weight: 700; }
.title-share-row { display: flex; align-items: flex-start; gap: 16rpx; }
.product-title { flex: 1; font-size: 31rpx; font-weight: 700; line-height: 1.45; }
.share-button { flex: none; width: 76rpx; height: 76rpx; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; overflow: visible; line-height: 1; }
.detail-share-circle { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #e3ddd4; border-radius: 50%; background: #f8f5f0; }
.detail-share-mark { position: relative; width: 38rpx; height: 38rpx; }
.detail-share-mark::before, .detail-share-mark::after { content: ''; position: absolute; left: 12rpx; width: 20rpx; height: 3rpx; border-radius: 3rpx; background: #56665f; transform-origin: left center; }
.detail-share-mark::before { top: 13rpx; transform: rotate(-28deg); }
.detail-share-mark::after { top: 24rpx; transform: rotate(28deg); }
.detail-share-node { position: absolute; z-index: 2; width: 11rpx; height: 11rpx; border: 3rpx solid #56665f; border-radius: 50%; background: #f8f5f0; }
.detail-node-top { right: 0; top: 0; }
.detail-node-left { left: 0; top: 14rpx; }
.detail-node-right { right: 0; bottom: 0; }
.product-sub { margin-top: 9rpx; color: var(--color-text-3); font-size: 23rpx; line-height: 1.55; }
.rank-label { display: inline-flex; margin-top: 11rpx; padding: 6rpx 13rpx; border-radius: 12rpx; background: var(--color-primary-light); color: var(--color-primary-text); font-size: 20rpx; font-weight: 700; }
.info-row { display: flex; align-items: center; margin: 20rpx 24rpx 0; padding: 22rpx 0; border-top: 1rpx solid var(--color-border); }
.info-label { width: 76rpx; color: var(--color-text-3); }
.info-value { flex: 1; color: var(--color-text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.row-arrow { color: var(--color-text-3); font-size: 40rpx; }
.detail-buy-button { width: auto; min-height: 88rpx; margin: 24rpx 24rpx 0; border-radius: 22rpx; font-size: 29rpx; letter-spacing: 2rpx; }
.section-card { margin: 24rpx 24rpx 0; padding: 28rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 34rpx rgba(55,44,31,.06); }
.section-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; color: var(--color-text-1); font-size: 31rpx; font-weight: 700; }
.muted-link { color: var(--color-text-3); font-size: 23rpx; font-weight: 400; }
.buyer-row { display: flex; align-items: center; padding: 10rpx 0; }
.buyer-avatar { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-fill); font-size: 28rpx; }
.buyer-name { width: 110rpx; margin-left: 12rpx; font-size: 23rpx; }
.buyer-time { flex: 1; color: var(--color-text-3); font-size: 22rpx; }
.buyer-go { min-height: 0; padding: 9rpx 24rpx; font-size: 22rpx; }
.review { display: flex; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--color-border); }
.first-review { padding-bottom: 4rpx; border-bottom: 0; }
.review-avatar { flex: none; width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-light); }
.review-name { font-size: 24rpx; font-weight: 700; }
.review-text { margin-top: 7rpx; color: var(--color-text-2); font-size: 25rpx; line-height: 1.55; }
.review-time { margin-top: 8rpx; color: var(--color-text-3); font-size: 20rpx; }
.review-head-actions { display: flex; align-items: center; gap: 14rpx; }
.write-review-button { flex: none; min-width: 120rpx; height: 58rpx; padding: 0 20rpx; border: 1rpx solid var(--color-primary); border-radius: 999rpx; background: var(--color-primary-light); color: var(--color-primary-text); font-size: 23rpx; font-weight: 700; line-height: 58rpx; }
.review-compose-sheet { padding-bottom: calc(42rpx + env(safe-area-inset-bottom)); }
.review-compose-title { color: var(--color-text-1); font-size: 34rpx; font-weight: 700; text-align: center; }
.review-compose-sub { margin-top: 8rpx; color: var(--color-text-3); font-size: 23rpx; text-align: center; }
.review-stars { display: flex; justify-content: center; gap: 18rpx; margin: 30rpx 0 26rpx; }
.review-star { color: #d9d5ce; font-size: 58rpx; line-height: 1; }
.review-star.on { color: #f2a93b; }
.review-compose-input { width: 100%; height: 210rpx; padding: 22rpx; border: 2rpx solid var(--color-border); border-radius: 20rpx; background: #faf9f6; color: var(--color-text-1); font-size: 27rpx; line-height: 1.6; }
.review-placeholder { color: #aaa69f; }
.review-count { margin: 8rpx 4rpx 22rpx; color: var(--color-text-3); font-size: 21rpx; text-align: right; }
.review-submit { min-height: 88rpx; border-radius: 22rpx; font-size: 29rpx; }
.merchant-card { display: flex; align-items: center; margin: 24rpx 24rpx 0; padding: 28rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 34rpx rgba(55,44,31,.06); }
.merchant-logo { width: 74rpx; height: 74rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(135deg,#e9c694,#c79a58); color: #fff; font-size: 31rpx; font-weight: 700; }
.merchant-copy { flex: 1; margin-left: 18rpx; }
.merchant-name { font-size: 29rpx; font-weight: 700; }
.merchant-cert { display: inline-flex; margin-top: 7rpx; padding: 4rpx 10rpx; border-radius: 6rpx; background: var(--color-danger); color: #fff; font-size: 22rpx; }
.merchant-enter { min-height: 0; padding: 9rpx 22rpx; font-size: 22rpx; }
.assistant-note { padding: 30rpx 24rpx 16rpx; color: var(--color-text-2); font-size: 25rpx; line-height: 1.65; }
.product-copy { padding: 18rpx 24rpx 30rpx; }
.copy-title { margin-bottom: 28rpx; color: var(--color-text-1); font-size: 31rpx; font-weight: 700; }
.copy-paragraph { margin-top: 20rpx; color: var(--color-text-2); font-size: 27rpx; line-height: 1.8; }
.review-panel, .detail-rich, .recommend-panel { padding: 30rpx 24rpx 60rpx; box-sizing: border-box; }
.detail-rich .merchant-card { margin: 24rpx 0 0; }
.detail-text { display: block; margin: 25rpx 0; color: var(--color-text-2); font-size: 28rpx; line-height: 1.85; white-space: pre-wrap; }
.detail-media { position: relative; height: 430rpx; margin: 24rpx 0; overflow: hidden; border-radius: 16rpx; background: var(--color-fill); }
.detail-media image, .detail-video-player { width: 100%; height: 100%; }
.detail-media > text { position: absolute; left: 20rpx; bottom: 18rpx; padding: 7rpx 14rpx; border-radius: 999rpx; background: rgba(0,0,0,.48); color: #fff; font-size: 21rpx; }
.video-placeholder { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--color-text-3); }
.video-play { width: 80rpx; height: 80rpx; margin-bottom: 14rpx; border-radius: 50%; background: var(--color-primary); color: #fff; text-align: center; line-height: 80rpx; text-indent: 5rpx; font-size: 32rpx; }
.recommend-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.recommend-card { min-width: 0; overflow: hidden; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 25rpx rgba(51,43,33,.08); }
.recommend-cover { width: 100%; height: 300rpx; background: var(--color-fill); }
.recommend-title { height: 78rpx; padding: 14rpx 14rpx 0; font-size: 25rpx; line-height: 1.45; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.recommend-rank { padding: 5rpx 14rpx 0; color: var(--color-primary-text); font-size: 20rpx; }
.recommend-price { padding: 10rpx 14rpx 18rpx; color: var(--color-primary); font-size: 30rpx; font-weight: 700; }
.empty-review { padding: 70rpx 0; color: var(--color-text-3); text-align: center; }
.product-bottom { z-index: 100; display: flex; align-items: center; gap: 3rpx; height: 116rpx; padding: 10rpx 18rpx calc(10rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.98); border-top: 1rpx solid var(--color-border); }
.bottom-icon { width: 78rpx; display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 0; background: transparent; color: var(--color-text-2); font-size: 22rpx; }
.bottom-icon text:first-child { font-size: 36rpx; line-height: 1; }
.bottom-icon[disabled] { opacity: .35; }
.buy-actions { flex: 1; display: flex; height: 82rpx; margin-left: 7rpx; overflow: hidden; border-radius: 999rpx; }
.add-cart, .buy-now { flex: 1; min-height: 0; height: 100%; padding: 0; border-radius: 0; font-size: 29rpx; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.sheet-title { margin-bottom: 0; font-size: 34rpx; font-weight: 700; }
.close { width: 64rpx; height: 64rpx; background: transparent; color: var(--color-text-3); font-size: 42rpx; }
.sku-summary { display: flex; align-items: center; gap: 18rpx; margin: 24rpx 0; }
.sku-cover-image { width: 132rpx; height: 132rpx; border-radius: 16rpx; background: var(--color-fill); }
.sku-price { color: var(--color-primary); font-size: 42rpx; font-weight: 700; }
.sku-title { max-width: 500rpx; margin-top: 5rpx; color: var(--color-text-3); font-size: 23rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sku-options { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 26rpx; }
.sku-option { position: relative; min-width: 200rpx; padding: 19rpx; border: 2rpx solid var(--color-border); border-radius: 18rpx; }
.sku-option.selected { border-color: var(--color-primary); background: var(--color-primary-light); }
.sku-name { display: block; font-size: 24rpx; font-weight: 700; }
.sku-price-sm { color: var(--color-primary); font-size: 27rpx; }
.hot { position: absolute; right: -2rpx; top: -2rpx; padding: 4rpx 10rpx; border-radius: 0 16rpx 0 16rpx; background: var(--color-primary); color: #fff; font-size: 22rpx; }
.venue-card .venue-row { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 12rpx; padding: 20rpx 18rpx; border: 2rpx solid var(--color-border); border-radius: 16rpx; background: var(--color-bg); }
.venue-card .venue-row.active { border-color: var(--color-primary); background: var(--color-primary-light); }
.venue-pin { font-size: 26rpx; line-height: 1.4; }
.venue-info { flex: 1; min-width: 0; }
.venue-name { color: var(--color-text-1); font-size: 26rpx; font-weight: 700; }
.venue-address { margin-top: 6rpx; color: var(--color-text-3); font-size: 23rpx; line-height: 1.5; }
.venue-picked { flex: none; color: var(--color-primary); font-size: 22rpx; font-weight: 700; }
.sku-options.stacked { flex-direction: column; }
.sku-options.stacked .sku-option { width: 100%; min-width: 0; box-sizing: border-box; }
.sku-option-addr { display: block; margin: 8rpx 0; color: var(--color-text-3); font-size: 21rpx; line-height: 1.5; }
.sheet-venue { display: flex; align-items: flex-start; gap: 10rpx; margin-bottom: 24rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: var(--color-primary-light); }
.sheet-venue-pin { font-size: 26rpx; }
.sheet-venue-body { flex: 1; min-width: 0; }
.sheet-venue-label { color: var(--color-primary-text); font-size: 21rpx; font-weight: 700; }
.sheet-venue-text { margin-top: 5rpx; color: var(--color-text-2); font-size: 24rpx; line-height: 1.5; }
