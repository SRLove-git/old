.detail-page { min-height: 100vh; padding-bottom: 150rpx; background: #f6f6f6; color: #292929; }
.product-gallery, .gallery-slide { height: 720rpx; }
.gallery-slide { position: relative; overflow: hidden; background: #ddd; }
.gallery-image { width: 100%; height: 100%; }
.gallery-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: linear-gradient(180deg,rgba(0,0,0,.08),transparent 35%,rgba(0,0,0,.22)); }
.gallery-brand { position: absolute; left: 28rpx; top: 26rpx; padding: 9rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.88); color: #6d614f; font-size: 21rpx; font-weight: 700; }
.gallery-count { position: absolute; right: 24rpx; bottom: 22rpx; padding: 7rpx 14rpx; border-radius: 999rpx; background: rgba(0,0,0,.46); color: #fff; font-size: 22rpx; }
.detail-tabs { position: sticky; top: 0; z-index: 30; display: flex; height: 88rpx; background: rgba(255,255,255,.97); border-bottom: 1rpx solid #eee; }
.detail-tab { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; color: #6f6f6f; font-size: 27rpx; }
.detail-tab.active { color: #313131; font-weight: 700; }
.detail-tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; width: 46rpx; height: 6rpx; margin-left: -23rpx; border-radius: 6rpx; background: #c8a75d; }
.tab-panel { min-height: 540rpx; background: #fff; }
.product-panel { padding: 28rpx 0 70rpx; }
.price-line, .title-share-row, .product-sub, .rank-label { margin-left: 28rpx; margin-right: 28rpx; }
.price-line { display: flex; align-items: baseline; color: #c2a25b; }
.currency { font-size: 29rpx; font-weight: 700; }.price { font-size: 50rpx; font-weight: 700; }.original { margin-left: 14rpx; color: #aaa; font-size: 23rpx; text-decoration: line-through; }
.member-banner { display: flex; align-items: center; justify-content: space-between; margin: 22rpx 28rpx 18rpx; padding: 17rpx 18rpx; border-radius: 9rpx; background: #fff4e4; color: #5c5146; font-size: 24rpx; }
.member-mark { margin-right: 10rpx; padding: 4rpx 8rpx; border-radius: 5rpx; background: #4e5363; color: #fff; font-size: 19rpx; }.member-save { margin-left: 6rpx; color: #956b28; font-size: 30rpx; font-weight: 700; }.member-link { color: #916d31; font-weight: 700; }
.title-share-row { display: flex; align-items: flex-start; gap: 16rpx; }.product-title { flex: 1; font-size: 31rpx; font-weight: 700; line-height: 1.45; }.share-button { width: 74rpx; flex: none; display: flex; flex-direction: column; align-items: center; padding: 0; background: transparent; color: #555; font-size: 20rpx; line-height: 1.2; }.share-icon { font-size: 38rpx; font-weight: 700; }
.product-sub { margin-top: 9rpx; color: #777; font-size: 23rpx; line-height: 1.55; }.rank-label { display: inline-flex; margin-top: 11rpx; padding: 6rpx 13rpx; border-radius: 6rpx; background: #fff4df; color: #bd8c36; font-size: 20rpx; }
.info-row { display: flex; align-items: center; margin-top: 26rpx; padding: 24rpx 28rpx; border-top: 14rpx solid #f7f7f7; border-bottom: 14rpx solid #f7f7f7; }.info-label { width: 76rpx; color: #999; }.info-value { flex: 1; color: #555; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.row-arrow { color: #aaa; font-size: 40rpx; }
.section-card { padding: 28rpx; border-bottom: 14rpx solid #f7f7f7; }.section-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; font-size: 27rpx; font-weight: 700; }.muted-link { color: #aaa; font-size: 23rpx; font-weight: 400; }
.buyer-row { display: flex; align-items: center; padding: 10rpx 0; }.buyer-avatar { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f3f3f3; font-size: 28rpx; }.buyer-name { width: 110rpx; margin-left: 12rpx; font-size: 23rpx; }.buyer-time { flex: 1; color: #aaa; font-size: 22rpx; }.buyer-go { padding: 9rpx 24rpx; border-radius: 999rpx; background: #c9aa65; color: #fff; font-size: 22rpx; }
.review { display: flex; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid #eee; }.first-review { padding-bottom: 4rpx; border-bottom: 0; }.review-avatar { flex: none; width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f3eee5; }.review-name { font-size: 24rpx; font-weight: 700; }.review-text { margin-top: 7rpx; color: #555; font-size: 25rpx; line-height: 1.55; }.review-time { margin-top: 8rpx; color: #aaa; font-size: 20rpx; }
.merchant-card { display: flex; align-items: center; margin: 0; padding: 28rpx; border-bottom: 14rpx solid #f7f7f7; }.merchant-logo { width: 74rpx; height: 74rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(135deg,#ec6680,#72c9e5); color: #fff; font-size: 31rpx; font-weight: 700; }.merchant-copy { flex: 1; margin-left: 18rpx; }.merchant-name { font-size: 29rpx; font-weight: 700; }.merchant-cert { display: inline-flex; margin-top: 7rpx; padding: 3rpx 8rpx; border-radius: 4rpx; background: #ef3340; color: #fff; font-size: 18rpx; }.merchant-enter { padding: 9rpx 17rpx; border: 1rpx solid #c9aa65; border-radius: 999rpx; background: #fff; color: #b18d43; font-size: 22rpx; }
.assistant-note { padding: 30rpx 28rpx 16rpx; color: #555; font-size: 25rpx; line-height: 1.65; }.product-copy { padding: 18rpx 28rpx 30rpx; }.copy-title { margin-bottom: 28rpx; font-size: 30rpx; font-weight: 700; }.copy-paragraph { margin-top: 20rpx; color: #444; font-size: 27rpx; line-height: 1.8; }
.review-panel, .detail-rich, .recommend-panel { padding: 30rpx 28rpx 60rpx; box-sizing: border-box; }.panel-heading { margin-bottom: 24rpx; font-size: 29rpx; font-weight: 700; }.line-heading { display: flex; align-items: center; justify-content: center; color: #444; }.line-heading::before,.line-heading::after { content: ''; width: 110rpx; height: 1rpx; margin: 0 18rpx; background: #e3e3e3; }
.detail-rich .merchant-card { margin: 0 -28rpx 30rpx; }.detail-text { display: block; margin: 25rpx 0; color: #3e3e3e; font-size: 28rpx; line-height: 1.85; white-space: pre-wrap; }.detail-media { position: relative; height: 430rpx; margin: 24rpx 0; overflow: hidden; border-radius: 16rpx; background: #eee; }.detail-media image,.detail-video-player { width: 100%; height: 100%; }.detail-media > text { position: absolute; left: 20rpx; bottom: 18rpx; padding: 7rpx 14rpx; border-radius: 999rpx; background: rgba(0,0,0,.48); color: #fff; font-size: 21rpx; }.video-placeholder { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #777; }.video-play { width: 80rpx; height: 80rpx; margin-bottom: 14rpx; border-radius: 50%; background: #c9aa65; color: #fff; text-align: center; line-height: 80rpx; text-indent: 5rpx; font-size: 32rpx; }
.recommend-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.recommend-card { min-width: 0; overflow: hidden; border-radius: 14rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.06); }.recommend-cover { width: 100%; height: 300rpx; background: #eee; }.recommend-title { height: 78rpx; padding: 14rpx 14rpx 0; font-size: 25rpx; line-height: 1.45; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }.recommend-rank { padding: 5rpx 14rpx 0; color: #c19d51; font-size: 20rpx; }.recommend-price { padding: 10rpx 14rpx 18rpx; color: #c2a25b; font-size: 30rpx; }.empty-review { padding: 70rpx 0; color: #aaa; text-align: center; }
.product-bottom { z-index: 100; display: flex; align-items: center; gap: 3rpx; height: 116rpx; padding: 10rpx 18rpx calc(10rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.98); border-top: 1rpx solid #eee; }.bottom-icon { width: 78rpx; display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 0; background: transparent; color: #555; font-size: 19rpx; }.bottom-icon text:first-child { font-size: 36rpx; line-height: 1; }.bottom-icon[disabled] { opacity: .35; }.buy-actions { flex: 1; display: flex; height: 82rpx; margin-left: 7rpx; overflow: hidden; border-radius: 999rpx; }.add-cart,.buy-now { flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 0; font-size: 27rpx; font-weight: 700; }.add-cart { background: #f7f1e5; color: #c09d53; }.buy-now { background: #c8a75d; color: #fff; }
.sheet-mask { position: fixed; inset: 0; z-index: 200; display: flex; align-items: flex-end; background: rgba(20,22,26,.45); }.sheet { width: 100%; padding: 28rpx 30rpx 46rpx; border-radius: 38rpx 38rpx 0 0; background: #fff; box-sizing: border-box; }.sheet-head { display: flex; align-items: center; justify-content: space-between; }.sheet-title { font-size: 34rpx; font-weight: 700; }.close { width: 64rpx; height: 64rpx; background: transparent; color: #888; font-size: 42rpx; }.sku-summary { display: flex; align-items: center; gap: 18rpx; margin: 24rpx 0; }.sku-cover-image { width: 132rpx; height: 132rpx; border-radius: 16rpx; background: #eee; }.sku-price { color: #c39f51; font-size: 42rpx; font-weight: 700; }.sku-title { max-width: 500rpx; margin-top: 5rpx; color: #777; font-size: 23rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.sku-options { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 26rpx; }.sku-option { position: relative; min-width: 200rpx; padding: 19rpx; border: 2rpx solid #e3e3e3; border-radius: 14rpx; }.sku-option.selected { border-color: #c8a75d; background: #fff9ee; }.sku-name { display: block; font-size: 24rpx; font-weight: 700; }.sku-price-sm { color: #b99345; font-size: 27rpx; }.hot { position: absolute; right: -2rpx; top: -2rpx; padding: 3rpx 8rpx; border-radius: 0 12rpx 0 12rpx; background: #c8a75d; color: #fff; font-size: 17rpx; }.sheet-confirm { width: 100%; padding: 20rpx; border-radius: 999rpx; background: #c8a75d; color: #fff; font-size: 29rpx; font-weight: 700; }

.venue-card .venue-row { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 12rpx; padding: 20rpx 18rpx; border: 2rpx solid #eee; border-radius: 12rpx; background: #fcfcfc; }
.venue-card .venue-row.active { border-color: #c8a75d; background: #fff9ee; }
.venue-pin { font-size: 26rpx; line-height: 1.4; }
.venue-info { flex: 1; min-width: 0; }
.venue-name { color: #333; font-size: 26rpx; font-weight: 700; }
.venue-address { margin-top: 6rpx; color: #888; font-size: 23rpx; line-height: 1.5; }
.venue-picked { flex: none; color: #c8a75d; font-size: 22rpx; font-weight: 700; }
.sku-options.stacked { flex-direction: column; }
.sku-options.stacked .sku-option { width: 100%; min-width: 0; box-sizing: border-box; }
.sku-option-addr { display: block; margin: 8rpx 0; color: #8a8a8a; font-size: 21rpx; line-height: 1.5; }
.sheet-venue { display: flex; align-items: flex-start; gap: 10rpx; margin-bottom: 24rpx; padding: 18rpx 20rpx; border-radius: 12rpx; background: #fff9ee; }
.sheet-venue-pin { font-size: 26rpx; }
.sheet-venue-body { flex: 1; min-width: 0; }
.sheet-venue-label { color: #b99345; font-size: 21rpx; font-weight: 700; }
.sheet-venue-text { margin-top: 5rpx; color: #555; font-size: 24rpx; line-height: 1.5; }
