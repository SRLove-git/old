<view wx:if="{{activity}}" class="detail-page">
  <swiper class="product-gallery" indicator-dots="{{true}}" circular="{{true}}" indicator-color="rgba(255,255,255,.55)" indicator-active-color="#ffffff">
    <swiper-item wx:for="{{activity.images}}" wx:key="id" wx:for-item="img">
      <view class="gallery-slide"><image class="gallery-image" src="{{img.src}}" mode="aspectFill" /><view class="gallery-shade"></view><view class="gallery-brand">岁悦里俱乐部</view><view class="gallery-count">{{index + 1}}/{{activity.images.length}}</view></view>
    </swiper-item>
  </swiper>

  <view class="detail-tabs">
    <view class="detail-tab {{tab === 'product' ? 'active' : ''}}" data-tab="product" bindtap="toggleTab">商品</view>
    <view class="detail-tab {{tab === 'review' ? 'active' : ''}}" data-tab="review" bindtap="toggleTab">评价</view>
    <view class="detail-tab {{tab === 'detail' ? 'active' : ''}}" data-tab="detail" bindtap="toggleTab">详情</view>
    <view class="detail-tab {{tab === 'recommend' ? 'active' : ''}}" data-tab="recommend" bindtap="toggleTab">推荐</view>
  </view>

  <view wx:if="{{tab === 'product'}}" class="tab-panel product-panel">
    <view class="price-line"><text class="currency">¥</text><text class="price">{{activity.memberPrice}}</text><text wx:if="{{activity.originalPrice > activity.memberPrice}}" class="original">¥{{activity.originalPrice}}</text></view>
    <view class="member-banner" bindtap="goProfile"><view><text class="member-mark">会员</text><text>入会得优惠券，本单再减</text><text class="member-save">¥{{memberSaving}}</text></view><text class="member-link">立即入会 ›</text></view>
    <view class="title-share-row"><view class="product-title">{{activity.title}}</view><button class="share-button" open-type="share"><text class="share-icon">↗</text><text>分享</text></button></view>
    <view class="product-sub"><text>{{activity.regionText}}</text><text wx:if="{{activity.time}}"> · {{activity.time}}</text></view>
    <view wx:if="{{rankLabel}}" class="rank-label">{{rankLabel}}</view>
    <view class="info-row" bindtap="showService"><text class="info-label">服务</text><text class="info-value">{{serviceText}}</text><text class="row-arrow">›</text></view>

    <view class="section-card buyers-card">
      <view class="section-title-row"><text>{{activity.soldCount || activity.buyers.length}}人已购买</text><text class="muted-link">查看全部 ›</text></view>
      <view wx:for="{{activity.buyers}}" wx:key="time" class="buyer-row"><text class="buyer-avatar">{{item.avatar}}</text><text class="buyer-name">{{item.name}}</text><text class="buyer-time">{{item.time}} 买了1件</text><button class="buyer-go" catchtap="openSku">去下单</button></view>
    </view>

    <view class="section-card review-preview">
      <view class="section-title-row"><text>商品评价</text><text class="muted-link">{{reviews.length ? reviews.length + '条评价' : '暂无评价'}}</text></view>
      <view wx:if="{{reviews.length}}" class="review first-review"><text class="review-avatar">👵</text><view><view class="review-name">{{reviews[0].name}}</view><view class="review-text">{{reviews[0].content}}</view><view class="review-time">{{reviews[0].time}}</view></view></view>
    </view>

    <view wx:if="{{merchant}}" class="merchant-card" bindtap="goShop"><view class="merchant-logo">岁</view><view class="merchant-copy"><view class="merchant-name">{{merchant.shopName || merchant.name}}</view><view class="merchant-cert">企业认证</view></view><button class="merchant-enter">进店逛逛</button></view>
    <view class="assistant-note">报名或购买成功后，请添加客服小助理微信：{{assistant.wechat}}</view>
    <view class="product-copy"><view class="copy-title">{{activity.highlight}}</view><view wx:for="{{activity.points}}" wx:key="*this" class="copy-paragraph">{{item}}</view></view>
  </view>

  <view wx:elif="{{tab === 'review'}}" class="tab-panel review-panel">
    <view class="panel-heading">商品评价</view>
    <view wx:for="{{reviews}}" wx:key="id" class="review"><text class="review-avatar">👵</text><view><view class="review-name">{{item.name}}</view><view class="review-text">{{item.content}}</view><view class="review-time">{{item.time}}</view></view></view>
    <view wx:if="{{reviews.length === 0}}" class="empty-review">暂无评价，购买后欢迎分享体验</view>
  </view>

  <view wx:elif="{{tab === 'detail'}}" class="tab-panel detail-rich">
    <view class="panel-heading line-heading">商品详情</view>
    <view wx:if="{{merchant}}" class="merchant-card" bindtap="goShop"><view class="merchant-logo">岁</view><view class="merchant-copy"><view class="merchant-name">{{merchant.shopName || merchant.name}}</view><view class="merchant-cert">企业认证</view></view><button class="merchant-enter">进店逛逛</button></view>
    <block wx:for="{{activity.detailBlocks}}" wx:key="_key" wx:for-item="block">
      <text wx:if="{{block.type === 'text'}}" class="detail-text">{{block.text}}</text>
      <view wx:elif="{{block.type === 'image'}}" class="detail-media"><image src="{{block.src || activity.art}}" mode="aspectFill" /><text>{{block.caption}}</text></view>
      <view wx:elif="{{block.type === 'video'}}" class="detail-media detail-video"><video wx:if="{{block.url}}" src="{{block.url}}" class="detail-video-player" controls></video><view wx:else class="video-placeholder"><text class="video-play">▶</text><text>{{block.caption}}</text></view></view>
    </block>
  </view>

  <view wx:else class="tab-panel recommend-panel">
    <view class="panel-heading line-heading">推荐商品</view>
    <view class="recommend-grid"><view wx:for="{{recommend}}" wx:key="id" class="recommend-card" data-id="{{item.id}}" bindtap="goDetailFromRec"><image class="recommend-cover" src="{{item.art}}" mode="aspectFill" /><view class="recommend-title">{{item.title}}</view><view wx:if="{{item.rankLabel}}" class="recommend-rank">{{item.rankLabel}}</view><view class="recommend-price">¥{{item.memberPrice}}</view></view></view>
    <view wx:if="{{recommend.length === 0}}" class="empty-review">暂无相关推荐</view>
  </view>

  <view class="fixed-bottom product-bottom">
    <button class="bottom-icon" bindtap="showService"><text>◌</text><text>客服</text></button>
    <button class="bottom-icon" bindtap="goShop" disabled="{{!merchant}}"><text>⌂</text><text>店铺</text></button>
    <button class="bottom-icon" bindtap="goCart"><text>▢</text><text>购物车</text></button>
    <view class="buy-actions"><button class="add-cart" bindtap="addToCart">加入购物车</button><button class="buy-now" bindtap="openSku">{{buyNowText}}</button></view>
  </view>

  <view wx:if="{{skuOpen}}" class="sheet-mask" bindtap="closeSku">
    <view class="sheet" catchtap="noop"><view class="sheet-head"><text class="sheet-title">{{activity.sellType === 'sku' ? '请选择规格' : '确认购买'}}</text><button class="close" bindtap="closeSku">×</button></view><view class="sku-summary"><image class="sku-cover-image" src="{{activity.art}}" mode="aspectFill" /><view><view class="sku-price">¥{{selectedSku ? selectedSku.memberPrice : activity.memberPrice}}</view><view class="sku-title">{{activity.title}}</view></view></view><view wx:if="{{activity.skus.length}}" class="sku-options"><view wx:for="{{activity.skus}}" wx:key="id" class="sku-option {{selectedSkuId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectSku"><text class="sku-name">{{item.name}}</text><text class="sku-price-sm">¥{{item.memberPrice}}</text><text wx:if="{{item.hot}}" class="hot">热销</text></view></view><button class="sheet-confirm" bindtap="confirmSku">{{cartIntent ? '加入购物车' : '下一步'}}</button></view>
  </view>
</view>
