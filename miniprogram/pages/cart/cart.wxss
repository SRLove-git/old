.cart-page { min-height: 100vh; padding: 22rpx 22rpx 160rpx; background: #f7f6f3; }
.cart-list { display: flex; flex-direction: column; gap: 18rpx; }
.cart-item { display: flex; align-items: center; padding: 22rpx; border-radius: 24rpx; background: #fff; }
.check { flex-shrink: 0; width: 38rpx; height: 38rpx; border: 2rpx solid #bbb8b2; border-radius: 50%; color: #fff; text-align: center; line-height: 38rpx; font-size: 23rpx; }
.check.active { border-color: #293633; background: #293633; }
.cart-cover { position: relative; flex-shrink: 0; width: 156rpx; height: 156rpx; margin-left: 16rpx; overflow: hidden; border-radius: 19rpx; background: #eee; }
.cart-cover image, .emoji-cover { width: 100%; height: 100%; } .emoji-cover { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 58rpx; }
.kind-label { position: absolute; left: 8rpx; top: 8rpx; padding: 4rpx 9rpx; border-radius: 999rpx; background: rgba(35,45,42,.75); color: #fff; font-size: 17rpx; }
.cart-info { position: relative; flex: 1; min-width: 0; min-height: 156rpx; margin-left: 18rpx; padding-right: 4rpx; }
.cart-title { padding-right: 58rpx; color: #303734; font-size: 27rpx; font-weight: 700; line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.cart-spec { margin-top: 8rpx; color: #929794; font-size: 20rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cart-foot { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; }
.price-symbol { color: var(--color-primary); font-size: 21rpx; } .price { color: var(--color-primary); font-size: 31rpx; font-weight: 700; }
.stepper { display: flex; align-items: center; overflow: hidden; border: 1rpx solid #dfdcd6; border-radius: 999rpx; }
.stepper button { width: 46rpx; height: 42rpx; color: #4b524f; line-height: 42rpx; font-size: 25rpx; } .stepper text { width: 42rpx; text-align: center; font-size: 22rpx; }
.course-count { color: #858b88; font-size: 22rpx; }
.remove { position: absolute; right: 0; top: 0; color: #aaa; font-size: 20rpx; }
.settlement-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 80; display: flex; align-items: center; min-height: 112rpx; padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e7e3dd; background: #fff; }
.select-all { display: flex; align-items: center; gap: 9rpx; color: #5d6461; font-size: 23rpx; }
.total { flex: 1; display: flex; align-items: baseline; justify-content: flex-end; margin-right: 18rpx; font-size: 22rpx; }
.total-price { color: var(--color-primary); font-size: 35rpx; font-weight: 700; } .total-note { display: none; }
.checkout { width: 210rpx; height: 76rpx; border-radius: 999rpx; background: #293633; color: #fff; line-height: 76rpx; font-size: 25rpx; font-weight: 700; }
.empty-cart { padding: 160rpx 30rpx; text-align: center; } .empty-icon { margin: auto; width: 100rpx; height: 100rpx; border-radius: 50%; background: #efe9df; color: #a47c50; font-size: 42rpx; line-height: 100rpx; }
.empty-title { margin-top: 24rpx; color: #353c39; font-size: 31rpx; font-weight: 700; } .empty-sub { margin-top: 9rpx; color: #959a97; font-size: 23rpx; }
.empty-cart button { display: inline-flex; margin-top: 28rpx; padding: 14rpx 30rpx; border-radius: 999rpx; background: #293633; color: #fff; font-size: 24rpx; }
