.booking-page {
  min-height: 100vh;
  padding-bottom: 170rpx;
}

.steps {
  display: flex;
  background: #ffffff;
  padding: 22rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.step {
  flex: 1;
  text-align: center;
  color: var(--color-text-3);
  font-size: 26rpx;
  font-weight: 700;
  padding: 14rpx;
  border-radius: 999rpx;
  background: var(--color-fill);
}

.step.active {
  background: var(--color-primary);
  color: #ffffff;
}

.booking-summary {
  display: flex;
  padding: 26rpx;
  background: #ffffff;
  align-items: center;
}

.booking-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
}

.booking-title {
  font-size: 30rpx;
  font-weight: 700;
}

.booking-sku {
  color: var(--color-text-3);
  font-size: 26rpx;
  margin-top: 6rpx;
}

.page-pad {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.panel {
  background: #ffffff;
  margin-top: 20rpx;
  padding-top: 28rpx;
  padding-bottom: 32rpx;
}

.panel-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
}

.schedule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.schedule-item.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.schedule-item.disabled {
  opacity: 0.5;
}

.schedule-date {
  font-size: 34rpx;
  font-weight: 700;
}

.schedule-time {
  color: var(--color-text-3);
  margin-top: 6rpx;
}

.sku-options {
  display: flex;
  margin-bottom: 28rpx;
}

.sku-option {
  flex: 1;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 22rpx;
  margin-right: 16rpx;
  position: relative;
}

.sku-option:last-child {
  margin-right: 0;
}

.sku-option.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.sku-name {
  display: block;
  font-weight: 700;
  font-size: 30rpx;
}

.sku-price-sm {
  color: var(--color-primary);
  font-weight: 700;
  font-size: 34rpx;
}

.hot {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 0 20rpx 0 20rpx;
}

.schedule-avatars {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.schedule-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-right: 6rpx;
}

.schedule-avatar-more {
  color: var(--color-text-3);
  font-size: 24rpx;
  margin-left: 4rpx;
}

.load-more {
  text-align: center;
  color: var(--color-primary);
  font-weight: 700;
  padding: 18rpx 0;
}

.schedule-right {
  display: flex;
  align-items: center;
}

.remain {
  color: var(--color-primary);
  font-weight: 700;
  font-size: 26rpx;
}

.check {
  width: 44rpx;
  height: 44rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  background: var(--color-border);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.schedule-item.selected .check {
  background: var(--color-primary);
}

.counter {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.counter-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-fill);
  font-size: 50rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.counter-value {
  min-width: 90rpx;
  margin: 0 18rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
}

.participant-quick {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 28rpx;
}

.participant-chip {
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  font-weight: 700;
}

.participant-chip.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.participant-chip.manage {
  color: var(--color-primary);
}

.required {
  color: var(--color-danger);
  margin-left: 4rpx;
}

.refund-note {
  background: var(--color-primary-light);
  border-radius: 18rpx;
  padding: 20rpx;
  color: var(--color-text-3);
  font-size: 26rpx;
  margin-top: 8rpx;
}

.address-card {
  position: relative;
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary-light-border);
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.address-line {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-1);
}

.address-line + .address-line {
  font-weight: 400;
  color: var(--color-text-3);
  margin-top: 8rpx;
}

.address-edit {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 700;
}

.confirm-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text-3);
}

.confirm-row text:last-child {
  color: var(--color-text-1);
  font-weight: 700;
  text-align: right;
}

.confirm-row.total {
  border-bottom: 0;
}

.red {
  color: var(--color-primary);
}

.detail-price {
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 700;
}

.coupon-chip {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 14rpx;
}

.coupon-chip.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.coupon-chip.used {
  opacity: 0.5;
}

.coupon-chip.disabled {
  opacity: 0.5;
}

.coupon-disabled {
  color: var(--color-danger);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.coupon-value {
  color: var(--color-primary);
  font-size: 42rpx;
  font-weight: 700;
  flex-shrink: 0;
  min-width: 120rpx;
  margin-right: 18rpx;
}

.coupon-info {
  display: flex;
  flex-direction: column;
}

.coupon-title {
  font-weight: 700;
}

.coupon-desc {
  color: var(--color-text-3);
  font-size: 26rpx;
}

.booking-bottom {
  display: flex;
  align-items: center;
}

.prev {
  width: 140rpx;
  color: var(--color-text-3);
  font-size: 30rpx;
}

.main-btn {
  flex: 1;
}

.pay-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.pay-amount {
  font-size: 60rpx;
  font-weight: 700;
  text-align: center;
  margin: 18rpx 0;
}

.pay-tip {
  text-align: center;
  color: var(--color-text-3);
  font-size: 26rpx;
  margin-bottom: 26rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.defer-btn {
  margin-top: 20rpx;
  color: var(--color-text-3);
  text-align: center;
  width: 100%;
  padding: 22rpx;
  font-size: 30rpx;
}

.member-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 28rpx 0 18rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.sku-options.stacked {
  flex-direction: column;
}

.sku-options.stacked .sku-option {
  margin-right: 0;
  margin-bottom: 16rpx;
}

.sku-options.stacked .sku-option:last-child {
  margin-bottom: 0;
}

.sku-option-addr {
  display: block;
  margin: 8rpx 0;
  color: var(--color-text-3);
  font-size: 22rpx;
  line-height: 1.5;
}

.venue-hint {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: var(--color-primary-light);
}

.venue-hint-pin {
  font-size: 28rpx;
}

.venue-hint-body {
  flex: 1;
  min-width: 0;
}

.venue-hint-label {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.venue-hint-text {
  margin-top: 6rpx;
  color: var(--color-text-1);
  font-size: 26rpx;
  line-height: 1.5;
}

.venue-strong {
  color: var(--color-primary) !important;
}
