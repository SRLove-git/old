.booking-page {
  min-height: 100vh;
  padding-bottom: 250rpx;
  background: #f7f5f1;
}

.steps {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 24rpx 36rpx 22rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.step {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 132rpx;
  text-align: center;
  color: var(--color-text-3);
  font-size: 22rpx;
  font-weight: 600;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dedbd5;
  border-radius: 50%;
  background: #f5f3ef;
  color: #97938c;
  font-size: 23rpx;
  font-weight: 800;
}

.step-line {
  flex: 1;
  height: 3rpx;
  margin: 0 -12rpx 34rpx;
  background: #e8e5df;
}

.step.active { color: var(--color-text-1); }
.step.active .step-dot,
.step.done .step-dot {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #ffffff;
}
.step-line.active { background: var(--color-primary); }

.booking-summary {
  display: flex;
  gap: 22rpx;
  margin: 20rpx 22rpx 0;
  padding: 20rpx;
  background: #ffffff;
  align-items: center;
  border: 1rpx solid rgba(123, 103, 82, 0.1);
  border-radius: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(80, 65, 49, 0.06);
}

.booking-cover {
  flex: none;
  width: 176rpx;
  height: 136rpx;
  border-radius: 18rpx;
  background: var(--color-fill);
}

.booking-summary-body {
  flex: 1;
  min-width: 0;
}

.booking-eyebrow {
  margin-bottom: 7rpx;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.booking-title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--color-text-1);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.booking-meta {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 9rpx;
  min-width: 0;
}

.booking-price {
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.booking-price-note,
.booking-address {
  color: var(--color-text-3);
  font-size: 20rpx;
}

.booking-address {
  flex: 1;
  overflow: hidden;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-sku {
  width: max-content;
  margin-top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 20rpx;
}

.page-pad {
  padding-left: 26rpx;
  padding-right: 26rpx;
}

.panel {
  background: #ffffff;
  margin: 18rpx 22rpx 0;
  padding-top: 30rpx;
  padding-bottom: 34rpx;
  border: 1rpx solid rgba(123, 103, 82, 0.09);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(80, 65, 49, 0.045);
}

.panel-title {
  color: var(--color-text-1);
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.panel-subtitle {
  color: var(--color-text-3);
  font-size: 23rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-count {
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: var(--color-fill);
  color: var(--color-text-3);
  font-size: 21rpx;
}

.schedule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid var(--color-border);
  border-radius: 22rpx;
  padding: 25rpx 22rpx;
  margin-bottom: 14rpx;
  background: #fff;
  transition: background .18s ease, border-color .18s ease;
}

.schedule-item.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.schedule-item.disabled {
  opacity: 0.5;
}

.schedule-date {
  color: var(--color-text-1);
  font-size: 32rpx;
  font-weight: 700;
}

.schedule-weekday {
  margin-left: 6rpx;
  color: var(--color-text-3);
  font-size: 24rpx;
  font-weight: 500;
}

.schedule-time {
  color: var(--color-text-3);
  margin-top: 6rpx;
}

.sku-options {
  display: flex;
  margin-bottom: 28rpx;
}

.sku-option {
  flex: 1;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 22rpx;
  margin-right: 16rpx;
  position: relative;
}

.sku-option:last-child {
  margin-right: 0;
}

.sku-option.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.sku-name {
  display: block;
  font-weight: 700;
  font-size: 30rpx;
}

.sku-price-sm {
  color: var(--color-primary);
  font-weight: 700;
  font-size: 34rpx;
}

.hot {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 0 20rpx 0 20rpx;
}

.schedule-avatars {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.schedule-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-right: 6rpx;
}

.schedule-avatar-more {
  color: var(--color-text-3);
  font-size: 24rpx;
  margin-left: 4rpx;
}

.load-more {
  text-align: center;
  color: var(--color-primary);
  font-weight: 700;
  padding: 18rpx 0;
}

.schedule-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.remain {
  color: var(--color-primary);
  font-weight: 700;
  font-size: 26rpx;
}

.check {
  width: 44rpx;
  height: 44rpx;
  margin-left: 0;
  border-radius: 50%;
  background: var(--color-border);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.schedule-item.selected .check {
  background: var(--color-primary);
}

.counter {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.counter-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-fill);
  font-size: 50rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.counter-value {
  min-width: 90rpx;
  margin: 0 18rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
}

.participant-quick {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 28rpx;
}

.participant-chip {
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  font-weight: 700;
}

.participant-chip.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.participant-chip.manage {
  color: var(--color-primary);
}

.required {
  color: var(--color-danger);
  margin-left: 4rpx;
}

.refund-note {
  background: var(--color-primary-light);
  border-radius: 18rpx;
  padding: 20rpx;
  color: var(--color-text-3);
  font-size: 26rpx;
  margin-top: 8rpx;
}

.address-card {
  position: relative;
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary-light-border);
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.address-line {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-1);
}

.address-line + .address-line {
  font-weight: 400;
  color: var(--color-text-3);
  margin-top: 8rpx;
}

.address-edit {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 700;
}

.confirm-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text-3);
}

.confirm-value {
  color: var(--color-text-1);
  font-weight: 700;
  text-align: right;
}

.confirm-row.total {
  border-bottom: 0;
}

.red {
  color: var(--color-primary);
}

.detail-price {
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 700;
}

.coupon-chip {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 14rpx;
}

.coupon-chip.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.coupon-chip.used {
  opacity: 0.5;
}

.coupon-chip.disabled {
  opacity: 0.5;
}

.coupon-disabled {
  color: var(--color-danger);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.coupon-value {
  color: var(--color-primary);
  font-size: 42rpx;
  font-weight: 700;
  flex-shrink: 0;
  min-width: 120rpx;
  margin-right: 18rpx;
}

.coupon-info {
  display: flex;
  flex-direction: column;
}

.coupon-title {
  font-weight: 700;
}

.coupon-desc {
  color: var(--color-text-3);
  font-size: 26rpx;
}

.booking-bottom {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(55, 46, 36, 0.08);
}

.bottom-content { width: 100%; }

.bottom-selection {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.bottom-label { color: var(--color-text-3); font-size: 22rpx; }
.bottom-value { flex: 1; overflow: hidden; color: var(--color-text-1); font-size: 24rpx; font-weight: 700; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.bottom-total { color: var(--color-primary); font-size: 34rpx; font-weight: 800; }
.bottom-actions { display: flex; align-items: center; gap: 14rpx; }

.bottom-actions .main-btn {
  min-height: 92rpx;
  border-radius: 22rpx;
}

.prev {
  width: 148rpx;
  min-height: 92rpx;
  margin: 0;
  border: 1rpx solid var(--color-border);
  border-radius: 22rpx;
  background: #fff;
  color: var(--color-text-3);
  font-size: 28rpx;
}

.main-btn {
  flex: 1;
}

.pay-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.pay-amount {
  font-size: 60rpx;
  font-weight: 700;
  text-align: center;
  margin: 18rpx 0;
}

.pay-tip {
  text-align: center;
  color: var(--color-text-3);
  font-size: 26rpx;
  margin-bottom: 26rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.address-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-picker.placeholder {
  color: var(--color-text-3);
}

.address-picker-arrow {
  margin-left: 20rpx;
  color: var(--color-text-3);
  font-size: 40rpx;
  line-height: 1;
}

.region-empty-tip {
  margin-top: 10rpx;
  color: var(--color-danger);
  font-size: 22rpx;
}

.defer-btn {
  margin-top: 20rpx;
  color: var(--color-text-3);
  text-align: center;
  width: 100%;
  padding: 22rpx;
  font-size: 30rpx;
}

.member-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 28rpx 0 18rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.sku-options.stacked {
  flex-direction: column;
}

.sku-options.stacked .sku-option {
  margin-right: 0;
  margin-bottom: 16rpx;
}

.sku-options.stacked .sku-option:last-child {
  margin-bottom: 0;
}

.sku-option-addr {
  display: block;
  margin: 8rpx 0;
  color: var(--color-text-3);
  font-size: 22rpx;
  line-height: 1.5;
}

.venue-hint {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: var(--color-primary-light);
}

.venue-hint-pin {
  font-size: 28rpx;
}

.venue-hint-body {
  flex: 1;
  min-width: 0;
}

.venue-hint-label {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.venue-hint-text {
  margin-top: 6rpx;
  color: var(--color-text-1);
  font-size: 26rpx;
  line-height: 1.5;
}

.venue-strong {
  color: var(--color-primary) !important;
}
.balance-pay-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff8f1;
}

.balance-pay-title { font-size: 28rpx; font-weight: 700; }
.balance-pay-tip { margin-top: 6rpx; color: var(--color-text-3); font-size: 22rpx; }
