<view class="booking-page">
  <view class="steps">
    <view class="step {{step >= 1 ? 'active' : ''}} {{step > 1 ? 'done' : ''}}"><view class="step-dot">{{step > 1 ? '✓' : '1'}}</view><text>{{isSkuOnly ? '选择规格' : '选择场次'}}</text></view>
    <view class="step-line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="step {{step >= 2 ? 'active' : ''}} {{step > 2 ? 'done' : ''}}"><view class="step-dot">{{step > 2 ? '✓' : '2'}}</view><text>填写信息</text></view>
    <view class="step-line {{step >= 3 ? 'active' : ''}}"></view>
    <view class="step {{step >= 3 ? 'active' : ''}}"><view class="step-dot">3</view><text>确认支付</text></view>
  </view>

  <view class="booking-summary">
    <image class="booking-cover" src="{{coverImageUrl}}" mode="aspectFill" />
    <view class="booking-summary-body">
      <view class="booking-eyebrow">{{categoryName}}<text wx:if="{{isGoods}}"> · 支持配送</text></view>
      <view class="booking-title">{{bookingTitle}}</view>
      <view class="booking-meta"><text class="booking-price">¥{{memberPrice}}</text><text class="booking-price-note">会员价</text><text wx:if="{{!isGoods && skuAddress}}" class="booking-address">{{skuAddress}}</text></view>
      <view wx:if="{{skuName}}" class="booking-sku">已选 {{skuName}}</view>
    </view>
  </view>

  <view wx:if="{{step === 1}}" class="panel page-pad">
    <block wx:if="{{isSkuOnly || activity.hasSku}}">
      <view class="panel-title">{{'请选择' + (activity.skuLabel || (isSkuOnly ? '规格' : '房型'))}}</view>
      <view class="sku-options {{hasVenue ? 'stacked' : ''}}">
        <view
          wx:for="{{activity.skus}}"
          wx:key="id"
          class="sku-option {{skuId === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectSku"
        >
          <text class="sku-name">{{item.name}}</text>
          <text wx:if="{{item.address}}" class="sku-option-addr">📍 {{item.address}}</text>
          <text class="sku-price-sm">¥{{item.memberPrice}}</text>
          <text wx:if="{{item.hot}}" class="hot">热销</text>
        </view>
      </view>
      <view wx:if="{{skuAddress}}" class="venue-hint">
        <text class="venue-hint-pin">📍</text>
        <view class="venue-hint-body"><view class="venue-hint-label">本次活动地址</view><view class="venue-hint-text">{{skuAddress}}</view></view>
      </view>
    </block>

    <block wx:if="{{!isSkuOnly}}">
      <view class="section-head"><view><view class="panel-title">请选择报名时间</view><view class="panel-subtitle">选择适合您的场次，余量实时更新</view></view><view class="section-count">{{visibleSchedules.length}} 个场次</view></view>
      <view
        wx:for="{{visibleSchedules}}"
        wx:key="id"
        class="schedule-item {{scheduleId === item.id ? 'selected' : ''}} {{item.remaining <= 0 ? 'disabled' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectSchedule"
      >
        <view>
          <view class="schedule-date">{{item.date}} <text class="schedule-weekday">{{item.weekday}}</text></view>
          <view class="schedule-time">{{item.time}}</view>
          <view class="schedule-avatars">
            <text wx:for="{{item.avatars}}" wx:for-item="avatar" wx:key="*this" class="schedule-avatar">{{avatar}}</text>
            <text class="schedule-avatar-more">已报名{{item.soldQuota}}人</text>
          </view>
        </view>
        <view class="schedule-right">
          <text class="remain">{{item.remaining > 0 ? '余' + item.remaining + '人' : '已满'}}</text>
          <text class="check">✓</text>
        </view>
      </view>
      <view wx:if="{{hasMore}}" class="load-more" bindtap="toggleMore">{{showAll ? '收起' : '加载更多日期'}}</view>
    </block>
  </view>

  <view wx:if="{{step === 2}}" class="panel page-pad">
    <view class="panel-title">{{isGoods ? '购买数量' : '报名人数'}}</view>
    <view class="counter">
      <button class="counter-btn" data-delta="-1" bindtap="changeCount">−</button>
      <text class="counter-value">{{count}}</text>
      <button class="counter-btn" data-delta="1" bindtap="changeCount">＋</button>
    </view>

    <block wx:if="{{isGoods}}">
      <view class="panel-title">收货地址</view>
      <view wx:if="{{address}}" class="address-card" bindtap="openAddress">
        <view class="address-line">{{address.name}} {{address.phone}}</view>
        <view class="address-line">{{address.district}} {{address.detail}}</view>
        <text class="address-edit">修改 ›</text>
      </view>
      <button wx:else class="btn btn-secondary btn-block" bindtap="openAddress">添加收货地址</button>
    </block>

    <block wx:else>
      <view class="panel-title">报名人信息</view>
      <view class="participant-quick">
        <view
          wx:for="{{participants}}"
          wx:key="id"
          class="participant-chip {{item.selected ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectParticipant"
        >{{item.name}}</view>
        <view class="participant-chip manage" data-id="manage" bindtap="selectParticipant">＋ 管理</view>
      </view>

      <view class="field">
        <text class="field-label">姓名<text class="required">*</text></text>
        <input class="field-input" value="{{info.name}}" data-field="name" bindinput="onInput" placeholder="请输入真实姓名" />
      </view>
      <view class="field">
        <text class="field-label">联系电话<text class="required">*</text></text>
        <input class="field-input" value="{{info.phone}}" data-field="phone" bindinput="onInput" placeholder="用于接收活动通知" />
      </view>
      <view wx:if="{{needIdCard}}" class="field">
        <text class="field-label">身份证号<text class="required">*</text></text>
        <input class="field-input" value="{{info.idCard}}" data-field="idCard" bindinput="onInput" placeholder="用于购买旅游意外险" />
      </view>
      <view wx:if="{{needDiscount}}" class="field">
        <text class="field-label">优待证<text class="required">*</text></text>
        <input class="field-input" value="{{info.discount}}" data-field="discount" bindinput="onInput" placeholder="有优待证可享门票优惠" />
      </view>

      <block wx:for="{{memberList}}" wx:key="index">
        <view class="member-title">第{{index + 2}}位报名人</view>
        <view class="field">
          <text class="field-label">姓名<text class="required">*</text></text>
          <input class="field-input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onMemberInput" placeholder="请输入真实姓名" />
        </view>
        <view wx:if="{{needIdCard}}" class="field">
          <text class="field-label">身份证号<text class="required">*</text></text>
          <input class="field-input" value="{{item.idCard}}" data-index="{{index}}" data-field="idCard" bindinput="onMemberInput" placeholder="用于购买旅游意外险" />
        </view>
      </block>
    </block>

    <view class="refund-note">退改规则：{{refundText}}</view>
  </view>

  <view wx:if="{{step === 3}}" class="panel page-pad">
    <view class="panel-title">确认订单</view>
    <view wx:if="{{skuName}}" class="confirm-row"><text>{{activity.skuLabel || '规格'}}</text><text class="confirm-value">{{skuName}}</text></view>
    <view wx:if="{{!isSkuOnly && selectedSchedule}}" class="confirm-row"><text>活动时间</text><text class="confirm-value">{{selectedSchedule.date}} {{selectedSchedule.weekday}} {{selectedSchedule.time}}</text></view>
    <view wx:if="{{skuAddress}}" class="confirm-row"><text>活动地址</text><text class="confirm-value venue-strong">{{skuAddress}}</text></view>
    <view class="confirm-row"><text>{{isGoods ? '购买数量' : '报名人数'}}</text><text class="confirm-value">{{count}}{{isGoods ? '件' : '人'}}</text></view>
    <view class="confirm-row"><text>{{isGoods ? '收货人' : '报名人'}}</text><text class="confirm-value">{{isGoods ? address.name : info.name}}</text></view>
    <view wx:if="{{isGoods}}" class="confirm-row"><text>收货地址</text><text class="confirm-value">{{address.district}} {{address.detail}}</text></view>
    <view class="confirm-row"><text>会员价</text><text class="confirm-value">¥{{memberPrice}} × {{count}}</text></view>
    <view class="panel-title">优惠券</view>
    <view wx:for="{{couponList}}" wx:key="id" class="coupon-chip {{couponId === item.id ? 'selected' : ''}} {{item.used || !item.usable ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="selectCoupon">
      <text class="coupon-value">¥{{item.value}}</text>
      <view class="coupon-info">
        <text class="coupon-title">{{item.title}}</text>
        <text class="coupon-desc">{{item.desc}}</text>
        <text wx:if="{{!item.usable}}" class="coupon-disabled">不适用</text>
      </view>
    </view>
    <view class="coupon-chip {{couponId === null ? 'selected' : ''}}" data-id="" bindtap="selectCoupon">
      <text class="coupon-value">不用</text>
      <view class="coupon-info"><text class="coupon-title">不使用优惠券</text></view>
    </view>
    <view class="confirm-row"><text>优惠</text><text class="confirm-value red">-¥{{discount}}</text></view>
    <view class="balance-pay-row">
      <view><view class="balance-pay-title">使用账户余额</view><view class="balance-pay-tip">可用 ¥{{balance}}，本单最多抵扣 ¥{{balance > total ? total : balance}}</view></view>
      <switch checked="{{useBalance}}" color="#b98555" bindchange="toggleBalance" />
    </view>
    <view wx:if="{{useBalance}}" class="confirm-row"><text>余额抵扣</text><text class="confirm-value red">-¥{{balanceDeduction}}</text></view>
    <view class="confirm-row total"><text>合计</text><text class="confirm-value detail-price">¥{{total}}</text></view>
    <view wx:if="{{useBalance}}" class="confirm-row total"><text>还需微信支付</text><text class="confirm-value detail-price">¥{{wechatAmount}}</text></view>
  </view>

  <view class="fixed-bottom booking-bottom">
    <view class="bottom-content">
      <view wx:if="{{step === 1}}" class="bottom-selection"><text class="bottom-label">当前选择</text><text class="bottom-value">{{isSkuOnly ? (skuName || '请选择规格') : (selectedSchedule ? selectedSchedule.date + ' ' + selectedSchedule.time : '请选择活动场次')}}</text></view>
      <view wx:elif="{{step === 2}}" class="bottom-selection"><text class="bottom-label">报名人数</text><text class="bottom-value">{{count}}人 · ¥{{memberPrice * count}}</text></view>
      <view wx:else class="bottom-selection"><text class="bottom-label">应付金额</text><text class="bottom-total">¥{{total}}</text></view>
      <view class="bottom-actions"><button wx:if="{{step > 1}}" class="prev" bindtap="prevStep">上一步</button><button class="btn btn-primary main-btn" bindtap="nextStep">{{step === 3 ? '确认支付' : '下一步'}}</button></view>
    </view>
  </view>

  <view wx:if="{{payOpen}}" class="mask" bindtap="closePay">
    <view class="sheet" catchtap="noop">
      <view class="pay-title">确认支付</view>
      <view class="pay-amount">¥{{useBalance ? wechatAmount : total}}</view>
      <view wx:if="{{useBalance}}" class="pay-tip">余额抵扣 ¥{{balanceDeduction}}，{{wechatAmount > 0 ? '剩余部分使用微信支付' : '无需微信支付'}}</view>
      <view wx:else class="pay-tip">支付后名额立即锁定，30分钟内有效</view>
      <button class="btn btn-wechat btn-block" loading="{{submittingPayment}}" disabled="{{submittingPayment}}" bindtap="confirmPay">{{wechatAmount === 0 && useBalance ? '余额支付' : '确认支付'}}</button>
      <button class="defer-btn" disabled="{{submittingPayment}}" bindtap="deferPay">稍后支付（30分钟内有效）</button>
    </view>
  </view>

  <view wx:if="{{addressOpen}}" class="mask" bindtap="closeAddress">
    <view class="sheet" catchtap="noop">
      <view class="modal-title">收货地址</view>
      <view class="field">
        <text class="field-label">收货人<text class="required">*</text></text>
        <input class="field-input" value="{{addressForm.name}}" data-field="name" bindinput="onAddressInput" placeholder="姓名" />
      </view>
      <view class="field">
        <text class="field-label">手机号<text class="required">*</text></text>
        <input class="field-input" value="{{addressForm.phone}}" data-field="phone" bindinput="onAddressInput" placeholder="联系电话" />
      </view>
      <view class="field">
        <text class="field-label">配送地区<text class="required">*</text></text>
        <picker mode="multiSelector" range="{{regionPickerColumns}}" range-key="label" value="{{regionPickerIndexes}}" bindcolumnchange="onAddressRegionColumnChange" bindchange="onAddressRegionChange" disabled="{{regionOptions.length === 0}}">
          <view class="field-input address-picker {{addressForm.regionText ? '' : 'placeholder'}}"><text>{{addressForm.regionText || '请选择省、市、区/县'}}</text><text class="address-picker-arrow">›</text></view>
        </picker>
        <view wx:if="{{regionOptions.length === 0}}" class="region-empty-tip">后台暂未配置可用配送地区</view>
      </view>
      <view class="field">
        <text class="field-label">详细地址<text class="required">*</text></text>
        <input class="field-input" value="{{addressForm.detail}}" data-field="detail" bindinput="onAddressInput" placeholder="街道、门牌号等" />
      </view>
      <button class="btn btn-primary btn-block" bindtap="saveAddressNow">保存地址</button>
    </view>
  </view>
  <contact-sheet visible="{{serviceOpen}}" bindclose="closeService" />
</view>
