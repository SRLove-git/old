<view class="page {{largeMode ? 'large-mode' : ''}}">
  <view class="head">
    <view class="title">私域直播</view>
    <view class="sub">直播、预告、回放，不错过每一场</view>
  </view>

  <view wx:if="{{list.length > 0}}" class="live-list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="live-card card"
      data-id="{{item.id}}"
      bindtap="goRoom"
    >
      <view class="live-cover" style="background: {{item.coverTone}}">
        <text class="live-cover-emoji">{{item.cover}}</text>
        <text class="live-badge {{item.statusCls}}">{{item.statusLabel}}</text>
        <text wx:if="{{item.managerId}}" class="private-badge">私域</text>
      </view>
      <view class="live-body">
        <view class="live-title">{{item.title}}</view>
        <view class="live-host">🧑‍🏫 {{item.hostName}}</view>
        <view class="live-time">🕒 {{item.startAt}} - {{item.endAt}}</view>
        <view class="live-foot">
          <text class="live-viewers">👀 {{item.viewers}} 人观看</text>
          <text class="live-arrow">进入 ›</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="empty-emoji">📺</view>
    <view class="empty-title">暂无直播</view>
    <view class="empty-sub">稍后再来看看吧</view>
  </view>
</view>
