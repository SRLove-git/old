.home-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.region-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 34, 45, 0.06);
}

.region-icon {
  font-size: 34rpx;
  margin-right: 10rpx;
}

.region-city {
  font-size: 36rpx;
  font-weight: 700;
  color: #24272b;
}

.region-arrow {
  color: #c25e3d;
  font-size: 30rpx;
  margin-left: 8rpx;
}

.region-tip {
  margin-left: auto;
  color: #6f747b;
  font-size: 26rpx;
}

.banner-swiper {
  height: 220rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
}

.banner-item {
  height: 220rpx;
  border-radius: 24rpx;
  padding: 32rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #ffffff;
}

.banner-text-title {
  font-size: 36rpx;
  font-weight: 700;
}

.banner-text-sub {
  font-size: 26rpx;
  opacity: 0.92;
  margin-top: 10rpx;
}

.banner-emoji {
  font-size: 96rpx;
}

.brand {
  font-size: 46rpx;
  font-weight: 700;
  color: #9e4428;
}

.slogan {
  color: #6f747b;
  font-size: 26rpx;
  margin-top: 4rpx;
}

.badge {
  background: #fdeee9;
  color: #9e4428;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(26, 34, 45, 0.07);
  margin-bottom: 24rpx;
}

.search-placeholder {
  color: #6f747b;
  font-size: 32rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  grid-template-columns: repeat(5, 1fr);
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
}

.category-emoji {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
}

.category-name {
  font-size: 26rpx;
  font-weight: 700;
}

.member-card {
  background: #fff8f3;
  border: 2rpx solid #f6d6c8;
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 28rpx 0;
}

.member-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #9e4428;
}

.member-sub {
  color: #6f747b;
  font-size: 26rpx;
  margin-top: 6rpx;
}

.member-btn {
  background: #c25e3d;
  color: #ffffff;
  border-radius: 999rpx;
  padding: 22rpx 28rpx;
  font-weight: 700;
  font-size: 30rpx;
  white-space: nowrap;
}

.home-coupons {
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.home-coupons-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.home-coupons-list {
  display: flex;
}

.home-coupon {
  flex: 1;
  background: #fff8f3;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
}

.home-coupon:last-child {
  margin-right: 0;
}

.home-coupon-value {
  color: #c25e3d;
  font-size: 40rpx;
  font-weight: 700;
}

.home-coupon-name {
  color: #6f747b;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.activity-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 28rpx 0 18rpx;
}

.section-head .section-title {
  margin: 0;
}

.mode-toggle {
  display: flex;
  background: #f1f2f4;
  border-radius: 999rpx;
  padding: 4rpx;
}

.mode-item {
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #6f747b;
  border-radius: 999rpx;
}

.mode-item.on {
  background: #c25e3d;
  color: #ffffff;
}

.group-head {
  display: flex;
  align-items: center;
  margin: 24rpx 0 14rpx;
}

.group-emoji {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.group-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #24272b;
}

.activity-card {
  width: 48.5%;
  margin-bottom: 18rpx;
  overflow: hidden;
}

.cover {
  position: relative;
  height: 190rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

.cover-emoji {
  font-size: 76rpx;
}

.sold,
.group {
  position: absolute;
  bottom: 18rpx;
  background: rgba(0, 0, 0, 0.35);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
  font-size: 20rpx;
}

.sold {
  left: 12rpx;
}

.group {
  right: 12rpx;
  background: rgba(194, 94, 61, 0.9);
}

.card-body {
  padding: 18rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.meta {
  color: #6f747b;
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.price {
  font-size: 32rpx;
}

.member-label {
  color: #6f747b;
  font-size: 22rpx;
  margin-left: 6rpx;
}

.go {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-height: 0;
  line-height: 1.2;
  background: #c25e3d;
  color: #ffffff;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  font-weight: 700;
  font-size: 22rpx;
}

.brand-footer {
  margin: 40rpx 0 20rpx;
  padding: 36rpx 28rpx;
  text-align: center;
}

.brand-logo {
  font-size: 42rpx;
  font-weight: 700;
  color: #9e4428;
}

.brand-slogan {
  color: #6f747b;
  margin-top: 10rpx;
}

.footer-btn {
  margin-top: 20rpx;
  background: #fff8f3;
  color: #9e4428;
  border-radius: 18rpx;
  padding: 22rpx;
  font-weight: 700;
}

.city-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 22, 26, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.city-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 30rpx 30rpx 50rpx;
}

.city-sheet-title {
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.city-list {
  margin-bottom: 20rpx;
}

.city-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 22rpx;
  border-bottom: 1rpx solid #e7e9ec;
  font-size: 34rpx;
  font-weight: 700;
}

.city-item.selected {
  color: #c25e3d;
  background: #fff8f3;
  border-radius: 18rpx;
}

.city-check {
  color: #c25e3d;
  font-size: 36rpx;
  font-weight: 700;
}
