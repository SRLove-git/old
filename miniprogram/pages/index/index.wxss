.home-page { min-height: 100vh; padding: 18rpx 0 180rpx; background: #fff; overflow: hidden; }
.home-tools { display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx 20rpx; }
.city-pill { display: flex; align-items: center; gap: 6rpx; height: 80rpx; padding: 0 20rpx; background: #f7f3ed; border-radius: 20rpx; color: var(--color-ink); font-size: 28rpx; font-weight: 700; white-space: nowrap; }
.pin { color: var(--color-primary); font-size: 34rpx; } .chevron { color: #999; }
.search-box { flex: 1; height: 80rpx; display: flex; align-items: center; padding: 0 24rpx; background: #f7f5f1; border-radius: 20rpx; color: #9a9f9d; }
.search-icon { font-size: 40rpx; margin-right: 12rpx; line-height: 1; transform: rotate(-15deg); } .search-placeholder { font-size: 28rpx; }
.hero { position: relative; height: 480rpx; margin: 0 24rpx; border-radius: 32rpx; overflow: hidden; background: #c6b096; }
.hero-image, .hero-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-shade { background: linear-gradient(90deg, rgba(33,42,39,.76) 0%, rgba(33,42,39,.3) 50%, rgba(33,42,39,.02) 75%); }
.hero-copy { position: absolute; left: 34rpx; top: 56rpx; width: 390rpx; color: #fff; }
.hero-kicker { display: inline-block; font-size: 22rpx; letter-spacing: 3rpx; padding-bottom: 12rpx; border-bottom: 2rpx solid rgba(255,255,255,.55); }
.hero-title { margin-top: 22rpx; font-size: 48rpx; font-weight: 700; line-height: 1.2; letter-spacing: 2rpx; }
.hero-title text { display: block; color: #f2c986; } .hero-sub { margin-top: 18rpx; font-size: 25rpx; line-height: 1.65; opacity: .92; }
.hero-action { display: inline-flex; align-items: center; margin-top: 24rpx; padding: 13rpx 22rpx; border-radius: 999rpx; background: rgba(255,255,255,.92); color: #55412f; font-size: 24rpx; font-weight: 700; }
.hero-action text { margin-left: 12rpx; color: var(--color-primary); }
.hero-dots { position: absolute; left: 34rpx; bottom: 24rpx; display: flex; gap: 9rpx; }
.hero-dots text { width: 9rpx; height: 9rpx; border-radius: 50%; background: rgba(255,255,255,.5); } .hero-dots text:first-child { width: 28rpx; border-radius: 6rpx; background: #fff; }
.home-content-section { margin-top: 34rpx; padding: 0 24rpx; }
.content-section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.content-section-title { color: var(--color-ink); font-size: 35rpx; font-weight: 700; }
.content-section-en { margin-top: 3rpx; color: #a0a5a2; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.official-badge { padding: 8rpx 15rpx; border-radius: 999rpx; background: #edf3f8; color: #4d718b; font-size: 20rpx; font-weight: 700; }
.policy-list { overflow: hidden; border: 1rpx solid #ece9e3; border-radius: 24rpx; background: #fff; }
.policy-card { display: flex; gap: 18rpx; padding: 18rpx; border-bottom: 1rpx solid #efede8; }
.policy-card:last-child { border-bottom: 0; }
.policy-cover { flex: none; width: 170rpx; height: 130rpx; border-radius: 16rpx; background: #eee; }
.policy-copy { min-width: 0; flex: 1; }
.policy-title { color: #29312f; font-size: 28rpx; font-weight: 700; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.policy-summary { margin-top: 6rpx; color: #7d8582; font-size: 21rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.policy-meta { display: flex; justify-content: space-between; gap: 10rpx; margin-top: 10rpx; color: #9da29f; font-size: 19rpx; }
.video-section { padding-right: 0; }
.video-section .content-section-head { padding-right: 24rpx; }
.video-scroll { width: 100%; white-space: nowrap; }
.video-row { display: inline-flex; gap: 18rpx; padding: 2rpx 24rpx 12rpx 0; }
.video-card { width: 360rpx; overflow: hidden; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 25rpx rgba(51,43,33,.09); }
.video-cover-wrap { position: relative; height: 205rpx; overflow: hidden; background: #ddd; }
.video-cover { width: 100%; height: 100%; }
.video-play { position: absolute; left: 50%; top: 50%; width: 66rpx; height: 66rpx; margin: -33rpx 0 0 -33rpx; border-radius: 50%; background: rgba(255,255,255,.92); color: #31423e; text-align: center; line-height: 66rpx; font-size: 28rpx; text-indent: 4rpx; }
.video-label { position: absolute; left: 14rpx; top: 14rpx; padding: 6rpx 12rpx; border-radius: 999rpx; background: rgba(31,39,37,.72); color: #fff; font-size: 19rpx; }
.video-title { padding: 16rpx 17rpx 0; color: #303735; font-size: 27rpx; font-weight: 700; white-space: normal; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.video-meta { padding: 10rpx 17rpx 18rpx; color: #969b98; font-size: 20rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.category-grid { display: flex; padding: 34rpx 14rpx 26rpx; }
.category-item { width: 20%; display: flex; flex-direction: column; align-items: center; }
.category-icon { width: 82rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; border-radius: 26rpx; font-size: 42rpx; }
.tone-0 { background: #edf4ef; } .tone-1 { background: #fff0e8; } .tone-2 { background: #edf0f8; } .tone-3 { background: #f9ecf0; } .tone-4 { background: #f7f0e4; }
.category-name { margin-top: 12rpx; color: #343a38; font-size: 23rpx; font-weight: 700; }
.member-card { margin: 4rpx 24rpx 44rpx; padding: 28rpx; border-radius: 28rpx; background: linear-gradient(135deg,#f8e4c8,#f3d2a7); color: #6f451f; }
.member-top { display: flex; align-items: center; justify-content: space-between; } .member-title { font-size: 32rpx; font-weight: 700; }
.member-sub { margin-top: 5rpx; font-size: 23rpx; color: #976b40; } .member-btn { padding: 14rpx 25rpx; border-radius: 999rpx; background: linear-gradient(135deg,#e98560,#e65a4e); color: #fff; font-size: 25rpx; font-weight: 700; }
.coupon-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.coupon-ticket { position: relative; flex: 1; min-width: 0; padding: 20rpx; border-radius: 18rpx; background: rgba(255,255,255,.86); text-align: center; }
.coupon-ticket::before, .coupon-ticket::after { content: ''; position: absolute; top: 40%; width: 18rpx; height: 18rpx; border-radius: 50%; background: #f4d7b3; }
.coupon-ticket::before { left: -9rpx; } .coupon-ticket::after { right: -9rpx; }
.coupon-value { font-size: 42rpx; font-weight: 700; color: #b56b18; } .coupon-unit { margin-left: 4rpx; font-size: 22rpx; color: #b56b18; }
.coupon-name { display: block; margin-top: 2rpx; font-size: 21rpx; color: #b37a3d; }
.editor-pick, .activity-section { padding: 0 24rpx 44rpx; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 22rpx; }
.heading-cn { position: relative; padding-left: 22rpx; font-size: 38rpx; font-weight: 700; color: var(--color-ink); letter-spacing: 1rpx; }
.heading-cn::before { content: ''; position: absolute; left: 0; top: 8rpx; width: 7rpx; height: 38rpx; border-radius: 6rpx; background: var(--color-sage); }
.heading-en { padding-left: 22rpx; margin-top: 5rpx; color: #9aa09e; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.heading-more { padding: 9rpx 16rpx; border-radius: 999rpx; background: #f4f0e9; color: #897560; font-size: 23rpx; } .heading-more text { margin-left: 4rpx; font-size: 30rpx; }
.feature-card { border-radius: 26rpx; overflow: hidden; background: #fff; box-shadow: 0 12rpx 36rpx rgba(51,43,33,.09); }
.feature-photo { position: relative; height: 330rpx; overflow: hidden; background: #eee; }
.feature-photo image, .mini-cover image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.feature-tag { position: absolute; left: 20rpx; bottom: 18rpx; padding: 9rpx 16rpx; border-radius: 999rpx; color: #fff; background: rgba(30,39,37,.72); font-size: 22rpx; }
.feature-body { padding: 24rpx; } .feature-title { font-size: 33rpx; font-weight: 700; color: var(--color-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.feature-meta { margin-top: 8rpx; color: #7c8481; font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.feature-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.price-symbol { color: var(--color-primary); font-size: 25rpx; } .feature-price { color: var(--color-primary); font-size: 43rpx; font-weight: 700; } .price-note { color: #a5a8a6; font-size: 21rpx; }
.book-button { padding: 13rpx 26rpx; border-radius: 999rpx; background: var(--color-ink); color: #fff; font-size: 24rpx; font-weight: 700; }
.section-0 .heading-cn::before { background: #7d9ca5; } .section-1 .heading-cn::before { background: #b57c8f; } .section-2 .heading-cn::before { background: #8ba17e; } .section-3 .heading-cn::before { background: #c79a58; }
.activity-scroll { width: calc(100% + 24rpx); white-space: nowrap; } .activity-row { display: inline-flex; gap: 18rpx; padding: 4rpx 24rpx 12rpx 0; }
.mini-card { width: 286rpx; overflow: hidden; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 25rpx rgba(51,43,33,.08); }
.mini-cover { position: relative; height: 220rpx; overflow: hidden; background: #eee; }
.mini-city { position: absolute; left: 14rpx; top: 14rpx; padding: 7rpx 12rpx; border-radius: 999rpx; background: rgba(255,255,255,.9); color: #4c5552; font-size: 20rpx; font-weight: 700; }
.mini-body { padding: 17rpx; } .mini-title { height: 76rpx; color: #313735; font-size: 27rpx; font-weight: 700; line-height: 1.4; white-space: normal; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.mini-date { margin-top: 8rpx; color: #929794; font-size: 21rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mini-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 11rpx; } .mini-price { color: var(--color-primary); font-size: 29rpx; font-weight: 700; }
.mini-arrow { width: 39rpx; height: 39rpx; border-radius: 50%; background: #f4eee5; color: var(--color-primary); text-align: center; line-height: 37rpx; font-size: 29rpx; }
.highlight-panel { position: relative; margin: 8rpx 24rpx 44rpx; padding: 42rpx 34rpx; overflow: hidden; border-radius: 28rpx; background: linear-gradient(135deg,#293c39,#4f6b64); color: #fff; }
.highlight-panel::after { content: ''; position: absolute; right: -60rpx; top: -90rpx; width: 260rpx; height: 260rpx; border: 36rpx solid rgba(255,255,255,.07); border-radius: 50%; }
.highlight-mark { color: #e4c090; font-size: 21rpx; letter-spacing: 6rpx; } .highlight-title { margin-top: 14rpx; font-size: 34rpx; font-weight: 700; }
.highlight-sub { margin-top: 8rpx; font-size: 23rpx; color: rgba(255,255,255,.72); } .highlight-btn { display: inline-flex; margin-top: 24rpx; padding: 12rpx 22rpx; border-radius: 999rpx; background: #fff; color: #344944; font-size: 23rpx; font-weight: 700; }
.brand-footer { padding: 8rpx 24rpx 30rpx; text-align: center; } .brand-word { color: #95826f; font-size: 22rpx; font-weight: 700; letter-spacing: 7rpx; }
.brand-slogan { margin-top: 8rpx; color: #979c99; font-size: 23rpx; } .filing { margin-top: 18rpx; display: flex; flex-direction: column; gap: 4rpx; } .filing-text { color: #b5b7b5; font-size: 19rpx; }
.service-fab { position: fixed; right: 26rpx; bottom: 150rpx; z-index: 60; width: 92rpx; height: 92rpx; border-radius: 50%; background: rgba(255,255,255,.96); color: #2b3432; border: 1rpx solid #e8e4de; box-shadow: 0 10rpx 28rpx rgba(32,34,33,.15); font-size: 34rpx; font-weight: 700; letter-spacing: 2rpx; }
.city-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 200; display: flex; align-items: flex-end; background: rgba(20,25,24,.45); }
.city-sheet { width: 100%; padding: 30rpx 30rpx 50rpx; border-radius: 36rpx 36rpx 0 0; background: #fff; } .city-sheet-title { margin-bottom: 24rpx; text-align: center; font-size: 36rpx; font-weight: 700; }
.city-list { margin-bottom: 20rpx; } .city-item { display: flex; align-items: center; justify-content: space-between; padding: 27rpx 22rpx; border-bottom: 1rpx solid var(--color-border); font-size: 32rpx; }
.city-item.selected { border-radius: 18rpx; background: var(--color-primary-light); color: var(--color-primary); font-weight: 700; } .city-check { color: var(--color-primary); }

.assistant-panel { display: flex; flex-direction: column; align-items: center; margin: 8rpx 24rpx 44rpx; padding: 42rpx 34rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 34rpx rgba(55,44,31,.06); }
.assistant-title { color: #292f2d; font-size: 31rpx; font-weight: 700; }
.assistant-qr { width: 360rpx; height: 360rpx; margin-top: 26rpx; border-radius: 20rpx; }
.assistant-tip { margin-top: 22rpx; color: #505b58; font-size: 26rpx; }
.assistant-wechat { margin-top: 8rpx; color: #979c99; font-size: 23rpx; }
