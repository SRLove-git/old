<view class="home-page">
  <view class="home-tools">
    <view class="city-pill" bindtap="openCity"><view class="pin-icon"><view class="pin-dot"></view></view><text class="city-name">{{city}}</text><view class="chevron"></view></view>
    <view class="search-box" bindtap="goList"><view class="search-line-icon"></view><text class="search-placeholder">搜索活动、旅行、课程</text></view>
  </view>

  <view class="hero" bindtap="goList">
    <image class="hero-image" src="/assets/home-hero.jpg" mode="aspectFill" />
    <view class="hero-shade"></view>
    <view class="hero-copy">
      <text class="hero-kicker">岁悦里 · 乐活俱乐部</text>
      <view class="hero-title">把闲暇过成<text>闪亮日常</text></view>
      <view class="hero-sub">和同龄人一起，看山河、学新知、交朋友</view>
      <view class="hero-action">发现本周活动 <view class="arrow-line"></view></view>
    </view>
    <view class="hero-dots"><text></text><text></text><text></text></view>
  </view>

  <view wx:if="{{newsPosts.length}}" class="home-content-section policy-section">
    <view class="content-section-head"><view><view class="content-section-title">政策资讯</view><view class="content-section-en">GOVERNMENT NEWS</view></view><view class="content-head-actions"><text class="official-badge">权威来源</text><view class="content-more" data-type="news" bindtap="goContentList">查看全部 <text>›</text></view></view></view>
    <view class="policy-list">
      <view wx:for="{{newsPosts}}" wx:key="id" class="policy-card" data-id="{{item.id}}" bindtap="goContent">
        <image class="policy-cover" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="policy-copy"><view class="policy-title">{{item.title}}</view><view class="policy-summary">{{item.summary}}</view><view class="policy-meta"><text>{{item.source}}</text><text>{{item.publishedAt}}</text></view></view>
      </view>
    </view>
  </view>

  <view wx:if="{{videoPosts.length}}" class="home-content-section video-section">
    <view class="content-section-head"><view><view class="content-section-title">视频推荐</view><view class="content-section-en">FEATURED VIDEOS</view></view><view class="content-more" data-type="video" bindtap="goContentList">查看全部 <text>›</text></view></view>
    <scroll-view scroll-x class="video-scroll" enhanced show-scrollbar="{{false}}">
      <view class="video-row">
        <view wx:for="{{videoPosts}}" wx:key="id" class="video-card" data-id="{{item.id}}" bindtap="goContent">
          <view class="video-cover-wrap"><image class="video-cover" src="{{item.coverImage}}" mode="aspectFill" /><view class="video-play"><view class="play-triangle"></view></view><text class="video-label">视频</text></view>
          <view class="video-title">{{item.title}}</view><view class="video-meta">{{item.source}} · {{item.publishedAt}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="quick-heading"><view><view class="quick-title">按兴趣发现</view><view class="quick-sub">从喜欢的生活方式开始</view></view><text>5 类精选</text></view>
  <view class="category-grid">
    <view wx:for="{{categories}}" wx:key="id" class="category-item" data-id="{{item.id}}" bindtap="goCategory">
      <view class="category-icon tone-{{index}}"><view class="category-glyph category-glyph-{{index}}"></view></view><text class="category-name">{{item.name}}</text>
    </view>
  </view>

  <view class="member-card">
    <view class="member-top">
      <view><view class="member-title">立即入会，享会员特权</view><view class="member-sub">免费加入 · 本单最高省 ¥100</view></view>
      <button class="member-btn" bindtap="goProfile">立即入会</button>
    </view>
    <view class="coupon-row">
      <view wx:for="{{coupons}}" wx:key="id" wx:if="{{index < 2}}" class="coupon-ticket">
        <view><text class="coupon-value">{{item.value}}</text><text class="coupon-unit">元</text></view>
        <text class="coupon-name">{{item.minAmount ? '满' + item.minAmount + '元使用' : '无门槛券'}}</text>
      </view>
    </view>
  </view>

  <view class="editor-pick">
    <view class="section-heading">
      <view><view class="heading-cn">本周精选</view><view class="heading-en">WEEKLY PICKS</view></view>
      <view class="heading-more" bindtap="goList">查看全部 <text>›</text></view>
    </view>
    <view wx:if="{{featured}}" class="feature-card" data-id="{{featured.id}}" bindtap="goDetail">
      <view class="feature-photo">
        <image src="{{featured.art}}" mode="aspectFill" /><view class="feature-tag">{{featured.city}} · {{featured.soldCount}}人已报名</view>
      </view>
      <view class="feature-body">
        <view class="feature-title">{{featured.title}}</view>
        <view class="feature-meta">{{featured.schedules[0].date}} {{featured.schedules[0].weekday}} · {{featured.highlight}}</view>
        <view class="feature-foot">
          <view><text class="price-symbol">¥</text><text class="feature-price">{{featured.memberPrice}}</text><text class="price-note"> 会员价</text></view>
          <button class="book-button" data-id="{{featured.id}}" catchtap="goBooking">去报名</button>
        </view>
      </view>
    </view>
  </view>

  <block wx:for="{{groups}}" wx:key="id" wx:for-item="group" wx:for-index="groupIndex">
    <view class="activity-section section-{{groupIndex}}">
      <view class="section-heading">
        <view><view class="heading-cn">{{group.name}}</view><view class="heading-en">{{group.english}}</view></view>
        <view class="heading-more" data-id="{{group.id}}" bindtap="goMore">查看全部 <text>›</text></view>
      </view>
      <scroll-view scroll-x class="activity-scroll" enhanced show-scrollbar="{{false}}">
        <view class="activity-row">
          <view wx:for="{{group.activities}}" wx:key="id" class="mini-card" data-id="{{item.id}}" bindtap="goDetail">
            <view class="mini-cover"><image src="{{item.art}}" mode="aspectFill" /><text class="mini-city">{{item.city}}</text></view>
            <view class="mini-body">
              <view class="mini-title">{{item.title}}</view>
              <view class="mini-date">{{item.schedules[0].date}} · {{item.schedules[0].time}}</view>
              <view class="mini-foot"><text class="mini-price">¥{{item.memberPrice}}</text><view class="mini-arrow" role="button" aria-label="加入购物车" data-id="{{item.id}}" catchtap="addCart"><view class="plus-icon"></view></view></view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <view class="highlight-panel">
    <view class="highlight-mark">岁悦里</view><view class="highlight-title">探索无限世界 · 共创有趣人生</view>
    <view class="highlight-sub">每一次出发，都有熟悉的人和贴心的陪伴</view><button class="highlight-btn" bindtap="showService">联系小助理</button>
  </view>

  <view class="assistant-panel">
    <view class="assistant-title">小助理服务</view>
    <image class="assistant-qr" src="/assets/assistant-qr.png" show-menu-by-longpress mode="aspectFit" />
    <view class="assistant-tip">长按二维码，添加小助理微信</view>
    <view class="assistant-wechat">微信号：suiyueli6070（长按识别或保存二维码）</view>
  </view>

  <view class="brand-footer">
    <view class="brand-word">SUI YUE LI</view><view class="brand-slogan">和同龄人一起，玩得开心又省心</view>
    <view wx:if="{{filing.companyName || filing.icp || filing.police}}" class="filing">
      <text wx:if="{{filing.companyName}}" class="filing-text">{{filing.companyName}}</text><text wx:if="{{filing.icp}}" class="filing-text">{{filing.icp}}</text><text wx:if="{{filing.police}}" class="filing-text">{{filing.police}}</text>
    </view>
  </view>

  <view class="service-fab" role="button" aria-label="联系小助理" bindtap="showService"><view class="service-bubble-icon"><text></text><text></text><text></text></view></view>
  <view wx:if="{{serviceOpen}}" class="contact-mask" bindtap="closeService">
    <view class="contact-sheet" catchtap="noop">
      <view class="contact-handle"></view>
      <view class="contact-title">需要帮忙吗？</view>
      <view class="contact-sub">不会操作没关系，联系我们，我们一步步教您。</view>
      <view class="contact-row" data-field="phone" bindtap="copyServiceContact">
        <view class="contact-copy"><text class="contact-label">客服电话</text><text class="contact-value">{{assistant.phone}}</text></view>
        <view class="contact-copy-btn">复制</view>
      </view>
      <view class="contact-row" data-field="wechat" bindtap="copyServiceContact">
        <view class="contact-copy"><text class="contact-label">小助理微信</text><text class="contact-value">{{assistant.wechat}}</text></view>
        <view class="contact-copy-btn">复制</view>
      </view>
      <button class="contact-close" bindtap="closeService">我知道了</button>
    </view>
  </view>
  <view wx:if="{{cityOpen}}" class="city-mask" bindtap="closeCity">
    <view class="city-sheet" catchtap="noop">
      <view class="city-sheet-title">选择所在区域</view>
      <scroll-view scroll-y class="city-list" enhanced show-scrollbar="{{false}}"><view wx:for="{{cities}}" wx:key="*this" class="city-item {{city === item ? 'selected' : ''}}" data-city="{{item}}" bindtap="selectCity"><text>{{item}}</text><text wx:if="{{city === item}}" class="city-check">✓</text></view></scroll-view>
      <button class="btn btn-ghost btn-block" bindtap="closeCity">取消</button>
    </view>
  </view>
</view>
