<view class="page {{largeMode ? 'large-mode' : ''}}">
  <view class="region-bar" bindtap="openCity">
    <text class="region-icon">📍</text>
    <text class="region-city">{{city}}</text>
    <text class="region-arrow">▾</text>
    <text class="region-tip">点击切换区域</text>
  </view>

  <view class="home-top">
    <view>
      <view class="brand">岁悦里俱乐部</view>
      <view class="slogan">和同龄人一起，玩得开心又省心</view>
    </view>
    <button class="badge" bindtap="toggleLarge">大字</button>
  </view>

  <swiper class="banner-swiper" indicator-dots autoplay circular interval="4000" duration="500">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-item" style="background: {{item.tone}}" data-cat="{{item.cat}}" bindtap="goBanner">
        <view class="banner-text">
          <view class="banner-text-title">{{item.title}}</view>
          <view class="banner-text-sub">{{item.sub}}</view>
        </view>
        <text class="banner-emoji">{{item.emoji}}</text>
      </view>
    </swiper-item>
  </swiper>

  <view class="search-box" bindtap="goList">
    <text>🔍</text>
    <text class="search-placeholder">搜活动、旅行、课程</text>
  </view>

  <view class="section-title">按兴趣找活动</view>
  <view class="category-grid">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item"
      data-id="{{item.id}}"
      bindtap="goCategory"
    >
      <view class="category-emoji" style="background: {{item.color}}">{{item.emoji}}</view>
      <text class="category-name">{{item.name}}</text>
    </view>
  </view>

  <view class="member-card">
    <view>
      <view class="member-title">免费入会 · 领2张券</view>
      <view class="member-sub">会员价更划算，本单最高省¥100</view>
    </view>
    <button class="member-btn" bindtap="goProfile">立即入会</button>
  </view>

  <view class="home-coupons card">
    <view class="home-coupons-title">入会即送</view>
    <view class="home-coupons-list">
      <view wx:for="{{coupons}}" wx:key="id" class="home-coupon">
        <text class="home-coupon-value">¥{{item.value}}</text>
        <text class="home-coupon-name">{{item.title}}</text>
      </view>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">分类活动</text>
    <view class="mode-toggle">
      <text class="mode-item {{viewMode === 'recommend' ? 'on' : ''}}" data-mode="recommend" bindtap="setMode">推荐</text>
      <text class="mode-item {{viewMode === 'latest' ? 'on' : ''}}" data-mode="latest" bindtap="setMode">最新</text>
    </view>
  </view>

  <block wx:for="{{groups}}" wx:key="id" wx:for-item="group">
    <view class="group-head">
      <text class="group-emoji">{{group.emoji}}</text>
      <text class="group-name">{{group.name}}</text>
    </view>
    <view class="activity-list">
      <view
        wx:for="{{group.activities}}"
        wx:key="id"
        class="activity-card card"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="cover" style="background: {{item.coverTone}}">
          <text class="cover-emoji">{{item.cover}}</text>
          <text class="sold">{{item.soldCount}}人已报名</text>
          <text wx:if="{{item.minGroup > 0}}" class="group">{{item.soldCount >= item.minGroup ? '已成团' : item.minGroup + '人成团'}}</text>
        </view>
        <view class="card-body">
          <view class="card-title">{{item.title}}</view>
          <view class="meta">📅 {{item.schedules[0].date}} {{item.schedules[0].weekday}} · 📍 {{item.city}}</view>
          <view class="card-foot">
            <view>
              <text class="price">¥{{item.memberPrice}}</text>
              <text class="member-label">会员价</text>
            </view>
            <button class="go" data-id="{{item.id}}" catchtap="goBooking">立即报名</button>
          </view>
        </view>
      </view>
    </view>
    <view class="more-btn" data-id="{{group.id}}" bindtap="goMore">
      <text>查看更多</text>
      <text class="more-arrow">›</text>
    </view>
  </block>

  <view class="brand-footer card">
    <view class="brand-logo">岁悦里</view>
    <view class="brand-slogan">主理人贴心服务 · 平台靠谱保障</view>
    <button class="footer-btn" bindtap="showService">长按添加小助理微信，拉您进活动群</button>
  </view>

  <view wx:if="{{cityOpen}}" class="city-mask" bindtap="closeCity">
    <view class="city-sheet" catchtap="noop">
      <view class="city-sheet-title">选择所在区域</view>
      <view class="city-list">
        <view
          wx:for="{{cities}}"
          wx:key="*this"
          class="city-item {{city === item ? 'selected' : ''}}"
          data-city="{{item}}"
          bindtap="selectCity"
        >
          <text>{{item}}</text>
          <text wx:if="{{city === item}}" class="city-check">✓</text>
        </view>
      </view>
      <button class="btn btn-ghost btn-block" bindtap="closeCity">取消</button>
    </view>
  </view>
</view>
