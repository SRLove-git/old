<view class="page">
  <view wx:if="{{addresses.length > 0}}" class="addr-list">
    <view wx:for="{{addresses}}" wx:key="id" class="addr-card card">
      <view class="addr-main">
        <view class="addr-top">
          <text class="addr-name">{{item.name}}</text>
          <text class="addr-phone">{{item.phone}}</text>
          <text wx:if="{{item.isDefault}}" class="tag tag-primary">默认</text>
        </view>
        <view class="addr-detail">{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</view>
      </view>
      <view class="addr-actions">
        <text class="addr-action" data-id="{{item.id}}" bindtap="openEdit">编辑</text>
        <text wx:if="{{!item.isDefault}}" class="addr-action" data-id="{{item.id}}" bindtap="setDefault">设为默认</text>
        <text class="addr-action danger" data-id="{{item.id}}" bindtap="remove">删除</text>
      </view>
    </view>
  </view>
  <view wx:else class="empty">暂无收货地址，请先添加</view>

  <view class="add-bar">
    <button class="btn btn-primary btn-block" bindtap="openAdd">新增收货地址</button>
  </view>

  <view wx:if="{{editingId}}" class="mask" bindtap="closeForm">
    <view class="sheet" catchtap="noop">
      <view class="modal-title">{{editingId === 'new' ? '新增收货地址' : '编辑收货地址'}}</view>
      <view class="field">
        <text class="field-label">收货人<text class="required">*</text></text>
        <input class="field-input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="姓名" />
      </view>
      <view class="field">
        <text class="field-label">手机号<text class="required">*</text></text>
        <input class="field-input" type="number" maxlength="11" value="{{form.phone}}" data-field="phone" bindinput="onInput" placeholder="联系电话" />
      </view>
      <view class="field">
        <text class="field-label">配送地区<text class="required">*</text></text>
        <picker mode="selector" range="{{regionOptions}}" range-key="name" value="{{regionIndex}}" bindchange="onRegionChange">
          <view class="field-input picker-input {{form.region ? '' : 'placeholder'}}"><text>{{form.region || '请选择后台配置的地区'}}</text><text class="picker-arrow">›</text></view>
        </picker>
        <view wx:if="{{regionOptions.length === 0}}" class="region-empty-tip">后台暂未配置可用配送地区</view>
      </view>
      <view class="field">
        <text class="field-label">详细地址<text class="required">*</text></text>
        <input class="field-input" value="{{form.detail}}" data-field="detail" bindinput="onInput" placeholder="街道、门牌号等" />
      </view>
      <button class="btn btn-primary btn-block" bindtap="save">保存地址</button>
    </view>
  </view>
</view>
