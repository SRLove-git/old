.logistics-page { min-height: 100vh; padding: 28rpx 24rpx 70rpx; background: #f7f6f2; color: #2f3734; }
.query-hero { position: relative; display: flex; align-items: center; min-height: 210rpx; padding: 29rpx 26rpx; overflow: hidden; border-radius: 30rpx; background: linear-gradient(140deg,#e8f3ef 0%,#f6eee3 100%); }
.query-hero::after { content: ''; position: absolute; right: -54rpx; top: -76rpx; width: 230rpx; height: 230rpx; border: 30rpx solid rgba(74,115,101,.06); border-radius: 50%; }
.station-image { position: relative; z-index: 1; flex: none; width: 142rpx; height: 142rpx; }
.hero-copy { position: relative; z-index: 1; min-width: 0; margin-left: 22rpx; }
.hero-kicker { color: #66877b; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-title { margin-top: 7rpx; color: #2d3c37; font-size: 39rpx; font-weight: 700; }
.hero-sub { margin-top: 9rpx; color: #7e8985; font-size: 21rpx; line-height: 1.5; }
.query-card, .result-card, .empty-card, .help-card { margin-top: 20rpx; padding: 27rpx; border: 1rpx solid #ebe7df; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(49,44,36,.045); }
.field-label { margin-bottom: 13rpx; color: #3c4542; font-size: 24rpx; font-weight: 700; }
.query-field { height: 92rpx; display: flex; align-items: center; padding: 0 14rpx 0 22rpx; border: 2rpx solid #dfe7e3; border-radius: 20rpx; background: #fafcfb; }
.query-input { flex: 1; min-width: 0; height: 88rpx; color: #2f3935; font-size: 27rpx; }
.query-placeholder { color: #a9afac; }
.clear-button { flex: none; width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; color: #a1a8a5; font-size: 35rpx; line-height: 1; }
.paste-button { flex: none; margin-left: 8rpx; padding: 10rpx 17rpx; border-radius: 999rpx; background: #e9f2ee; color: #55766a; font-size: 22rpx; font-weight: 600; }
.query-button { min-height: 88rpx; margin-top: 19rpx; border: 0; border-radius: 20rpx; background: linear-gradient(120deg,#47675c,#638579); color: #fff; font-size: 27rpx; font-weight: 700; line-height: 88rpx; box-shadow: 0 10rpx 20rpx rgba(66,101,89,.16); }
.query-button::after, .detail-button::after { border: 0; }
.query-button[disabled] { opacity: .65; }
.privacy-tip { display: flex; align-items: center; justify-content: center; margin-top: 15rpx; color: #929995; font-size: 19rpx; }
.shield-mark { width: 25rpx; height: 25rpx; display: flex; align-items: center; justify-content: center; margin-right: 7rpx; border: 2rpx solid #85a398; border-radius: 50%; color: #66887c; font-size: 16rpx; font-weight: 700; }
.result-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; padding-bottom: 21rpx; border-bottom: 1rpx solid #eeeae3; }
.result-label { color: #8c9692; font-size: 19rpx; }
.result-title { max-width: 460rpx; margin-top: 5rpx; overflow: hidden; color: #303936; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.status-pill { flex: none; padding: 8rpx 14rpx; border-radius: 999rpx; background: #e9f3ef; color: #55766a; font-size: 20rpx; font-weight: 600; }
.result-row { display: flex; justify-content: space-between; gap: 22rpx; padding-top: 18rpx; color: #8b928f; font-size: 22rpx; }
.result-value { max-width: 470rpx; color: #48514e; text-align: right; overflow-wrap: anywhere; }
.latest-box { display: flex; margin-top: 23rpx; padding: 20rpx; border-radius: 19rpx; background: #f3f8f5; }
.latest-dot { flex: none; width: 14rpx; height: 14rpx; margin: 9rpx 14rpx 0 0; border: 4rpx solid #d7e7e1; border-radius: 50%; background: #5f8879; }
.latest-copy { min-width: 0; }
.latest-label { color: #66877b; font-size: 19rpx; font-weight: 700; }
.latest-text { margin-top: 5rpx; color: #35413d; font-size: 23rpx; line-height: 1.55; }
.latest-time { margin-top: 6rpx; color: #9aa19e; font-size: 18rpx; }
.timeline { margin-top: 26rpx; }
.timeline-item { display: flex; min-height: 92rpx; }
.timeline-axis { position: relative; flex: none; width: 34rpx; }
.timeline-dot { position: relative; z-index: 1; width: 12rpx; height: 12rpx; margin: 8rpx auto 0; border: 3rpx solid #fff; border-radius: 50%; background: #bdc8c3; box-shadow: 0 0 0 2rpx #d9dfdc; }
.timeline-line { position: absolute; left: 50%; top: 23rpx; bottom: -8rpx; width: 2rpx; background: #e0e5e2; transform: translateX(-50%); }
.timeline-copy { flex: 1; min-width: 0; padding: 0 0 24rpx 13rpx; }
.timeline-desc { color: #626b67; font-size: 22rpx; line-height: 1.45; }
.timeline-time { margin-top: 5rpx; color: #a0a6a3; font-size: 18rpx; }
.timeline-latest .timeline-dot { background: #557d6e; box-shadow: 0 0 0 3rpx #dbe9e4; }
.timeline-latest .timeline-desc { color: #35443f; font-weight: 600; }
.inline-tip { margin-top: 20rpx; padding: 17rpx; border-radius: 15rpx; background: #faf5eb; color: #8d714d; font-size: 21rpx; text-align: center; }
.detail-button { min-height: 74rpx; margin-top: 22rpx; border: 1rpx solid #dbe4e0; border-radius: 18rpx; background: #fff; color: #55766a; font-size: 23rpx; line-height: 72rpx; }
.detail-button text { margin-left: 5rpx; font-size: 29rpx; }
.empty-card { display: flex; flex-direction: column; align-items: center; padding-top: 36rpx; padding-bottom: 36rpx; text-align: center; }
.empty-icon { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f2f0eb; color: #9a958d; font-size: 33rpx; font-weight: 700; }
.empty-title { margin-top: 15rpx; color: #3b4441; font-size: 27rpx; font-weight: 700; }
.empty-sub { max-width: 540rpx; margin-top: 7rpx; color: #929894; font-size: 21rpx; line-height: 1.5; }
.help-title { margin-bottom: 18rpx; color: #3b4541; font-size: 25rpx; font-weight: 700; }
.help-item { display: flex; align-items: flex-start; margin-top: 15rpx; color: #7f8884; font-size: 21rpx; line-height: 1.5; }
.help-index { flex: none; width: 31rpx; height: 31rpx; display: flex; align-items: center; justify-content: center; margin-right: 12rpx; border-radius: 50%; background: #eef4f1; color: #5f7f74; font-size: 17rpx; font-weight: 700; }
