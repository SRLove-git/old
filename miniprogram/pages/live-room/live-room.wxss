.course-page { min-height: 100vh; padding: 20rpx 24rpx 180rpx; background: #f7f6f3; }
.loading { padding: 120rpx 0; text-align: center; color: var(--color-text-3); }
.course-hero { position: relative; height: 360rpx; overflow: hidden; border-radius: 28rpx; background: #41504b; }
.course-hero image, .hero-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-shade { background: linear-gradient(180deg,rgba(0,0,0,.02),rgba(19,27,25,.72)); }
.hero-info { position: absolute; left: 28rpx; right: 28rpx; bottom: 28rpx; color: #fff; }
.course-type { display: inline-flex; padding: 6rpx 14rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); font-size: 20rpx; }
.course-title { margin-top: 12rpx; font-size: 38rpx; font-weight: 700; line-height: 1.3; }
.course-teacher { margin-top: 8rpx; color: rgba(255,255,255,.82); font-size: 24rpx; }
.player-wrap { position: relative; margin-top: 20rpx; overflow: hidden; border-radius: 24rpx; background: #000; }
.player { display: block; width: 100%; height: 410rpx; }
.player-tip { position: absolute; left: 14rpx; top: 14rpx; padding: 6rpx 14rpx; border-radius: 999rpx; background: rgba(0,0,0,.58); color: #fff; font-size: 20rpx; }
.locked-player, .state-box { margin-top: 20rpx; padding: 54rpx 28rpx; border-radius: 24rpx; background: linear-gradient(145deg,#293633,#40534e); color: #fff; text-align: center; }
.lock-icon, .state-icon { margin: auto; width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255,255,255,.12); color: #ecc995; font-size: 34rpx; line-height: 72rpx; }
.lock-title, .state-title { margin-top: 18rpx; font-size: 31rpx; font-weight: 700; }
.lock-sub, .state-sub { margin-top: 9rpx; color: rgba(255,255,255,.68); font-size: 23rpx; }
.unlock-button, .remind-button { display: inline-flex; margin-top: 25rpx; padding: 14rpx 28rpx; border-radius: 999rpx; background: #f1d2a3; color: #6b4826; font-size: 25rpx; font-weight: 700; }
.course-summary { margin-top: 20rpx; padding: 26rpx; border-radius: 24rpx; background: #fff; }
.summary-main { display: flex; align-items: center; justify-content: space-between; } .price-symbol { color: var(--color-primary); font-size: 25rpx; }
.price { color: var(--color-primary); font-size: 44rpx; font-weight: 700; } .original { margin-left: 11rpx; color: #aaa; font-size: 22rpx; text-decoration: line-through; }
.purchased-label { padding: 8rpx 15rpx; border-radius: 999rpx; background: #edf4ee; color: #66806c; font-size: 22rpx; font-weight: 700; }
.summary-stats { display: flex; gap: 15rpx; margin-top: 13rpx; color: #8c928f; font-size: 22rpx; }
.summary-stats text { padding-right: 15rpx; border-right: 1rpx solid #ddd; } .summary-stats text:last-child { border-right: 0; }
.section-card { margin-top: 20rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; }
.section-title { margin-bottom: 20rpx; color: #2b322f; font-size: 31rpx; font-weight: 700; }
.lesson-row { display: flex; align-items: center; min-height: 94rpx; border-bottom: 1rpx solid #eeebe6; }
.lesson-row:last-child { border-bottom: 0; } .lesson-number { width: 58rpx; color: #b49a77; font-size: 24rpx; font-weight: 700; }
.lesson-info { flex: 1; } .lesson-title { color: #353b39; font-size: 26rpx; } .lesson-duration { margin-top: 4rpx; color: #a0a4a2; font-size: 20rpx; }
.lesson-state { width: 44rpx; color: var(--color-primary); text-align: center; font-size: 22rpx; }
.info-desc { color: #5d6562; font-size: 26rpx; line-height: 1.8; }
.teacher-row { display: flex; align-items: center; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #eeebe6; }
.teacher-avatar { width: 72rpx; height: 72rpx; margin-right: 15rpx; border-radius: 50%; background: #f2e4d3; color: #936a42; text-align: center; line-height: 72rpx; font-weight: 700; }
.teacher-name { color: #343a38; font-size: 27rpx; font-weight: 700; } .teacher-desc { margin-top: 3rpx; color: #999e9b; font-size: 21rpx; }
.activity-card { display: flex; align-items: center; } .activity-cover { flex-shrink: 0; width: 112rpx; height: 112rpx; border-radius: 18rpx; text-align: center; line-height: 112rpx; font-size: 48rpx; }
.activity-info { flex: 1; min-width: 0; margin-left: 18rpx; } .activity-title { color: #333936; font-size: 27rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.activity-price { margin-top: 6rpx; color: var(--color-primary); font-size: 24rpx; font-weight: 700; } .activity-link { margin-top: 4rpx; color: #969b98; font-size: 21rpx; }
.purchase-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 80; display: flex; align-items: center; justify-content: space-between; height: 116rpx; padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8e4de; background: #fff; }
.bar-label { color: #777e7b; font-size: 22rpx; } .bar-price { margin-left: 8rpx; color: var(--color-primary); font-size: 39rpx; font-weight: 700; }
.bar-cart { margin-left: auto; padding: 17rpx 20rpx; border: 1rpx solid var(--color-primary); border-radius: 999rpx; color: var(--color-primary); font-size: 22rpx; font-weight: 700; }
.bar-button { width: 220rpx; margin-left: 10rpx; padding: 19rpx 16rpx; border-radius: 999rpx; background: #293633; color: #fff; font-size: 25rpx; font-weight: 700; }
