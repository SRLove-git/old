.provider-page { min-height: 100vh; padding: 24rpx 24rpx 80rpx; background: #f7f6f3; }
.apply-head { position: relative; overflow: hidden; padding: 36rpx 32rpx; border-radius: 28rpx; background: linear-gradient(135deg,#293633,#4f6d64); color: #fff; }
.apply-head::after { content: ''; position: absolute; right: -60rpx; top: -84rpx; width: 230rpx; height: 230rpx; border: 32rpx solid rgba(255,255,255,.06); border-radius: 50%; }
.head-mark { color: #ebc895; font-size: 20rpx; font-weight: 700; letter-spacing: 5rpx; }
.head-title { margin-top: 14rpx; font-size: 38rpx; font-weight: 700; }
.head-sub { margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 24rpx; }
.form-card { margin-top: 22rpx; padding: 30rpx 28rpx; border-radius: 26rpx; background: #fff; }
.field { margin-bottom: 30rpx; }
.last-field { margin-bottom: 0; }
.field-label { margin-bottom: 13rpx; color: #2e3532; font-size: 28rpx; font-weight: 700; }
.field-label text { margin-left: 4rpx; color: #df6857; }
.type-options { display: flex; gap: 16rpx; }
.type-option { flex: 1; display: flex; align-items: center; min-width: 0; padding: 20rpx 18rpx; border: 2rpx solid #e6e2dc; border-radius: 18rpx; background: #fbfaf8; }
.type-option.active { border-color: #9a7856; background: #fbf3e9; }
.radio { flex-shrink: 0; width: 32rpx; height: 32rpx; margin-right: 13rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #aaa8a4; border-radius: 50%; }
.type-option.active .radio { border-color: #9a7856; }
.radio text { width: 18rpx; height: 18rpx; border-radius: 50%; background: #9a7856; }
.type-name { color: #333a37; font-size: 27rpx; font-weight: 700; }
.type-tip { margin-top: 2rpx; color: #969b98; font-size: 20rpx; }
.field-control { width: 100%; height: 92rpx; padding: 0 22rpx; border: 2rpx solid #e7e3dd; border-radius: 17rpx; background: #fbfaf8; color: #303633; font-size: 27rpx; }
.field-control:focus { border-color: #b18a64; }
.textarea { height: 150rpx; padding-top: 20rpx; line-height: 1.6; }
.products { height: 190rpx; padding-bottom: 46rpx; }
.count { margin-top: -40rpx; padding-right: 18rpx; position: relative; color: #aaa; text-align: right; font-size: 20rpx; }
.error { margin-top: 8rpx; color: #d75d4d; font-size: 22rpx; }
.privacy-tip { padding: 20rpx 18rpx; color: #969b98; font-size: 21rpx; line-height: 1.6; }
.submit-button { width: 100%; height: 96rpx; border-radius: 999rpx; background: #293633; color: #fff; font-size: 30rpx; font-weight: 700; line-height: 96rpx; }
.submit-button[disabled] { background: #8d9592; color: #fff; }
