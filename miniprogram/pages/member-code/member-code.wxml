<view class="member-page">
  <view class="member-card {{levelClass}}">
    <view class="card-top">
      <view class="brand">
        <view class="brand-logo">岁悦里</view>
        <view class="brand-sub">俱乐部 · 尊享会员卡</view>
      </view>
      <view class="level-badge">{{memberLevelName}}</view>
    </view>

    <view class="card-main">
      <view class="card-user">
        <view class="card-name">{{user.name}}</view>
        <view class="card-title">尊享会员</view>
        <view class="card-phone">{{user.phone}}</view>
      </view>
      <view class="qr-box">
        <canvas canvas-id="memberQr" class="qr-canvas" width="200" height="200"></canvas>
      </view>
    </view>

    <view class="member-no-label">会员编号 MEMBER NO.</view>
    <view class="member-no">{{memberIdDisplay}}</view>

    <view class="card-foot">
      <text>入会时间 {{memberSince}}</text>
      <text>有效期 {{memberExpireAt}}</text>
    </view>
  </view>

  <view class="show-tip">到店消费或参加活动时，出示此会员码给工作人员核销</view>

  <view class="benefits card">
    <view class="benefits-title">会员专属权益</view>
    <view wx:for="{{benefits}}" wx:key="text" class="benefit">
      <text class="benefit-emoji">{{item.emoji}}</text>
      <text class="benefit-text">{{item.text}}</text>
    </view>
  </view>

  <view wx:if="{{!user.member}}" class="join-card card">
    <view class="join-text">还不是会员？免费入会，领2张券</view>
    <button class="btn btn-primary btn-block" bindtap="joinMember">立即入会</button>
  </view>
</view>
