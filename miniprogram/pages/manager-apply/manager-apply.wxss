.intro {
  background: linear-gradient(135deg, #ff6a3d, #e19a6d);
  color: #ffffff;
  border-radius: 28rpx;
  padding: 38rpx 30rpx;
  margin-bottom: 24rpx;
}

.intro-title {
  font-size: 40rpx;
  font-weight: 700;
}

.intro-sub {
  margin-top: 10rpx;
  opacity: 0.92;
}

.fee-card {
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.fee-label {
  color: #6f747b;
  font-size: 26rpx;
}

.fee-value {
  color: #ff6a3d;
  font-size: 56rpx;
  font-weight: 700;
  margin: 8rpx 0;
}

.fee-sub {
  color: #6f747b;
  font-size: 24rpx;
}

.form-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.required {
  color: #d74a4a;
  margin-left: 4rpx;
}

.tag-select {
  display: flex;
  flex-wrap: wrap;
}

.tag-chip {
  border: 2rpx solid #e7e9ec;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  font-weight: 700;
}

.tag-chip.selected {
  border-color: #ff6a3d;
  background: #fff4ec;
  color: #ff6a3d;
}

.agree-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ff6a3d;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
}

.checkbox.checked {
  background: #ff6a3d;
}

.pay-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 22, 26, 0.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx;
}

.pay-modal {
  width: 100%;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 34rpx;
  text-align: center;
}

.pay-title {
  font-size: 36rpx;
  font-weight: 700;
}

.pay-amount {
  color: #ff6a3d;
  font-size: 64rpx;
  font-weight: 700;
  margin: 18rpx 0;
}

.pay-tip {
  color: #6f747b;
  font-size: 26rpx;
  margin-bottom: 26rpx;
}
