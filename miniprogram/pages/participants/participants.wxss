.participant-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #ffefe6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.info {
  flex: 1;
}

.name {
  font-weight: 700;
  font-size: 34rpx;
}

.phone {
  color: #6f747b;
  font-size: 26rpx;
}

.small-btn {
  border: 2rpx solid #ff6a3d;
  color: #ff6a3d;
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.small-btn.danger {
  border-color: #d74a4a;
  color: #d74a4a;
}

.pay-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 22, 26, 0.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx;
}

.pay-modal {
  width: 100%;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 34rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 26rpx;
}

.required {
  color: #d74a4a;
  margin-left: 4rpx;
}
