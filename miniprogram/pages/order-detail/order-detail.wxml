<view wx:if="{{order}}" class="order-detail-page">
  <view class="status-hero">
    <view class="status-icon">{{statusIcon}}</view>
    <view class="status-text">{{displayStatus}}</view>
    <view class="status-sub">{{statusSub}}</view>
  </view>

  <view class="detail-card page-pad">
    <view class="order-title">{{order.title}}</view>
    <view class="order-meta">📅 {{order.timeText}}</view>
    <view wx:if="{{order.skuName}}" class="order-meta">🏷️ {{order.skuName}}</view>
    <view wx:if="{{order.venueAddress}}" class="order-venue"><text class="order-venue-pin">📍</text><view class="order-venue-body"><view class="order-venue-label">活动地点</view><view class="order-venue-text">{{order.venueAddress}}</view></view></view>
    <view class="order-meta">👥 {{order.participants}}</view>
    <view class="order-meta">🧾 订单号 {{order.id}}</view>
  </view>

  <view wx:if="{{order.status === '待付款'}}" class="detail-card page-pad">
    <view class="panel-title">订单待支付</view>
    <view class="pay-deadline">剩余支付时间：{{payRemain}}（超时自动取消并释放名额）</view>
  </view>

  <view wx:if="{{order.category === 4}}" class="detail-card page-pad">
    <view class="panel-title">核销码</view>
    <view class="code-box">
      <view class="qr">二维码</view>
      <view class="code">{{order.code}}</view>
      <view class="code-tip">到店出示给工作人员核销</view>
    </view>
  </view>

  <view wx:if="{{order.shipTime || order.trackingNo}}" class="detail-card page-pad">
    <view class="panel-title">物流信息</view>
    <view class="confirm-row"><text>配送方式</text><text>{{order.deliveryType === 'self' ? '无需物流（线下交付/自提）' : '快递发货'}}</text></view>
    <view wx:if="{{order.trackingNo}}" class="confirm-row"><text>快递单号</text><text>{{order.carrier}} {{order.trackingNo}}</text></view>
    <view wx:if="{{order.shipTime}}" class="confirm-row"><text>发货时间</text><text>{{order.shipTime}}</text></view>
    <view wx:if="{{order.shippingNote}}" class="confirm-row"><text>商家备注</text><text>{{order.shippingNote}}</text></view>
    <button wx:if="{{order.trackingNo}}" class="copy-tracking" bindtap="copyTracking">复制快递单号</button>
  </view>

  <view class="detail-card page-pad">
    <view class="confirm-row"><text>实付金额</text><text>¥{{order.payAmount}}</text></view>
    <view class="confirm-row"><text>优惠券</text><text>{{order.coupon}}</text></view>
    <view class="confirm-row"><text>下单时间</text><text>{{order.createdAt}}</text></view>
    <view wx:if="{{order.venueAddress}}" class="confirm-row"><text>活动地址</text><text>{{order.venueAddress}}</text></view>
    <view wx:if="{{order.address}}" class="confirm-row"><text>收货地址</text><text>{{order.address.name}} {{order.address.phone}} {{order.address.district}} {{order.address.detail}}</text></view>
    <view wx:if="{{order.refundAmount}}" class="confirm-row"><text>退款金额</text><text class="red">¥{{order.refundAmount}}</text></view>
  </view>

  <view class="fixed-bottom order-bottom">
    <button class="contact" bindtap="contact">🎧 联系客服</button>

    <block wx:if="{{order.status === '待付款'}}">
      <button class="btn btn-ghost" bindtap="cancelNow">取消订单</button>
      <button class="btn btn-primary" bindtap="payNow">去支付</button>
    </block>

    <block wx:elif="{{order.status === '待发货'}}">
      <button wx:if="{{refundInfo.can}}" class="btn btn-danger" bindtap="openRefund">申请退款</button>
      <view wx:if="{{order.category !== 4}}" class="ship-hint">等待商家发货</view>
    </block>

    <block wx:elif="{{order.status === '待收货'}}">
      <button wx:if="{{refundInfo.can}}" class="btn btn-danger" bindtap="openRefund">申请退款</button>
      <button class="btn btn-primary" bindtap="advance">{{actionLabel}}</button>
    </block>

    <block wx:elif="{{order.status === '退款中'}}">
      <view class="ship-hint">退款申请审核中，通过后原路退回</view>
    </block>

    <block wx:elif="{{order.status === '已核销'}}">
      <button class="btn btn-primary" bindtap="advance">{{actionLabel}}</button>
    </block>

    <block wx:elif="{{order.status === '待评价'}}">
      <button class="btn btn-primary" bindtap="openReview">{{actionLabel}}</button>
    </block>
  </view>

  <view wx:if="{{refundOpen}}" class="mask" bindtap="closeRefund">
    <view class="sheet" catchtap="noop">
      <view class="modal-title">申请退款</view>
      <view class="refund-rule">预计可退 ¥{{refundInfo.amount}}（{{refundInfo.reason}}）</view>
      <view class="refund-rule">提交后由平台审核，通过后原路退回</view>
      <view class="field">
        <text class="field-label">退款原因</text>
        <picker range="{{reasons}}" value="{{refundIndex}}" bindchange="onReason">
          <view class="picker-value">{{refundReason}}</view>
        </picker>
      </view>
      <button class="btn btn-primary btn-block" bindtap="submitRefund">确认申请退款</button>
      <button class="text-btn" bindtap="closeRefund">我再想想</button>
    </view>
  </view>

  <view wx:if="{{reviewOpen}}" class="mask" bindtap="closeReview">
    <view class="sheet" catchtap="noop">
      <view class="modal-title">评价本次活动</view>
      <view class="stars">
        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          class="star {{item <= reviewRating ? 'on' : ''}}"
          data-rating="{{item}}"
          bindtap="onRating"
        >★</text>
      </view>
      <textarea class="field-input review-input" value="{{reviewContent}}" bindinput="onReviewInput" placeholder="说说您的体验（选填）" />
      <button class="btn btn-primary btn-block" bindtap="submitReview">提交评价</button>
    </view>
  </view>
</view>
