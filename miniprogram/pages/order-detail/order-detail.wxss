.order-detail-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.status-hero {
  background: var(--color-sage);
  color: #ffffff;
  padding: 48rpx 30rpx;
  text-align: center;
}

.hero-pay {
  background: #dd8a3e;
}

.hero-ship {
  background: #6b8da8;
}

.hero-done {
  background: var(--color-sage);
}

.hero-refund {
  background: #8d939b;
}

.hero-cancel {
  background: #a39e93;
}

.status-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  margin: 0 auto 16rpx;
}

.status-text {
  font-size: 42rpx;
  font-weight: 700;
}

.status-sub {
  opacity: 0.9;
  margin-top: 8rpx;
}

.page-pad {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.detail-card {
  background: #ffffff;
  margin-top: 20rpx;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(55, 44, 31, 0.06);
}

.order-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}

.order-meta {
  color: var(--color-text-3);
  font-size: 28rpx;
  margin-top: 12rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.pay-deadline {
  color: var(--color-warning);
  font-weight: 700;
}

.red {
  color: var(--color-primary);
}

.code-box {
  text-align: center;
  padding: 12rpx 0;
}

.qr {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  background: var(--color-fill);
}

.code {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.code-tip {
  color: var(--color-text-3);
  font-size: 26rpx;
  margin-top: 10rpx;
}

.confirm-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text-3);
}

.confirm-row:last-child {
  border-bottom: 0;
}

.confirm-row text:last-child {
  color: var(--color-text-1);
  font-weight: 700;
  text-align: right;
}

.order-bottom {
  display: flex;
  align-items: center;
}

.contact {
  width: 170rpx;
  color: var(--color-text-3);
  font-size: 30rpx;
}

.main-btn {
  flex: 1;
}

.refund-rule {
  background: var(--color-primary-light);
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}

.stars {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.star {
  font-size: 60rpx;
  color: var(--color-border);
  margin: 0 8rpx;
}

.star.on {
  color: var(--color-warning);
}

.review-input {
  min-height: 160rpx;
  margin-bottom: 24rpx;
}

.picker-value {
  min-height: 96rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
}

.text-btn {
  color: var(--color-text-3);
  padding: 22rpx;
  text-align: center;
}

.order-venue {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: var(--color-primary-light);
}

.order-venue-pin {
  font-size: 30rpx;
}

.order-venue-body {
  flex: 1;
  min-width: 0;
}

.order-venue-label {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.order-venue-text {
  margin-top: 6rpx;
  color: var(--color-text-1);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.ship-hint {
  flex: 1;
  text-align: center;
  color: var(--color-text-3);
  font-size: 28rpx;
  padding: 22rpx 0;
}

.copy-tracking {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}
