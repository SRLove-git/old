.order-detail-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.status-hero {
  background: linear-gradient(135deg, var(--color-success), var(--color-success));
  color: #ffffff;
  padding: 48rpx 30rpx;
  text-align: center;
}

.status-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  margin: 0 auto 16rpx;
}

.status-text {
  font-size: 42rpx;
  font-weight: 700;
}

.status-sub {
  opacity: 0.9;
  margin-top: 8rpx;
}

.page-pad {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.detail-card {
  background: #ffffff;
  margin-top: 20rpx;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(26, 34, 45, 0.07);
}

.order-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}

.order-meta {
  color: var(--color-text-3);
  font-size: 28rpx;
  margin-top: 12rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.pay-deadline {
  color: #c96b2a;
  font-weight: 700;
}

.red {
  color: var(--color-primary);
}

.code-box {
  text-align: center;
  padding: 12rpx 0;
}

.qr {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-3);
  background: var(--color-fill);
}

.code {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.code-tip {
  color: var(--color-text-3);
  font-size: 26rpx;
  margin-top: 10rpx;
}

.confirm-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text-3);
}

.confirm-row:last-child {
  border-bottom: 0;
}

.confirm-row text:last-child {
  color: var(--color-text-1);
  font-weight: 700;
  text-align: right;
}

.order-bottom {
  display: flex;
  align-items: center;
}

.contact {
  width: 170rpx;
  color: var(--color-text-3);
  font-size: 30rpx;
}

.main-btn {
  flex: 1;
}

.pay-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 22, 26, 0.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx;
}

.pay-modal {
  width: 100%;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 34rpx;
}

.refund-rule {
  background: var(--color-primary-light);
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}

.stars {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.star {
  font-size: 60rpx;
  color: var(--color-border);
  margin: 0 8rpx;
}

.star.on {
  color: var(--color-warning);
}

.review-input {
  min-height: 160rpx;
  margin-bottom: 24rpx;
}

.picker-value {
  min-height: 96rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
}

.text-btn {
  color: var(--color-text-3);
  padding: 22rpx;
  text-align: center;
}
