.order-detail-page { min-height: 100vh; padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); background: #f6f4ef; }
.status-hero { position: relative; min-height: 272rpx; padding: 42rpx 40rpx 52rpx; overflow: hidden; color: #304039; background: linear-gradient(135deg, #eaf2ed 0%, #dce9e1 100%); }
.hero-pay { color: #76502e; background: linear-gradient(135deg, #fff3e5, #f7dfc3); }
.hero-ship, .hero-done { color: #304039; background: linear-gradient(135deg, #edf4ef, #d9e8df); }
.hero-refund { color: #555c59; background: linear-gradient(135deg, #f0f1ef, #e1e4e0); }
.hero-cancel { color: #69665f; background: linear-gradient(135deg, #f3f1ec, #e7e2da); }
.hero-decoration { position: absolute; border: 2rpx solid currentColor; border-radius: 50%; opacity: .08; }
.hero-decoration-one { width: 250rpx; height: 250rpx; top: -120rpx; right: -32rpx; }
.hero-decoration-two { width: 140rpx; height: 140rpx; right: 86rpx; bottom: -88rpx; }
.status-eyebrow { position: relative; z-index: 1; display: flex; align-items: center; gap: 12rpx; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; opacity: .66; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 7rpx rgba(255,255,255,.36); }
.status-text { position: relative; z-index: 1; margin-top: 16rpx; font-size: 46rpx; font-weight: 800; letter-spacing: 1rpx; }
.status-sub { position: relative; z-index: 1; max-width: 610rpx; margin-top: 8rpx; font-size: 28rpx; line-height: 1.5; opacity: .84; }
.status-order-no { position: relative; z-index: 1; display: inline-flex; margin-top: 22rpx; padding: 7rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.5); font-size: 21rpx; opacity: .78; }
.content-wrap { position: relative; z-index: 2; margin-top: -18rpx; padding: 0 24rpx; }
.detail-card { margin-bottom: 22rpx; padding: 30rpx; border: 1rpx solid rgba(84,70,52,.07); border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(72,58,42,.05); }
.card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 26rpx; }
.simple-heading { margin-bottom: 16rpx; }
.card-title { color: var(--color-ink); font-size: 32rpx; font-weight: 800; }
.card-subtitle { margin-top: 2rpx; color: #aaa49a; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.status-chip { flex: none; padding: 7rpx 17rpx; border-radius: 999rpx; font-size: 23rpx; font-weight: 700; }
.chip-pay { color: #a16935; background: #fff1e1; }
.chip-ship, .chip-done { color: #567462; background: #edf5ef; }
.chip-refund, .chip-cancel { color: #77746d; background: #f1efeb; }
.order-title { padding-bottom: 24rpx; border-bottom: 1rpx solid #eeeae3; color: var(--color-ink); font-size: 36rpx; font-weight: 800; line-height: 1.4; }
.meta-list { padding-top: 8rpx; }
.meta-row { display: flex; align-items: center; gap: 20rpx; min-height: 92rpx; }
.meta-icon-image { flex: none; width: 54rpx; height: 54rpx; }
.meta-content { min-width: 0; }
.meta-label { color: #979b97; font-size: 22rpx; }
.meta-value { margin-top: 1rpx; color: var(--color-ink); font-size: 28rpx; font-weight: 650; line-height: 1.45; }
.venue-box { display: flex; align-items: flex-start; gap: 18rpx; margin-top: 12rpx; padding: 22rpx; border-radius: 20rpx; background: #f2f6f2; }
.venue-icon { flex: none; width: 54rpx; height: 54rpx; }
.venue-body { min-width: 0; } .venue-label { color: #718278; font-size: 22rpx; font-weight: 700; }
.venue-text { margin-top: 4rpx; color: var(--color-ink); font-size: 27rpx; font-weight: 650; line-height: 1.5; }
.pay-card { display: flex; align-items: center; gap: 20rpx; background: #fff9f1; }
.notice-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 50%; color: #fff; background: #c58a50; font-size: 30rpx; font-weight: 800; }
.notice-content { min-width: 0; } .notice-title { color: #704d2d; font-size: 29rpx; font-weight: 800; }
.pay-deadline { margin-top: 4rpx; color: #9b7654; font-size: 24rpx; line-height: 1.5; }
.code-box { padding: 14rpx 0 4rpx; text-align: center; }
.qr { position: relative; display: flex; align-items: center; justify-content: center; width: 220rpx; height: 220rpx; margin: 0 auto 20rpx; color: #a5a19a; background: #faf9f6; font-size: 25rpx; }
.qr-corner { position: absolute; width: 42rpx; height: 42rpx; border-color: #73877a; border-style: solid; }
.qr-top-left { top: 0; left: 0; border-width: 4rpx 0 0 4rpx; } .qr-top-right { top: 0; right: 0; border-width: 4rpx 4rpx 0 0; }
.qr-bottom-left { bottom: 0; left: 0; border-width: 0 0 4rpx 4rpx; } .qr-bottom-right { right: 0; bottom: 0; border-width: 0 4rpx 4rpx 0; }
.code { color: var(--color-ink); font-size: 42rpx; font-weight: 800; letter-spacing: 6rpx; } .code-tip { margin-top: 8rpx; color: #929791; font-size: 24rpx; }
.logistics-head { align-items: center; }
.logistics-refresh { flex: none; min-height: 0; margin: 0; padding: 10rpx 20rpx; border-radius: 999rpx; color: #627c69; background: #eef5f0; font-size: 23rpx; font-weight: 700; line-height: 1.4; }
.logistics-refresh::after { border: 0; }
.info-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 28rpx; padding: 20rpx 0; border-bottom: 1rpx solid #eeeae3; color: #8b908d; font-size: 27rpx; }
.info-row > text:first-child { flex: none; } .info-row > text:last-child { color: var(--color-ink); font-weight: 650; text-align: right; word-break: break-all; }
.tracking-number-row { align-items: center; }
.tracking-number { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; min-width: 0; color: var(--color-ink); font-weight: 650; text-align: right; }
.tracking-number text { word-break: break-all; } .tracking-number button { flex: none; padding: 5rpx 14rpx; border-radius: 999rpx; color: #755335; background: #f7eee4; font-size: 21rpx; }
.tracking-panel { margin-top: 24rpx; padding: 24rpx 22rpx 0; border-radius: 20rpx; background: #f7f9f7; }
.tracking-current { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 26rpx; }
.tracking-kicker { color: #949a95; font-size: 21rpx; } .tracking-status { display: block; margin-top: 2rpx; color: #54715d; font-size: 30rpx; font-weight: 800; }
.tracking-updated { max-width: 260rpx; color: #9ba09b; font-size: 21rpx; line-height: 1.4; text-align: right; }
.tracking-error { margin-bottom: 20rpx; padding: 16rpx; border-radius: 14rpx; color: #b85b50; background: #fff0ed; font-size: 24rpx; }
.tracking-empty { padding: 12rpx 0 30rpx; color: #969b97; font-size: 25rpx; text-align: center; }
.tracking-event { position: relative; display: flex; gap: 20rpx; padding: 0 0 28rpx; color: #858c87; }
.tracking-event::before { position: absolute; top: 16rpx; bottom: -4rpx; left: 7rpx; width: 2rpx; background: #dfe5e0; content: ''; }
.tracking-event:last-child::before { display: none; } .tracking-dot { position: relative; z-index: 1; flex: none; width: 16rpx; height: 16rpx; margin-top: 9rpx; border-radius: 50%; background: #c7cec8; }
.tracking-event-latest .tracking-dot { background: #6f8b77; box-shadow: 0 0 0 8rpx #e4eee7; }
.tracking-event-body { min-width: 0; } .tracking-desc { font-size: 25rpx; line-height: 1.55; }
.tracking-event-latest .tracking-desc { color: var(--color-ink); font-weight: 700; } .tracking-time { margin-top: 6rpx; font-size: 21rpx; }
.coupon-row > text:last-child { color: #b36c4e; }
.total-row { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 8rpx; padding-top: 24rpx; }
.total-row > text { color: var(--color-ink); font-size: 29rpx; font-weight: 800; } .total-price { color: #a86f41; font-size: 46rpx; font-weight: 800; line-height: 1; }
.currency { margin-right: 4rpx; font-size: 25rpx; }
.address-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 28rpx; padding: 20rpx 0; border-bottom: 1rpx solid #eeeae3; color: #8b908d; font-size: 27rpx; }
.address-row > text { flex: none; } .address-row > view { display: flex; flex-direction: column; align-items: flex-end; color: var(--color-ink); font-weight: 650; line-height: 1.55; text-align: right; }
.refund-row > text:last-child { color: #b5574d; }
.order-bottom { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(69,59,47,.08); box-shadow: 0 -10rpx 28rpx rgba(61,50,37,.05); }
.contact { display: flex; flex: none; flex-direction: column; align-items: center; justify-content: center; width: 112rpx; min-height: 88rpx; color: #707875; font-size: 21rpx; line-height: 1.25; }
.contact-icon { width: 46rpx; height: 46rpx; margin-bottom: 2rpx; }
.bottom-action { flex: 1; min-width: 0; min-height: 88rpx; padding: 15rpx 22rpx; border-radius: 22rpx; font-size: 29rpx; } .bottom-action-main { flex: 1.18; }
.ship-hint { flex: 1; padding: 20rpx 8rpx; color: #7a817f; font-size: 26rpx; text-align: center; }
.refund-rule { margin-bottom: 20rpx; padding: 20rpx 22rpx; border-radius: 18rpx; color: #76583d; background: #f8f0e7; font-size: 26rpx; }
.modal-title { margin-bottom: 22rpx; color: var(--color-ink); font-size: 36rpx; font-weight: 800; text-align: center; }
.stars { display: flex; justify-content: center; margin-bottom: 20rpx; } .star { margin: 0 8rpx; color: var(--color-border); font-size: 60rpx; } .star.on { color: #d69a54; }
.review-input { min-height: 160rpx; margin-bottom: 24rpx; } .picker-value { min-height: 96rpx; padding: 22rpx 24rpx; border: 2rpx solid var(--color-border); border-radius: 18rpx; }
.text-btn { padding: 22rpx; color: var(--color-text-3); text-align: center; }
