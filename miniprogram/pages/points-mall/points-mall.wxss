.mall-page { min-height: 100vh; padding: 24rpx 24rpx 72rpx; background: #f7f5f1; box-sizing: border-box; }
.points-hero { position: relative; overflow: hidden; padding: 34rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg, #3c574d, #789184); box-shadow: 0 16rpx 36rpx rgba(45,75,62,.2); }
.points-hero::after { content: ''; position: absolute; right: -50rpx; top: -80rpx; width: 260rpx; height: 260rpx; border-radius: 50%; background: rgba(255,255,255,.09); }
.points-label { font-size: 25rpx; opacity: .85; }
.points-value { margin-top: 6rpx; font-size: 64rpx; font-weight: 700; line-height: 1.15; }
.points-tip { margin-top: 16rpx; font-size: 23rpx; opacity: .82; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 38rpx 4rpx 20rpx; }
.section-title { font-size: 34rpx; font-weight: 700; color: #2e3834; }
.section-sub { margin-top: 6rpx; font-size: 22rpx; color: #929890; }
.rules { font-size: 21rpx; color: #a28b70; }
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.product-card { overflow: hidden; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(53,48,40,.06); }
.product-cover { width: 100%; height: 244rpx; background: #eeeae3; }
.product-body { padding: 20rpx; }
.product-title { height: 72rpx; font-size: 27rpx; font-weight: 650; color: #303734; line-height: 36rpx; overflow: hidden; }
.product-desc { margin-top: 7rpx; height: 60rpx; font-size: 21rpx; line-height: 30rpx; color: #858b86; overflow: hidden; }
.product-stock { margin-top: 10rpx; font-size: 19rpx; color: #aaa49b; }
.detail-link { display: flex; align-items: center; margin-top: 11rpx; color: #648174; font-size: 20rpx; font-weight: 600; }
.detail-link text { margin-left: 5rpx; font-size: 27rpx; line-height: 1; }
.product-foot { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 18rpx; }
.cost { color: #b77236; font-size: 32rpx; font-weight: 700; }
.cost-unit { color: #b77236; font-size: 20rpx; }
.redeem-btn { margin: 0; padding: 0 18rpx; height: 56rpx; line-height: 56rpx; border-radius: 999rpx; background: #3f6657; color: #fff; font-size: 21rpx; }
.redeem-btn[disabled] { background: #ddd9d2; color: #98948e; }
.redeem-btn::after, .confirm-btn::after { border: 0; }
.empty { padding: 100rpx 0; text-align: center; color: #9b9f9b; font-size: 25rpx; }
.orders-section { margin-top: 46rpx; }
.orders-section > .section-title { margin: 0 4rpx 18rpx; }
.order-card { display: flex; align-items: center; gap: 18rpx; margin-bottom: 14rpx; padding: 18rpx; border-radius: 20rpx; background: #fff; }
.order-cover { width: 92rpx; height: 92rpx; border-radius: 14rpx; background: #eee; }
.order-main { flex: 1; min-width: 0; }
.order-title { font-size: 25rpx; font-weight: 600; color: #343a37; }
.order-meta { margin-top: 7rpx; font-size: 20rpx; color: #929791; }
.order-status { align-self: flex-start; padding: 7rpx 13rpx; border-radius: 999rpx; background: #edf4ef; color: #4f7566; font-size: 20rpx; }
.mask { position: fixed; z-index: 30; inset: 0; display: flex; align-items: flex-end; background: rgba(20,24,22,.48); }
.detail-mask { z-index: 29; }
.detail-sheet { width: 100%; max-height: 91vh; display: flex; flex-direction: column; overflow: hidden; padding: 16rpx 0 calc(22rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #fff; box-sizing: border-box; }
.detail-scroll { flex: none; width: 100%; height: 72vh; padding: 0 28rpx; box-sizing: border-box; }
.detail-cover { width: 100%; height: 430rpx; display: block; border-radius: 24rpx; background: #eeeae3; }
.detail-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-top: 24rpx; }
.detail-product-title { flex: 1; min-width: 0; color: #2f3734; font-size: 35rpx; font-weight: 700; line-height: 1.35; }
.detail-cost { flex: none; color: #aa6933; font-size: 21rpx; white-space: nowrap; }
.detail-cost text { margin-right: 3rpx; font-size: 38rpx; font-weight: 700; }
.detail-badges { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 17rpx; }
.detail-badges text { padding: 7rpx 13rpx; border-radius: 999rpx; background: #edf4f0; color: #55776a; font-size: 19rpx; }
.detail-section { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #eeeae4; }
.detail-section-title { color: #35403b; font-size: 27rpx; font-weight: 700; }
.detail-description { margin-top: 13rpx; color: #6f7772; font-size: 23rpx; line-height: 1.75; white-space: pre-wrap; }
.detail-info-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; margin-top: 25rpx; }
.detail-info-item { padding: 19rpx; border-radius: 17rpx; background: #f8f7f4; }
.detail-info-item text { color: #999d99; font-size: 19rpx; }
.detail-info-item view { margin-top: 6rpx; color: #434c48; font-size: 24rpx; font-weight: 650; }
.rules-section { padding-bottom: 8rpx; }
.rule-line { display: flex; align-items: flex-start; margin-top: 16rpx; color: #777f7b; font-size: 22rpx; line-height: 1.55; }
.rule-line text { flex: none; width: 31rpx; height: 31rpx; display: flex; align-items: center; justify-content: center; margin-right: 12rpx; border-radius: 50%; background: #f0f4f2; color: #5e7c70; font-size: 17rpx; font-weight: 700; }
.rule-line view { flex: 1; }
.detail-actions { flex: none; display: flex; align-items: center; gap: 22rpx; margin-top: 18rpx; padding: 18rpx 28rpx 0; border-top: 1rpx solid #eeeae4; }
.detail-points { flex: none; min-width: 125rpx; color: #939991; font-size: 19rpx; }
.detail-points text { display: block; color: #ae6e38; font-size: 31rpx; font-weight: 700; }
.detail-redeem-btn { flex: 1; height: 82rpx; margin: 0; border-radius: 999rpx; background: linear-gradient(135deg,#517768,#3b5f51); color: #fff; font-size: 27rpx; font-weight: 650; line-height: 82rpx; }
.detail-redeem-btn[disabled] { background: #ddd9d2; color: #98948e; }
.detail-redeem-btn::after { border: 0; }
.redeem-sheet { width: 100%; max-height: 82vh; overflow-y: auto; padding: 16rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #fff; box-sizing: border-box; }
.sheet-bar { width: 74rpx; height: 8rpx; margin: 0 auto 18rpx; border-radius: 8rpx; background: #ddd; }
.sheet-title { font-size: 34rpx; font-weight: 700; text-align: center; color: #2f3834; }
.sheet-product { display: flex; align-items: center; gap: 20rpx; margin: 26rpx 0; padding: 18rpx; border-radius: 18rpx; background: #f7f5f1; }
.sheet-product image { width: 110rpx; height: 110rpx; border-radius: 14rpx; }
.sheet-product-title { font-size: 27rpx; font-weight: 600; }
.sheet-cost { margin-top: 12rpx; color: #b77236; font-size: 25rpx; font-weight: 700; }
.address-head { display: flex; justify-content: space-between; margin: 24rpx 2rpx 14rpx; font-size: 25rpx; font-weight: 600; }
.address-head text:last-child { color: #668477; font-weight: 400; }
.address-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 18rpx 16rpx; border: 2rpx solid #eeeae4; border-radius: 16rpx; margin-bottom: 12rpx; }
.address-item.selected { border-color: #5f8273; background: #f2f7f4; }
.radio { flex: 0 0 auto; width: 28rpx; height: 28rpx; margin-top: 5rpx; border: 2rpx solid #bbb; border-radius: 50%; padding: 5rpx; box-sizing: border-box; }
.selected .radio { border-color: #507465; }
.selected .radio view { width: 100%; height: 100%; border-radius: 50%; background: #507465; }
.address-person { font-size: 24rpx; font-weight: 600; color: #353b38; }
.address-detail { margin-top: 7rpx; font-size: 21rpx; line-height: 30rpx; color: #777d78; }
.confirm-btn { margin-top: 26rpx; height: 86rpx; line-height: 86rpx; border-radius: 999rpx; background: linear-gradient(135deg,#517768,#3b5f51); color: #fff; font-size: 28rpx; font-weight: 650; }
