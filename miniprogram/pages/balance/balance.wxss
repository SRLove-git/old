.balance-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 176rpx;
  background: #f7f6f2;
}

.balance-hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 34rpx 32rpx;
  border: 1rpx solid rgba(185, 133, 85, 0.12);
  border-radius: 32rpx;
  background: linear-gradient(150deg, #fff8ef 0%, #f2dfca 100%);
  box-shadow: 0 16rpx 44rpx rgba(92, 67, 41, 0.09);
}

.hero-orbit {
  position: absolute;
  border: 2rpx solid rgba(185, 133, 85, 0.13);
  border-radius: 50%;
}

.hero-orbit-large {
  top: -150rpx;
  right: -92rpx;
  width: 380rpx;
  height: 380rpx;
}

.hero-orbit-small {
  right: 64rpx;
  bottom: -124rpx;
  width: 244rpx;
  height: 244rpx;
}

.hero-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.balance-label {
  color: #6e5138;
  font-size: 30rpx;
  font-weight: 700;
}

.balance-caption {
  margin-top: 4rpx;
  color: #94775d;
  font-size: 24rpx;
}

.security-badge {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(127, 154, 131, 0.22);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #5f7863;
  font-size: 23rpx;
  font-weight: 600;
}

.security-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: #7f9a83;
}

.balance-value {
  position: relative;
  margin-top: 26rpx;
  color: #3e2e22;
  font-size: 82rpx;
  font-weight: 750;
  line-height: 1.12;
  letter-spacing: -2rpx;
}

.balance-symbol {
  margin-right: 9rpx;
  color: #79502f;
  font-size: 42rpx;
  font-weight: 700;
}

.hero-meta {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.64);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.5);
}

.meta-item {
  flex: 1;
}

.meta-label {
  color: #8b7765;
  font-size: 23rpx;
}

.meta-value {
  margin-top: 3rpx;
  color: #47382c;
  font-size: 31rpx;
  font-weight: 700;
}

.meta-value-small {
  font-size: 28rpx;
}

.meta-divider {
  width: 1rpx;
  height: 52rpx;
  margin: 0 28rpx;
  background: rgba(121, 80, 47, 0.14);
}

.surface-card {
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(81, 69, 54, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(55, 44, 31, 0.04);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.section-title {
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-subtitle {
  margin-top: 8rpx;
  color: var(--color-text-3);
  font-size: 24rpx;
}

.section-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: var(--color-primary-light);
  color: var(--color-primary-text);
  font-size: 25rpx;
  font-weight: 700;
}

.amount-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 28rpx;
}

.amount-item {
  position: relative;
  display: flex;
  align-items: baseline;
  justify-content: center;
  width: calc(50% - 9rpx);
  min-height: 104rpx;
  margin-bottom: 18rpx;
  padding: 24rpx 10rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #fdfcf9;
  color: #493c32;
}

.amount-item.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary-text);
  box-shadow: inset 0 0 0 1rpx rgba(185, 133, 85, 0.16);
}

.amount-symbol {
  margin-right: 4rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.amount-number {
  font-size: 39rpx;
  font-weight: 750;
  line-height: 1;
}

.amount-check {
  position: absolute;
  top: 9rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.custom-field {
  display: flex;
  align-items: center;
  min-height: 102rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #fdfcf9;
}

.custom-field-active {
  border-color: var(--color-primary);
  background: #fffaf4;
}

.custom-currency {
  margin-right: 12rpx;
  color: var(--color-primary-text);
  font-size: 34rpx;
  font-weight: 700;
}

.custom-amount {
  flex: 1;
  height: 96rpx;
  color: var(--color-text-1);
  font-size: 34rpx;
  font-weight: 600;
}

.custom-placeholder {
  color: #9a9e9b;
  font-size: 29rpx;
  font-weight: 400;
}

.custom-hint {
  margin-left: 12rpx;
  color: var(--color-text-3);
  font-size: 23rpx;
}

.recharge-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 104rpx;
  margin-top: 22rpx;
  border-radius: 22rpx;
  background: #2f8d5b;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(47, 141, 91, 0.18);
}

.recharge-button:active {
  background: #27794e;
}

.recharge-button[disabled] {
  opacity: 0.66;
}

.trust-list {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  color: var(--color-text-3);
  font-size: 21rpx;
}

.trust-item {
  display: flex;
  align-items: center;
}

.trust-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 25rpx;
  height: 25rpx;
  margin-right: 6rpx;
  border-radius: 50%;
  background: #edf5ef;
  color: #5e8467;
  font-size: 17rpx;
  font-weight: 700;
}

.transaction-head {
  align-items: center;
  padding-bottom: 24rpx;
}

.record-count {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-fill);
  color: var(--color-text-2);
  font-size: 22rpx;
}

.empty-state {
  padding: 42rpx 12rpx 30rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 18rpx;
  border-radius: 26rpx;
  background: var(--color-fill);
  color: #9b958c;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-title {
  color: var(--color-text-2);
  font-size: 28rpx;
  font-weight: 700;
}

.empty-subtitle {
  margin-top: 8rpx;
  color: var(--color-text-3);
  font-size: 23rpx;
}

.transaction-row {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.transaction-row:last-child {
  padding-bottom: 4rpx;
  border-bottom: 0;
}

.transaction-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.transaction-icon-recharge {
  background: #edf6ef;
  color: #477956;
}

.transaction-icon-payment {
  background: #f8efe5;
  color: #8a5b36;
}

.transaction-icon-refund {
  background: #edf2f8;
  color: #507294;
}

.transaction-main {
  min-width: 0;
  flex: 1;
}

.transaction-title {
  overflow: hidden;
  color: var(--color-text-1);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-meta {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--color-text-3);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-side {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: right;
}

.transaction-amount {
  color: #5e5650;
  font-size: 29rpx;
  font-weight: 750;
}

.transaction-amount.income {
  color: #397653;
}

.transaction-balance {
  margin-top: 6rpx;
  color: var(--color-text-3);
  font-size: 21rpx;
}

.support-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid #ebe5dc;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
}

.support-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary-text);
  font-size: 28rpx;
  font-weight: 700;
}

.support-copy {
  min-width: 0;
  flex: 1;
}

.support-title {
  color: var(--color-text-1);
  font-size: 27rpx;
  font-weight: 700;
}

.support-text {
  margin-top: 4rpx;
  color: var(--color-text-3);
  font-size: 22rpx;
  line-height: 1.45;
}

.support-button {
  flex-shrink: 0;
  min-height: 64rpx;
  margin-left: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  background: var(--color-primary-light);
  color: var(--color-primary-text);
  font-size: 24rpx;
  font-weight: 700;
}

@media (max-width: 350px) {
  .trust-list {
    display: block;
  }

  .trust-item + .trust-item {
    margin-top: 10rpx;
  }
}
