.benefit-page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; box-sizing: border-box; background: #f8f6f1; color: #303633; }
.benefit-hero { padding: 42rpx 34rpx; border-radius: 28rpx; background: linear-gradient(135deg,#f6ead7,#ead0ad); box-shadow: 0 12rpx 30rpx rgba(89,68,41,.08); }
.hero-kicker { color: #a77843; font-size: 20rpx; font-weight: 700; letter-spacing: 5rpx; }
.hero-title { margin-top: 10rpx; font-size: 46rpx; font-weight: 700; }
.hero-sub { margin-top: 12rpx; color: #73695d; font-size: 25rpx; line-height: 1.6; }
.loading-text { padding: 100rpx 0; color: #9a958d; text-align: center; font-size: 25rpx; }
.benefit-list { margin-top: 24rpx; }
.benefit-card { overflow: hidden; margin-bottom: 24rpx; border: 1rpx solid #ece6dc; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(57,47,35,.05); }
.benefit-cover { display: block; width: 100%; height: 300rpx; background: #eee8de; }
.benefit-copy { padding: 26rpx 28rpx 28rpx; }
.benefit-title { font-size: 32rpx; font-weight: 650; line-height: 1.45; }
.benefit-highlight { margin: 10rpx 0 18rpx; color: #a66d38; font-size: 24rpx; line-height: 1.5; }
.benefit-meta { display: flex; margin-top: 10rpx; color: #969088; font-size: 23rpx; }
.meta-value { flex: 1; margin-left: 22rpx; color: #5d625f; }
.benefit-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #f0ece5; }
.benefit-price { color: #b66f35; font-size: 36rpx; font-weight: 700; }
.currency { margin-right: 3rpx; font-size: 22rpx; }
.price-tip { margin-left: 10rpx; color: #a19a91; font-size: 21rpx; font-weight: 400; }
.benefit-action { padding: 14rpx 26rpx; border-radius: 28rpx; background: #b98555; color: #fff; font-size: 23rpx; }
.empty-state { padding: 150rpx 50rpx 0; text-align: center; }
.empty-icon { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; margin: 0 auto 30rpx; border-radius: 32rpx; background: #f1e3d0; }
.service-glyph { position: relative; width: 48rpx; height: 38rpx; border: 4rpx solid #98704a; border-radius: 5rpx; }
.service-glyph::before { content: ''; position: absolute; left: -7rpx; top: -15rpx; width: 54rpx; height: 15rpx; box-sizing: border-box; border: 4rpx solid #98704a; border-radius: 5rpx 5rpx 10rpx 10rpx; }
.empty-title { font-size: 32rpx; font-weight: 650; }
.empty-sub { margin-top: 14rpx; color: #969088; font-size: 24rpx; line-height: 1.6; }
.home-button { width: 260rpx; margin-top: 40rpx; border: 0; border-radius: 40rpx; background: #b98555; color: #fff; font-size: 26rpx; }
.home-button::after { border: 0; }
