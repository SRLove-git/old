<view wx:if="{{post}}" class="content-page">
  <view class="type-tag">{{post.type === 'video' ? '视频推荐' : '政策资讯'}}</view>
  <view class="content-title">{{post.title}}</view>
  <view class="content-meta"><text>{{post.source || '来源待补充'}}</text><text>{{post.publishedAt}}</text></view>

  <video wx:if="{{post.type === 'video' && post.videoUrl}}" class="content-video" src="{{post.videoUrl}}" poster="{{post.coverImage}}" controls enable-play-gesture show-center-play-btn></video>
  <image wx:elif="{{post.coverImage}}" class="content-cover" src="{{post.coverImage}}" mode="aspectFill" />

  <view wx:if="{{post.summary}}" class="content-summary">{{post.summary}}</view>
  <view class="article-body">
    <block wx:for="{{post.contentBlocks}}" wx:key="_key" wx:for-item="block">
      <text wx:if="{{block.type === 'text'}}" class="content-body" user-select>{{block.text}}</text>
      <view wx:elif="{{block.type === 'image'}}" class="article-media-block">
        <image class="article-image" src="{{block.src}}" mode="widthFix" show-menu-by-longpress />
        <view wx:if="{{block.caption}}" class="article-caption">{{block.caption}}</view>
      </view>
      <view wx:elif="{{block.type === 'video'}}" class="article-media-block">
        <video class="article-video" src="{{block.url}}" controls enable-play-gesture show-center-play-btn></video>
        <view wx:if="{{block.caption}}" class="article-caption">{{block.caption}}</view>
      </view>
      <view wx:elif="{{block.type === 'link'}}" class="article-link" data-url="{{block.url}}" bindtap="openContentLink">
        <view class="article-link-copy"><view class="article-link-title">{{block.title}}</view><view wx:if="{{block.description}}" class="article-link-description">{{block.description}}</view></view>
        <text class="article-link-arrow">›</text>
      </view>
    </block>
  </view>

  <view wx:if="{{post.type === 'news'}}" class="source-note">政策、申报和办事要求请以政府主管部门最新原文为准。</view>
  <button wx:if="{{post.originalUrl}}" class="original-button" bindtap="copyOriginal">复制政府原文链接</button>
</view>
