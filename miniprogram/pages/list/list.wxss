.offline-page { min-height: 100vh; padding: 0 0 180rpx; background: #f7f7f9; color: #202020; }
.filter-bar { position: sticky; top: 0; z-index: 30; display: flex; height: 98rpx; background: rgba(255,255,255,.98); border-bottom: 1rpx solid #eee; }
.filter-item { flex: 1; display: flex; align-items: center; justify-content: center; gap: 7rpx; color: #3e3e3e; font-size: 28rpx; }
.filter-item.on { color: #ed1833; font-weight: 700; }.filter-caret { font-size: 13rpx; transform: rotate(45deg); }
.filter-panel { position: sticky; top: 98rpx; z-index: 29; padding: 22rpx 24rpx; background: #fff; border-bottom: 1rpx solid #e9e9e9; box-shadow: 0 12rpx 24rpx rgba(0,0,0,.06); }
.option-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16rpx; }.option { padding: 16rpx 10rpx; border-radius: 10rpx; background: #f5f5f6; color: #555; text-align: center; font-size: 25rpx; }.option.active { background: #fff0f2; color: #ee1734; font-weight: 700; }
.date-groups { padding: 28rpx 22rpx 10rpx; }.date-group { margin-bottom: 34rpx; }.date-heading { display: flex; align-items: center; gap: 10rpx; margin-bottom: 18rpx; color: #171717; font-size: 30rpx; font-weight: 800; }.calendar-icon { font-size: 27rpx; }
.activity-card { margin-bottom: 16rpx; overflow: hidden; border-radius: 8rpx; background: #fff; box-shadow: 0 2rpx 9rpx rgba(0,0,0,.025); }.card-main { display: flex; gap: 22rpx; padding: 0; }.cover-wrap { position: relative; flex: none; width: 224rpx; height: 154rpx; overflow: hidden; border-radius: 8rpx 8rpx 8rpx 0; background: #eee; }.cover-image { width: 100%; height: 100%; }.status-ribbon { position: absolute; left: 0; top: 0; padding: 8rpx 13rpx; background: #f01836; color: #fff; font-size: 21rpx; }.status-ribbon.grouped { background: #e85423; }.status-ribbon.full,.status-ribbon.ended { background: rgba(70,70,70,.78); }
.card-copy { flex: 1; min-width: 0; padding: 16rpx 18rpx 0 0; }.card-title { height: 75rpx; color: #303030; font-size: 28rpx; font-weight: 700; line-height: 1.36; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }.meta-line { display: flex; align-items: center; gap: 8rpx; margin-top: 7rpx; color: #8b8b8b; font-size: 22rpx; white-space: nowrap; }.meta-icon { flex: none; width: 24rpx; color: #777; font-size: 25rpx; }.ellipsis { overflow: hidden; text-overflow: ellipsis; }
.card-footer { display: flex; align-items: center; min-height: 92rpx; margin: 0 16rpx; border-top: 1rpx solid #f0f0f0; }.signup-info { flex: 1; display: flex; align-items: center; min-width: 0; }.avatar-stack { display: flex; padding-left: 7rpx; }.mini-avatar { width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; margin-left: -7rpx; border: 2rpx solid #fff; border-radius: 50%; background: #f3e9e9; font-size: 19rpx; }.mini-avatar.more { background: #eee; color: #777; font-size: 14rpx; }.signup-count { margin-left: 10rpx; color: #aaa; font-size: 20rpx; white-space: nowrap; }.starting-price { display: flex; align-items: center; margin-right: 20rpx; color: #171717; font-size: 28rpx; font-weight: 700; }.price-dot { width: 31rpx; height: 31rpx; display: flex; align-items: center; justify-content: center; margin-right: 5rpx; border-radius: 50%; background: #ef1734; color: #fff; font-size: 20rpx; }.price-suffix { margin-left: 2rpx; font-size: 21rpx; font-weight: 400; }.signup-button { min-width: 130rpx; padding: 14rpx 23rpx; border-radius: 999rpx; background: #ef1734; color: #fff; font-size: 24rpx; font-weight: 700; box-shadow: 0 6rpx 15rpx rgba(239,23,52,.2); }.signup-button.disabled { background: #aaa; box-shadow: none; }
.empty { padding: 150rpx 40rpx; text-align: center; }.empty-icon { color: #bbb; font-size: 80rpx; }.empty-title { margin-top: 18rpx; font-size: 31rpx; font-weight: 700; }.empty-sub { margin-top: 8rpx; color: #999; font-size: 24rpx; }.reset-button { display: inline-flex; margin-top: 28rpx; padding: 15rpx 30rpx; border-radius: 999rpx; background: #ef1734; color: #fff; font-size: 25rpx; }
.share-fab { position: fixed; right: 24rpx; bottom: 150rpx; z-index: 40; width: 82rpx; height: 82rpx; border-radius: 50%; background: #ef1734; color: #fff; font-size: 42rpx; line-height: 82rpx; text-align: center; box-shadow: 0 10rpx 25rpx rgba(239,23,52,.28); }
