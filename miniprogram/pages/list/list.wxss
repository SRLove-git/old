.offline-page { min-height: 100vh; padding: 0 0 180rpx; background: #f7f5f0; color: var(--color-text-1); }
.list-hero { position: relative; overflow: hidden; padding: 34rpx 24rpx 25rpx; background: linear-gradient(145deg,#fbf2e5 0%,#f8eee2 52%,#eef4ef 100%); }
.hero-orbit { position: absolute; border: 1rpx solid rgba(157,122,85,.15); border-radius: 50%; }
.hero-orbit-large { width: 270rpx; height: 270rpx; right: -110rpx; top: -120rpx; }
.hero-orbit-small { width: 165rpx; height: 165rpx; right: -34rpx; top: -64rpx; }
.hero-kicker { position: relative; color: #9c7858; font-size: 18rpx; font-weight: 700; letter-spacing: 5rpx; }
.hero-title-row { position: relative; display: flex; align-items: flex-end; justify-content: space-between; margin-top: 14rpx; }
.hero-title { color: #303936; font-size: 42rpx; font-weight: 800; letter-spacing: 1rpx; }
.hero-subtitle { margin-top: 8rpx; color: #7f8582; font-size: 23rpx; }
.hero-count { flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 84rpx; height: 84rpx; margin-left: 16rpx; border: 1rpx solid rgba(74,101,91,.13); border-radius: 24rpx; background: rgba(255,255,255,.65); color: #728078; font-size: 18rpx; }
.hero-count-number { color: #49685d; font-size: 31rpx; font-weight: 800; line-height: 1; }
.activity-search { position: relative; height: 82rpx; display: flex; align-items: center; margin-top: 26rpx; padding: 0 22rpx; border: 1rpx solid rgba(222,213,201,.9); border-radius: 24rpx; background: rgba(255,255,255,.9); box-shadow: 0 8rpx 24rpx rgba(67,57,45,.055); }
.activity-search-icon { position: relative; flex: none; width: 27rpx; height: 27rpx; margin-right: 17rpx; border: 3rpx solid #66736e; border-radius: 50%; box-sizing: border-box; }
.activity-search-icon::after { content: ''; position: absolute; right: -9rpx; bottom: -6rpx; width: 13rpx; height: 3rpx; border-radius: 3rpx; background: #66736e; transform: rotate(45deg); }
.activity-search-input { flex: 1; height: 82rpx; color: #2f3734; font-size: 27rpx; }
.activity-search-placeholder { color: #9a9d99; }
.activity-search-clear { flex: none; width: 48rpx; color: #8f9491; font-size: 40rpx; text-align: right; }
.category-scroll { position: relative; width: 100%; margin-top: 21rpx; white-space: nowrap; }
.category-row { display: inline-flex; gap: 12rpx; padding-right: 24rpx; }
.category-chip { flex: none; padding: 12rpx 23rpx; border: 1rpx solid rgba(135,124,110,.13); border-radius: 999rpx; background: rgba(255,255,255,.66); color: #747b77; font-size: 22rpx; }
.category-chip.active { border-color: #49685d; background: #49685d; color: #fff; font-weight: 700; box-shadow: 0 7rpx 16rpx rgba(73,104,93,.16); }
.filter-bar { position: sticky; top: 0; z-index: 30; display: flex; height: 94rpx; margin: 0; padding: 0 18rpx; border-bottom: 1rpx solid #ebe6de; background: rgba(255,255,255,.96); box-shadow: 0 8rpx 22rpx rgba(47,42,35,.045); backdrop-filter: blur(14rpx); }
.filter-item { flex: 1; display: flex; align-items: center; justify-content: center; gap: 12rpx; color: #5f6764; font-size: 25rpx; }
.filter-item.on { color: var(--color-primary); font-weight: 700; }
.filter-caret { width: 11rpx; height: 11rpx; margin-top: -6rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); }
.filter-panel { position: sticky; top: 94rpx; z-index: 29; padding: 23rpx 24rpx 27rpx; border-bottom: 1rpx solid #e9e4dc; background: rgba(255,255,255,.98); box-shadow: 0 12rpx 26rpx rgba(51,43,33,.08); }
.option-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16rpx; }
.option { padding: 18rpx 10rpx; border: 2rpx solid transparent; border-radius: 16rpx; background: #f7f5f1; color: var(--color-text-2); text-align: center; font-size: 24rpx; }
.option.active { border-color: var(--color-primary); background: var(--color-primary-light); color: var(--color-primary-text); font-weight: 700; }
.date-groups { padding: 26rpx 22rpx 10rpx; }
.date-group { margin-bottom: 37rpx; }
.section-heading { display: flex; align-items: center; min-height: 58rpx; margin-bottom: 14rpx; padding: 0 4rpx; }
.heading-accent { width: 7rpx; height: 34rpx; margin-right: 13rpx; border-radius: 999rpx; background: #7fa08f; }
.heading-cn { color: #303936; font-size: 30rpx; font-weight: 800; }
.heading-count { margin-left: auto; color: #a2a5a1; font-size: 20rpx; }
.activity-card { margin-bottom: 18rpx; overflow: hidden; border: 1rpx solid #ece7df; border-radius: 26rpx; background: #fff; box-shadow: 0 9rpx 24rpx rgba(51,43,33,.055); }
.card-main { display: flex; gap: 21rpx; padding: 17rpx 17rpx 15rpx; }
.cover-wrap { position: relative; flex: none; width: 218rpx; height: 164rpx; overflow: hidden; border-radius: 19rpx; background: var(--color-fill); }
.cover-image { width: 100%; height: 100%; }
.status-ribbon { position: absolute; left: 9rpx; top: 9rpx; padding: 7rpx 12rpx; border-radius: 999rpx; background: rgba(238,246,241,.94); color: #5f7c6c; font-size: 19rpx; font-weight: 700; }
.status-ribbon.grouped { background: var(--color-primary-light); color: var(--color-primary-text); }
.status-ribbon.full, .status-ribbon.ended { background: rgba(247,245,241,.95); color: var(--color-text-3); }
.card-copy { flex: 1; min-width: 0; padding: 3rpx 4rpx 0 0; }
.card-title { height: 75rpx; color: var(--color-text-1); font-size: 28rpx; font-weight: 750; line-height: 1.38; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.meta-line { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; color: #8c928f; font-size: 21rpx; white-space: nowrap; }
.meta-icon { position: relative; flex: none; width: 23rpx; height: 23rpx; color: #77827d; }
.time-icon { border: 2rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.time-icon::before { content: ''; position: absolute; left: 9rpx; top: 4rpx; width: 2rpx; height: 7rpx; background: currentColor; transform-origin: bottom center; }
.time-icon::after { content: ''; position: absolute; left: 9rpx; top: 10rpx; width: 6rpx; height: 2rpx; background: currentColor; transform: rotate(26deg); transform-origin: left center; }
.location-icon { width: 21rpx; height: 21rpx; margin-top: -5rpx; border: 2rpx solid currentColor; border-radius: 50% 50% 50% 0; box-sizing: border-box; transform: rotate(-45deg); }
.location-icon::after { content: ''; position: absolute; left: 6rpx; top: 6rpx; width: 5rpx; height: 5rpx; border: 2rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; }
.card-footer { display: flex; align-items: center; min-height: 86rpx; margin: 0 17rpx; border-top: 1rpx solid #eee9e2; }
/* 防重叠：空间不足时先裁剪头像叠层，报名人数始终完整，价格与按钮保持自然宽度 */
.signup-info { flex: 1 1 auto; display: flex; align-items: center; min-width: 0; margin-right: 16rpx; overflow: hidden; }
.avatar-stack { flex: 0 1 auto; display: flex; min-width: 0; padding-left: 7rpx; overflow: hidden; }
.mini-avatar { flex: none; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; margin-left: -7rpx; border: 2rpx solid #fff; border-radius: 50%; background: #eaf2ed; color: #587467; font-size: 20rpx; }
.mini-avatar.more { background: var(--color-fill); color: var(--color-text-3); font-size: 22rpx; }
.signup-count { flex: none; margin-left: 10rpx; color: var(--color-text-3); font-size: 20rpx; white-space: nowrap; }
.starting-price { flex: none; display: flex; align-items: baseline; margin-right: 18rpx; color: #aa764c; font-size: 31rpx; font-weight: 800; }
.price-symbol { margin-right: 2rpx; font-size: 20rpx; font-weight: 700; }
.price-suffix { margin-left: 2rpx; color: var(--color-text-3); font-size: 21rpx; font-weight: 400; }
.signup-button { flex: none; min-width: 142rpx; min-height: 64rpx; padding: 12rpx 25rpx; border-radius: 999rpx; background: #49685d; color: #fff; font-size: 24rpx; font-weight: 700; box-shadow: 0 8rpx 18rpx rgba(73,104,93,.16); }
.signup-button.disabled { background: var(--color-fill); color: var(--color-text-3); box-shadow: none; }
.empty { margin: 28rpx 22rpx; padding: 118rpx 40rpx; border: 1rpx solid #ece7df; border-radius: 28rpx; background: #fff; text-align: center; }
.empty-icon { color: var(--color-text-4); font-size: 80rpx; }
.empty-title { margin-top: 18rpx; font-size: 31rpx; font-weight: 700; }
.empty-sub { margin-top: 8rpx; color: var(--color-text-3); font-size: 24rpx; }
.reset-button { display: inline-flex; margin-top: 28rpx; }
.share-fab { position: fixed; right: 18rpx; bottom: calc(154rpx + env(safe-area-inset-bottom)); z-index: 40; width: 82rpx; height: 82rpx; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; overflow: visible; line-height: 1; }
.share-fab-circle { position: absolute; right: 0; top: 0; width: 82rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #ded8cf; border-radius: 50%; background: rgba(255,255,255,.97); box-shadow: 0 10rpx 25rpx rgba(51,43,33,.13); }
.share-mark { position: relative; width: 48rpx; height: 48rpx; }
.share-mark::before, .share-mark::after { content: ''; position: absolute; left: 16rpx; width: 24rpx; height: 3rpx; border-radius: 3rpx; background: #56665f; transform-origin: left center; }
.share-mark::before { top: 17rpx; transform: rotate(-28deg); }
.share-mark::after { top: 29rpx; transform: rotate(28deg); }
.share-node { position: absolute; z-index: 2; width: 13rpx; height: 13rpx; border: 3rpx solid #56665f; border-radius: 50%; background: #fff; }
.node-top { right: 0; top: 2rpx; } .node-left { left: 2rpx; top: 18rpx; } .node-right { right: 0; bottom: 2rpx; }
