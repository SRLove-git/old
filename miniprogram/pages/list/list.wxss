.offline-page { min-height: 100vh; padding: 0 0 180rpx; background: #fff; color: var(--color-text-1); }
.filter-bar { position: sticky; top: 0; z-index: 30; display: flex; height: 98rpx; background: rgba(255,255,255,.98); border-bottom: 1rpx solid var(--color-border); }
.filter-item { flex: 1; display: flex; align-items: center; justify-content: center; gap: 7rpx; color: var(--color-text-2); font-size: 28rpx; }
.filter-item.on { color: var(--color-primary); font-weight: 700; }
.filter-caret { font-size: 20rpx; transform: rotate(45deg); }
.filter-panel { position: sticky; top: 98rpx; z-index: 29; padding: 22rpx 24rpx; background: #fff; border-bottom: 1rpx solid var(--color-border); box-shadow: 0 8rpx 25rpx rgba(51,43,33,.08); }
.option-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16rpx; }
.option { padding: 16rpx 10rpx; border: 2rpx solid transparent; border-radius: 14rpx; background: var(--color-fill); color: var(--color-text-2); text-align: center; font-size: 25rpx; }
.option.active { border-color: var(--color-primary); background: var(--color-primary-light); color: var(--color-primary-text); font-weight: 700; }
.date-groups { padding: 28rpx 22rpx 10rpx; }
.date-group { margin-bottom: 34rpx; }
.activity-card { margin-bottom: 16rpx; overflow: hidden; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 25rpx rgba(51,43,33,.08); }
.card-main { display: flex; gap: 22rpx; padding: 0; }
.cover-wrap { position: relative; flex: none; width: 224rpx; height: 154rpx; overflow: hidden; border-radius: 0 20rpx 20rpx 0; background: var(--color-fill); }
.cover-image { width: 100%; height: 100%; }
.status-ribbon { position: absolute; left: 0; top: 0; padding: 8rpx 13rpx; background: #edf4ef; color: #66806c; font-size: 21rpx; font-weight: 700; }
.status-ribbon.grouped { background: var(--color-primary-light); color: var(--color-primary-text); }
.status-ribbon.full, .status-ribbon.ended { background: var(--color-fill); color: var(--color-text-3); }
.card-copy { flex: 1; min-width: 0; padding: 16rpx 18rpx 0 0; }
.card-title { height: 75rpx; color: var(--color-text-1); font-size: 28rpx; font-weight: 700; line-height: 1.36; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.meta-line { display: flex; align-items: center; gap: 8rpx; margin-top: 7rpx; color: #929794; font-size: 22rpx; white-space: nowrap; }
.meta-icon { flex: none; width: 24rpx; color: #7c8481; font-size: 25rpx; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; }
.card-footer { display: flex; align-items: center; min-height: 92rpx; margin: 0 16rpx; border-top: 1rpx solid var(--color-border); }
.signup-info { flex: 1; display: flex; align-items: center; min-width: 0; }
.avatar-stack { display: flex; padding-left: 7rpx; }
.mini-avatar { width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; margin-left: -7rpx; border: 2rpx solid #fff; border-radius: 50%; background: var(--color-primary-light); color: var(--color-primary-text); font-size: 20rpx; }
.mini-avatar.more { background: var(--color-fill); color: var(--color-text-3); font-size: 22rpx; }
.signup-count { margin-left: 10rpx; color: var(--color-text-3); font-size: 20rpx; white-space: nowrap; }
.starting-price { display: flex; align-items: center; margin-right: 20rpx; color: var(--color-primary); font-size: 28rpx; font-weight: 700; }
.price-dot { width: 31rpx; height: 31rpx; display: flex; align-items: center; justify-content: center; margin-right: 5rpx; border-radius: 50%; background: var(--color-primary); color: #fff; font-size: 20rpx; }
.price-suffix { margin-left: 2rpx; color: var(--color-text-3); font-size: 21rpx; font-weight: 400; }
.signup-button { min-width: 132rpx; min-height: 64rpx; padding: 12rpx 24rpx; font-size: 25rpx; }
.signup-button.disabled { background: var(--color-fill); color: var(--color-text-3); box-shadow: none; }
.empty { padding: 150rpx 40rpx; text-align: center; }
.empty-icon { color: var(--color-text-4); font-size: 80rpx; }
.empty-title { margin-top: 18rpx; font-size: 31rpx; font-weight: 700; }
.empty-sub { margin-top: 8rpx; color: var(--color-text-3); font-size: 24rpx; }
.reset-button { display: inline-flex; margin-top: 28rpx; }
.share-fab { position: fixed; right: 24rpx; bottom: 150rpx; z-index: 40; width: 82rpx; height: 82rpx; border-radius: 50%; background: var(--color-ink); color: #fff; font-size: 42rpx; line-height: 82rpx; text-align: center; box-shadow: 0 10rpx 25rpx rgba(51,43,33,.28); }
