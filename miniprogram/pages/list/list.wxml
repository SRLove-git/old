<view class="offline-page">
  <view class="filter-bar">
    <view class="filter-item {{region !== 'all' ? 'on' : ''}}" data-key="region" bindtap="toggleFilter"><text>{{regionName}}</text><text class="filter-caret">◢</text></view>
    <view class="filter-item {{timeFilter !== 'all' ? 'on' : ''}}" data-key="time" bindtap="toggleFilter"><text>{{timeName}}</text><text class="filter-caret">◢</text></view>
    <view class="filter-item {{statusFilter !== 'all' ? 'on' : ''}}" data-key="status" bindtap="toggleFilter"><text>{{statusName}}</text><text class="filter-caret">◢</text></view>
  </view>

  <view wx:if="{{activeFilter}}" class="filter-panel">
    <view wx:if="{{activeFilter === 'region'}}" class="option-grid">
      <view class="option {{region === 'all' ? 'active' : ''}}" data-id="all" data-name="地区" bindtap="setRegion">全部地区</view>
      <view wx:for="{{cities}}" wx:key="id" class="option {{region === item.id ? 'active' : ''}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="setRegion">{{item.name}}</view>
    </view>
    <view wx:elif="{{activeFilter === 'time'}}" class="option-grid">
      <view wx:for="{{timeFilters}}" wx:key="key" class="option {{timeFilter === item.key ? 'active' : ''}}" data-id="{{item.key}}" data-name="{{item.shortName || item.name}}" bindtap="setTimeFilter">{{item.name}}</view>
    </view>
    <view wx:else class="option-grid">
      <view wx:for="{{statusFilters}}" wx:key="key" class="option {{statusFilter === item.key ? 'active' : ''}}" data-id="{{item.key}}" data-name="{{item.shortName || item.name}}" bindtap="setStatusFilter">{{item.name}}</view>
    </view>
  </view>

  <view class="activity-search">
    <view class="activity-search-icon"></view>
    <input class="activity-search-input" value="{{keyword}}" bindinput="onInput" confirm-type="search" placeholder="搜索活动名称、地点或关键词" placeholder-class="activity-search-placeholder" />
    <text wx:if="{{keyword}}" class="activity-search-clear" bindtap="clearKeyword">×</text>
  </view>

  <view wx:if="{{groups.length}}" class="date-groups">
    <view wx:for="{{groups}}" wx:key="key" wx:for-item="group" class="date-group">
      <view class="section-heading"><text class="heading-cn">{{group.label}}</text></view>
      <view wx:for="{{group.items}}" wx:key="id" class="activity-card" data-id="{{item.id}}" bindtap="goDetail">
        <view class="card-main">
          <view class="cover-wrap"><image class="cover-image" src="{{item.art}}" mode="aspectFill" /><text class="status-ribbon {{item.status}}">{{item.statusLabel}}</text></view>
          <view class="card-copy">
            <view class="card-title">{{item.title}}</view>
            <view class="meta-line"><text class="meta-icon">◷</text><text>{{item.scheduleLine}}</text></view>
            <view class="meta-line"><text class="meta-icon">⌖</text><text class="ellipsis">{{item.address || item.city + '集合点'}}</text></view>
          </view>
        </view>
        <view class="card-footer">
          <view class="signup-info">
            <view class="avatar-stack"><text wx:for="{{item.buyerAvatars}}" wx:key="time" class="mini-avatar">{{item.avatar}}</text><text class="mini-avatar more">•••</text></view>
            <text class="signup-count">{{item.soldCount}}人已报名</text>
          </view>
          <view class="starting-price"><text class="price-dot">¥</text><text>{{item.memberPrice}}</text><text class="price-suffix">起</text></view>
          <button class="signup-button btn btn-primary btn-pill {{item.status === 'full' || item.status === 'ended' ? 'disabled' : ''}}" data-id="{{item.id}}" catchtap="goBooking" disabled="{{item.status === 'full' || item.status === 'ended'}}">{{item.status === 'full' ? '已满' : item.status === 'ended' ? '已结束' : '立即报名'}}</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty"><view class="empty-icon">⌕</view><view class="empty-title">没有找到相关线下活动</view><view class="empty-sub">换个地区、时间或状态试试</view><button class="reset-button btn btn-primary btn-pill" bindtap="clearFilter">清空筛选</button></view>

  <button class="share-fab" open-type="share" aria-label="分享活动"><view class="share-fab-circle"><view class="share-mark"><text class="share-node node-top"></text><text class="share-node node-left"></text><text class="share-node node-right"></text></view></view></button>
</view>
