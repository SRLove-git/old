<view class="page">
  <view class="search-input">
    <text>🔍</text>
    <input value="{{keyword}}" bindinput="onInput" placeholder="搜索活动名称或地点" />
  </view>

  <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view class="chip {{cat === 'all' ? 'active' : ''}}" data-id="all" bindtap="setCat">全部</view>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="chip {{cat === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="setCat"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <view class="filter-bar">
    <view class="filter-item {{region !== 'all' ? 'on' : ''}}" data-key="region" bindtap="toggleFilter">地区 ▾</view>
    <view class="filter-item {{timeFilter !== 'all' ? 'on' : ''}}" data-key="time" bindtap="toggleFilter">时间 ▾</view>
    <view class="filter-item {{statusFilter !== 'all' ? 'on' : ''}}" data-key="status" bindtap="toggleFilter">状态 ▾</view>
  </view>

  <scroll-view wx:if="{{activeFilter === 'region'}}" scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view class="chip {{region === 'all' ? 'active' : ''}}" data-id="all" bindtap="setRegion">全部地区</view>
      <view
        wx:for="{{cities}}"
        wx:key="*this"
        class="chip {{region === item ? 'active' : ''}}"
        data-id="{{item}}"
        bindtap="setRegion"
      >{{item}}</view>
    </view>
  </scroll-view>

  <scroll-view wx:if="{{activeFilter === 'time'}}" scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view
        wx:for="{{timeFilters}}"
        wx:key="key"
        class="chip {{timeFilter === item.key ? 'active' : ''}}"
        data-id="{{item.key}}"
        bindtap="setTimeFilter"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <scroll-view wx:if="{{activeFilter === 'status'}}" scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view
        wx:for="{{statusFilters}}"
        wx:key="key"
        class="chip {{statusFilter === item.key ? 'active' : ''}}"
        data-id="{{item.key}}"
        bindtap="setStatusFilter"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <view class="result">共 {{total}} 个活动</view>

  <view wx:if="{{list.length > 0}}" class="activity-list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="activity-card card"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="cover" style="background: {{item.coverTone}}">
        <text class="cover-emoji">{{item.cover}}</text>
        <text class="status-badge {{item.status}}">{{item.statusLabel}}</text>
        <text class="sold">{{item.soldCount}}人已报名</text>
        <text wx:if="{{item.minGroup > 0}}" class="group">{{item.soldCount >= item.minGroup ? '已成团' : item.minGroup + '人成团'}}</text>
      </view>
      <view class="card-body">
        <view class="card-title">{{item.title}}</view>
        <view class="time-row">📅 {{item.scheduleDate}} {{item.scheduleWeekday}} {{item.scheduleTime}}</view>
        <view class="addr-row">📍 {{item.address}}</view>
        <view class="card-foot">
          <view>
            <text class="price">¥{{item.memberPrice}}</text>
            <text class="member-label">会员价</text>
          </view>
          <button class="go" data-id="{{item.id}}" catchtap="goBooking">立即报名</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="empty-emoji">🍃</view>
    <view class="empty-title">没有找到相关活动</view>
    <view class="empty-sub">换个关键词或筛选条件试试</view>
    <button class="btn btn-primary" bindtap="clearFilter">清空筛选</button>
  </view>
</view>
