<view class="login-page">
  <view class="brand-mark">
    <view class="brand-ring"></view>
    <text>{{brandMark}}</text>
  </view>

  <view class="brand-name">{{brandName}}</view>
  <view wx:if="{{brandEnglish}}" class="brand-english">{{brandEnglish}}</view>
  <view class="brand-slogan">{{slogan}}</view>

  <view class="login-card">
    <view class="login-title">{{copy.loginTitle}}</view>
    <view class="login-desc">{{copy.loginDescription}}</view>
    <button
      class="login-button"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="handleLogin"
    >{{loading ? '登录中…' : '微信一键登录'}}</button>
    <view class="privacy-tip">登录即表示您同意平台按照隐私保护指引提供服务</view>
  </view>
</view>
