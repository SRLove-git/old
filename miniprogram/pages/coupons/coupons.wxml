<view class="page">
  <view class="coupon-note">每单限用1张，不可叠加；请在有效期内使用</view>
  <view wx:for="{{coupons}}" wx:key="id" class="coupon-card card {{item.used ? 'used' : ''}}">
    <view class="coupon-left">¥{{item.value}}</view>
    <view class="coupon-mid">
      <view class="coupon-title">{{item.title}}</view>
      <view class="coupon-desc">{{item.desc}}</view>
      <view class="coupon-desc">{{item.expireAt ? '有效期至 ' + item.expireAt : '长期有效'}}</view>
    </view>
    <button class="use" bindtap="goList">{{item.used ? '已使用' : '去使用'}}</button>
  </view>
</view>
